<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>EstrichOne.Api</RootNamespace>
    <UserSecretsId>estrichone-api</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" />
    <PackageReference Include="NetVips" />
    <PackageReference Include="NetVips.Native" />
    <PackageReference Include="PDFsharp-MigraDoc" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Schrift (SIL OFL 1.1) und Logo für PDF-Ausdrucke -->
    <EmbeddedResource Include="Infrastructure/Pdf/Assets/*.ttf" LogicalName="EstrichOne.Pdf.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Infrastructure/Pdf/Assets/*.png" LogicalName="EstrichOne.Pdf.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="EstrichOne.Api.Tests" />
    <InternalsVisibleTo Include="EstrichOne.Client.Tests" />
  </ItemGroup>
</Project>
