<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<Dialog id="themeDialog" title="Darstellung" contentWidth="30rem" contentHeight="34rem" resizable="true" draggable="true"
		escapeHandler=".onThemeCancel" class="sapUiContentPadding">
		<content>
			<VBox class="sapUiSmallMargin">
				<HBox alignItems="Center" justifyContent="SpaceBetween">
					<VBox>
						<Label text="Systemeinstellung folgen" labelFor="themeAuto" design="Bold" />
						<Text text="Hell, dunkel oder hoher Kontrast – wie im Betriebssystem eingestellt." class="sapUiTinyMarginTop" />
					</VBox>
					<Switch id="themeAuto" state="{themeDialog>/auto}" change=".onThemeAuto" customTextOn="Ja" customTextOff="Nein" />
				</HBox>
				<MessageStrip class="sapUiSmallMarginTop" type="Information" showIcon="true"
					text="Aktuell wirksam: {ui>/theme}" />
			</VBox>
			<List id="themeList" mode="SingleSelectLeft" selectionChange=".onThemeSelect" itemPress=".onThemeSelect"
				items="{path: 'ui>/themes', sorter: {path: 'group', descending: true, group: true}}">
				<StandardListItem type="Active" title="{ui>name}" description="{ui>id}" icon="sap-icon://palette"
					selected="{parts: ['ui>id', 'themeDialog>/selected', 'themeDialog>/auto'], formatter: '.isThemeSelected'}" />
			</List>
		</content>
		<beginButton>
			<Button id="themeSave" text="Speichern" type="Emphasized" press=".onThemeSave" />
		</beginButton>
		<endButton>
			<Button text="Abbrechen" press=".onThemeCancel" />
		</endButton>
	</Dialog>
</core:FragmentDefinition>
