{
  "name": "estrichone-hosting-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EstrichONE Hosting-Konsole – Weboberfläche (OpenUI5, TypeScript, sap_horizon, self-hosted)",
  "scripts": {
    "brand": "node scripts/brand.mjs",
    "start": "npm run brand && ui5 serve --port 4300 --accept-remote-connections",
    "build": "npm run brand && ui5 build --all --clean-dest --dest build && node scripts/package.mjs build dist",
    "lint": "tsc --noEmit",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@openui5/types": "1.154.0",
    "@playwright/test": "1.65.0",
    "@ui5/cli": "4.0.73",
    "typescript": "~5.9.3",
    "ui5-middleware-simpleproxy": "3.9.0",
    "ui5-tooling-transpile": "3.14.1"
  },
  "overrides": {
    "pacote": "^21.5.2",
    "sigstore": "^4.1.1",
    "@sigstore/core": "^3.2.1",
    "glob@>=9 <14.0.2": "^14.0.3",
    "minimatch@>=7 <11.0.1": "^11.0.4",
    "@npmcli/map-workspaces": {
      "minimatch": "^11.0.4"
    },
    "@npmcli/package-json": {
      "glob": "^14.0.3"
    },
    "ui5-tooling-transpile": {
      "minimatch": "^11.0.4"
    },
    "ui5-middleware-simpleproxy": {
      "minimatch": "^11.0.4"
    }
  }
}
