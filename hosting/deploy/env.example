# EstrichONE Hosting-Konsole – Konfiguration (vom Installer erzeugt; .env niemals weitergeben)

# Image der Konsole (Version = Version der Konsole, nicht der Mandanten)
HOSTING_IMAGE=ghcr.io/florians25/estrichone-hosting:latest
# Wurzelverzeichnis auf dem Host – gleicher Pfad im Konsolen-Container
HOSTING_ROOT=/srv/estrichone-hosting
# Basis-Domain: Mandanten erhalten <kürzel>.<basis-domain> (DNS: Wildcard *.<basis-domain> → dieser Server)
HOSTING_BASE_DOMAIN=estrichone-hosting.de
# Adresse der Konsole
HOSTING_CONSOLE_DOMAIN=konsole.estrichone-hosting.de
# Suite-Version für neue Mandanten (in der Konsole änderbar)
HOSTING_DEFAULT_VERSION=0.1.0-preview.4
ESTRICHONE_REGISTRY=ghcr.io/florians25
# Zertifikate: acme (Let's Encrypt), internal (eigene CA, nur Test), off (nur HTTP hinter weiterem Proxy)
HOSTING_TLS=acme
HOSTING_ACME_EMAIL=
# Reverse Proxy: caddy (mitgeliefert) oder extern (z. B. Nginx Proxy Manager, siehe README)
HOSTING_PROXY=caddy
# caddy = mitgelieferten Proxy starten; leer bei externem Proxy
COMPOSE_PROFILES=caddy
HOSTING_PROXY_CONTAINER=estrichone-hosting-proxy
HOSTING_HTTP_PORT=80
HOSTING_HTTPS_PORT=443
HOSTING_CONSOLE_LOCAL_PORT=8099
# Optional: Sicherungs-Repositorys auf eigener Platte (gleicher Pfad im Container einbinden – siehe README)
HOSTING_BACKUP_ROOT=
# Optional: Konsole nur von diesen Adressen/Netzen erreichbar (Komma-getrennt ohne Leerzeichen, z. B. 203.0.113.7,10.0.0.0/8); leer = alle.
# Anmeldung, Zwei-Faktor und Sperre nach Fehlversuchen gelten immer; 127.0.0.1 (SSH-Tunnel) ist immer erlaubt.
HOSTING_ALLOWED_NETWORKS=
