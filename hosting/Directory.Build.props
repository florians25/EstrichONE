<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Version>0.1.0</Version>
    <Company>EstrichONE</Company>
    <Product>EstrichONE Hosting-Konsole</Product>
    <!-- CA1515: Anwendung, keine Bibliothek. CA1062/CA2007: Nullable-Analyse, kein SynchronizationContext.
         CA1848: LoggerMessage nur dort, wo es sich lohnt. -->
    <NoWarn>$(NoWarn);CA1515;CA1062;CA2007;CA1848</NoWarn>
  </PropertyGroup>
</Project>
