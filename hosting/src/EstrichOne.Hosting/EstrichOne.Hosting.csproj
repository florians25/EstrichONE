<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>EstrichOne.Hosting</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="QRCoder" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="EstrichOne.Hosting.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Vorlagen der Instanz (Compose-Dateien der Suite) werden beim Docker-Build nach /app/templates kopiert. -->
    <Content Remove="wwwroot\**" />
    <None Include="wwwroot\**" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
