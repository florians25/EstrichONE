<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="EstrichOne.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BrandBrush" Color="#0B2D5B" />
                    <SolidColorBrush x:Key="BrandSoftBrush" Color="#F3F7FC" />
                    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="RibbonBrush" Color="#FAFBFD" />
                    <SolidColorBrush x:Key="DividerBrush" Color="#E6E9EF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BrandBrush" Color="#0B2D5B" />
                    <SolidColorBrush x:Key="BrandSoftBrush" Color="#1C2633" />
                    <SolidColorBrush x:Key="CardBrush" Color="#202020" />
                    <SolidColorBrush x:Key="RibbonBrush" Color="#262626" />
                    <SolidColorBrush x:Key="DividerBrush" Color="#3A3A3A" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
            <Style x:Key="Overline" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="CharacterSpacing" Value="60" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource DividerBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
            <Style x:Key="ColumnHeader" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
