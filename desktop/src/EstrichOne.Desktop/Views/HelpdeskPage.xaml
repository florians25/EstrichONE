<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EstrichOne.Desktop.Views.HelpdeskPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:EstrichOne.Desktop.ViewModels"
    xmlns:local="using:EstrichOne.Desktop.Views">
    <Grid Padding="24" ColumnSpacing="16" RowSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.ColumnSpan="2">
            <TextBlock Text="IT &amp; SUPPORT" Style="{StaticResource Overline}" />
            <TextBlock Text="Helpdesk" Style="{StaticResource PageTitle}" />
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel Spacing="12">
                <TextBlock Text="Problem melden" Style="{StaticResource CardTitle}" />
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Mitgeschickt werden nur App-Version und Windows-Version – keine Inhalte aus Bauakten." />
                <TextBox Header="Was funktioniert nicht?" Text="{x:Bind ViewModel.ProblemTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Header="Beschreibung (optional)" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96"
                         Text="{x:Bind ViewModel.ProblemDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Content="Ich kann deshalb nicht weiterarbeiten" IsChecked="{x:Bind ViewModel.Blocked, Mode=TwoWay}" />
                <Button Content="Meldung senden" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.ReportCommand}" />
                <InfoBar Severity="Success" IsOpen="{x:Bind local:CallsPage.HasText(ViewModel.Reported), Mode=OneWay}" Message="{x:Bind ViewModel.Reported, Mode=OneWay}" />
                <InfoBar Severity="Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Message="{x:Bind ViewModel.Error, Mode=OneWay}" />
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" Grid.Column="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="{x:Bind ListTitle}" Style="{StaticResource CardTitle}" />
            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Items}" SelectionMode="None" AutomationProperties.Name="Meldungen">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:TicketRow">
                        <Grid ColumnSpacing="12" Padding="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Number}" FontWeight="SemiBold" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="{x:Bind Category}" /><Run Text=" · " /><Run Text="{x:Bind Reporter}" /><Run Text=" · " /><Run Text="{x:Bind Priority}" />
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{x:Bind Status}" />
                            <TextBlock Grid.Column="3" Text="{x:Bind LastActivity}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
