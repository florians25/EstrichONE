<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EstrichOne.Desktop.Views.BauaktenPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:EstrichOne.Desktop.ViewModels">
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="BAUAKTEN" Style="{StaticResource Overline}" />
            <TextBlock Text="Bauaktensuche" Style="{StaticResource PageTitle}" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" PlaceholderText="Nummer, Bauvorhaben, Ort" AutomationProperties.Name="Bauakten durchsuchen"
                     Text="{x:Bind ViewModel.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnSearchKeyDown" />
            <ComboBox Grid.Column="1" ItemsSource="{x:Bind vm:BauaktenViewModel.StatusOptions}" SelectedItem="{x:Bind ViewModel.Status, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" AutomationProperties.Name="Status" />
            <Button Grid.Column="2" Content="Suchen" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.LoadCommand}" />
            <TextBlock Grid.Column="3" Text="{x:Bind ViewModel.Summary, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Right"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
        <InfoBar Grid.Row="2" Severity="Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Message="{x:Bind ViewModel.Error, Mode=OneWay}" />
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="16,10" ColumnSpacing="12" Background="{ThemeResource BrandSoftBrush}" CornerRadius="8,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Nummer" Style="{StaticResource ColumnHeader}" />
                    <TextBlock Grid.Column="1" Text="Bauvorhaben" Style="{StaticResource ColumnHeader}" />
                    <TextBlock Grid.Column="2" Text="Status" Style="{StaticResource ColumnHeader}" />
                    <TextBlock Grid.Column="3" Text="Baustelle" Style="{StaticResource ColumnHeader}" />
                    <TextBlock Grid.Column="4" Text="Zuständig" Style="{StaticResource ColumnHeader}" />
                    <TextBlock Grid.Column="5" Text="Geändert" Style="{StaticResource ColumnHeader}" />
                </Grid>
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Items}" IsItemClickEnabled="True" ItemClick="OnOpen" SelectionMode="Single"
                          AutomationProperties.Name="Bauakten">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:BauakteRow">
                            <Grid ColumnSpacing="12" Padding="0,8" AutomationProperties.Name="{x:Bind Title}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Number}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{x:Bind StatusLabel}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Address}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="4" Text="{x:Bind Responsible}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="5" Text="{x:Bind Updated}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="12">
            <Button Content="Weitere laden" Command="{x:Bind ViewModel.LoadMoreCommand}" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="20" Height="20" />
        </StackPanel>
    </Grid>
</Page>
