<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EstrichOne.Desktop.Views.TodayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:EstrichOne.Desktop.ViewModels"
    xmlns:local="using:EstrichOne.Desktop.Views">
    <Page.Resources>
        <DataTemplate x:Key="CallTemplate" x:DataType="vm:CallRow">
            <StackPanel Margin="0,0,0,8">
                <TextBlock>
                    <Run Text="{x:Bind Caller}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{x:Bind Phone}" />
                </TextBlock>
                <TextBlock Text="{x:Bind Subject}" TextTrimming="CharacterEllipsis" />
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                    <Run Text="{x:Bind When}" /><Run Text="  " /><Run Text="{x:Bind Status}" /><Run Text="  " /><Run Text="{x:Bind Due}" />
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <StackPanel>
                <TextBlock Text="AUFTRAGSBEARBEITUNG" Style="{StaticResource Overline}" />
                <TextBlock Text="Tagesübersicht" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{x:Bind ViewModel.Heading, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            <InfoBar Severity="Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Message="{x:Bind ViewModel.Error, Mode=OneWay}" />

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="16">
                    <Border Style="{StaticResource Card}" Visibility="{x:Bind ViewModel.ShowPlanning}">
                        <StackPanel>
                            <TextBlock Text="Einsätze heute" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Heute ist nichts eingeplant." Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="{x:Bind local:Show.IfEmpty(ViewModel.Assignments.Count), Mode=OneWay}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Assignments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AssignmentCard">
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,6" Padding="12,8"
                                                Click="OnOpenAssignment" Tag="{x:Bind BauakteId}" AutomationProperties.Name="{x:Bind Title}">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{x:Bind Time}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{x:Bind Kind}" Style="{StaticResource CaptionTextBlockStyle}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind Activity}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind People}" Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind Warnings}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="#C25700"
                                                               TextWrapping="Wrap" Visibility="{x:Bind HasWarnings}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Heute abwesend" Style="{StaticResource CardTitle}" Margin="0,12,0,4"
                                       Visibility="{x:Bind local:Show.IfAny(ViewModel.Absences.Count), Mode=OneWay}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Absences}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}" Foreground="#C25700" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Visibility="{x:Bind ViewModel.ShowMaterial}">
                        <StackPanel>
                            <TextBlock Text="Lieferungen heute" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Heute keine Lieferungen." Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="{x:Bind local:Show.IfEmpty(ViewModel.Deliveries.Count), Mode=OneWay}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Deliveries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DeliveryRow">
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock>
                                                <Run Text="{x:Bind Time}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{x:Bind Supplier}" />
                                                <Run Text=" · " /><Run Text="{x:Bind Status}" />
                                            </TextBlock>
                                            <TextBlock Text="{x:Bind Bauakte}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Lines}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="16">
                    <Border Style="{StaticResource Card}" Visibility="{x:Bind ViewModel.ShowOffice}">
                        <StackPanel>
                            <TextBlock Text="Fällige Wiedervorlagen" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Keine fälligen Wiedervorlagen." Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="{x:Bind local:Show.IfEmpty(ViewModel.DueCalls.Count), Mode=OneWay}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.DueCalls}" ItemTemplate="{StaticResource CallTemplate}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Visibility="{x:Bind ViewModel.ShowOffice}">
                        <StackPanel>
                            <TextBlock Text="Offene Anfragen" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Keine offenen Anfragen." Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="{x:Bind local:Show.IfEmpty(ViewModel.Inquiries.Count), Mode=OneWay}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Inquiries}" ItemTemplate="{StaticResource CallTemplate}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Meine offenen Aufgaben" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Keine offenen Aufgaben." Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="{x:Bind local:Show.IfEmpty(ViewModel.MyWork.Count), Mode=OneWay}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.MyWork}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WorkItemRow">
                                        <Grid ColumnSpacing="8" Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Kind}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind Due}" Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
