<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EstrichOne.Desktop.Views.BauaktePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:client="using:EstrichOne.Client"
    xmlns:vm="using:EstrichOne.Desktop.ViewModels"
    xmlns:local="using:EstrichOne.Desktop.Views">
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="BAUAKTE" Style="{StaticResource Overline}" />
                <TextBlock Text="{x:Bind ViewModel.Heading, Mode=OneWay}" Style="{StaticResource PageTitle}" TextWrapping="Wrap" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                    <Run Text="{x:Bind ViewModel.StatusLabel, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  ·  " /><Run Text="{x:Bind ViewModel.Address, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button Click="OnComplete" Visibility="{x:Bind ViewModel.CanComplete, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE73E;" FontSize="14" />
                        <TextBlock Text="Abschließen" />
                    </StackPanel>
                </Button>
                <Button Click="OnRoute" AutomationProperties.Name="Route planen">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE816;" FontSize="14" />
                        <TextBlock Text="Route" />
                    </StackPanel>
                </Button>
                <Button Click="OnOpenWeb" AutomationProperties.Name="Im Browser öffnen">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE774;" FontSize="14" />
                        <TextBlock Text="Im Browser" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="6">
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            <InfoBar Severity="Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Message="{x:Bind ViewModel.Error, Mode=OneWay}" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Hints}" AutomationProperties.Name="Hinweise">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="client:BauakteHint">
                        <InfoBar IsOpen="True" IsClosable="False" Message="{x:Bind Text}" Severity="{x:Bind local:BauaktePage.SeverityOf(Severity)}"
                                 Margin="0,0,0,4" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <SelectorBar x:Name="Tabs" Grid.Row="2" SelectionChanged="OnTabChanged">
            <SelectorBarItem Text="Übersicht" Tag="uebersicht" IsSelected="True" />
            <SelectorBarItem Text="Notizen" Tag="notizen" />
            <SelectorBarItem Text="Räume &amp; Flächen" Tag="raeume" />
            <SelectorBarItem Text="Aufgaben &amp; Mängel" Tag="aufgaben" />
            <SelectorBarItem Text="Dateien" Tag="dateien" />
            <SelectorBarItem Text="Material" Tag="material" x:Name="MaterialTab" />
        </SelectorBar>

        <Grid Grid.Row="3">
            <!-- Übersicht -->
            <ScrollViewer x:Name="PanelOverview">
                <Grid ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Baustellendaten" Style="{StaticResource CardTitle}" />
                            <local:Fact Label="Baustelle" Value="{x:Bind ViewModel.Address, Mode=OneWay}" />
                            <local:Fact Label="Ausführung" Value="{x:Bind ViewModel.Period, Mode=OneWay}" />
                            <local:Fact Label="Zuständig" Value="{x:Bind ViewModel.Responsible, Mode=OneWay}" />
                            <local:Fact Label="Ansprechpartner vor Ort" Value="{x:Bind ViewModel.SiteContact, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Kunde" Style="{StaticResource CardTitle}" />
                            <local:Fact Label="Name" Value="{x:Bind CustomerName, Mode=OneWay}" />
                            <local:Fact Label="Telefon" Value="{x:Bind CustomerPhone, Mode=OneWay}" />
                            <local:Fact Label="E-Mail" Value="{x:Bind CustomerEmail, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Card}" Visibility="{x:Bind local:Show.IfText(ViewModel.Description), Mode=OneWay}">
                        <StackPanel>
                            <TextBlock Text="Beschreibung" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{x:Bind ViewModel.Description, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- Notizen -->
            <Grid x:Name="PanelNotes" Visibility="Collapsed" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.CanWriteNotes}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NoteBox" PlaceholderText="Neue Notiz (Strg+Enter speichert)" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"
                             AutomationProperties.Name="Neue Notiz" Text="{x:Bind ViewModel.NewNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="OnNoteKeyDown" />
                    <Button Grid.Column="1" Content="Notiz speichern" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.AddNoteCommand}" />
                </Grid>
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Notes}" SelectionMode="None" AutomationProperties.Name="Notizen">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:NoteRow">
                            <StackPanel Padding="0,8" Spacing="2">
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="{x:Bind Author}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{x:Bind When}" />
                                </TextBlock>
                                <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Räume -->
            <Grid x:Name="PanelRooms" Visibility="Collapsed" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{x:Bind ViewModel.RoomSummary, Mode=OneWay}" FontWeight="SemiBold" />
                <Grid Grid.Row="1" Padding="12,8" ColumnSpacing="12" Background="{ThemeResource BrandSoftBrush}" CornerRadius="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Raum" Style="{StaticResource ColumnHeader}" />
                    <TextBlock Grid.Column="1" Text="Geschoss" Style="{StaticResource ColumnHeader}" />
                    <TextBlock Grid.Column="2" Text="Fläche" Style="{StaticResource ColumnHeader}" />
                    <TextBlock Grid.Column="3" Text="Estrichart" Style="{StaticResource ColumnHeader}" />
                    <TextBlock Grid.Column="4" Text="Dicke" Style="{StaticResource ColumnHeader}" />
                    <TextBlock Grid.Column="5" Text="FBH" Style="{StaticResource ColumnHeader}" />
                    <TextBlock Grid.Column="6" Text="Status" Style="{StaticResource ColumnHeader}" />
                </Grid>
                <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Rooms}" SelectionMode="None" AutomationProperties.Name="Räume">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:RoomRow">
                            <Grid ColumnSpacing="12" Padding="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Floor}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Area}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Screed}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="4" Text="{x:Bind Thickness}" />
                                <TextBlock Grid.Column="5" Text="{x:Bind Heating}" />
                                <TextBlock Grid.Column="6" Text="{x:Bind Status}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Aufgaben & Mängel -->
            <Grid x:Name="PanelWork" Visibility="Collapsed" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.CanEditWork}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="WorkBox" PlaceholderText="Neue Aufgabe oder neuer Mangel" AutomationProperties.Name="Titel"
                             Text="{x:Bind ViewModel.NewWorkItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnWorkKeyDown" />
                    <ToggleSwitch Grid.Column="1" OnContent="Mangel" OffContent="Aufgabe" IsOn="{x:Bind ViewModel.NewWorkItemIsDefect, Mode=TwoWay}"
                                  AutomationProperties.Name="Mangel" MinWidth="0" />
                    <Button Grid.Column="2" Content="Hinzufügen" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.AddWorkItemCommand}" />
                </Grid>
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.WorkItems}" SelectionMode="None" AutomationProperties.Name="Aufgaben und Mängel">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:WorkItemRow">
                            <Grid ColumnSpacing="12" Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{x:Bind IsDone, Mode=OneWay}" Click="OnToggleWork" MinWidth="0" AutomationProperties.Name="{x:Bind Title}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Kind}" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Due}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Dateien -->
            <ListView x:Name="PanelFiles" Visibility="Collapsed" ItemsSource="{x:Bind ViewModel.Files}" SelectionMode="None"
                      AutomationProperties.Name="Dateien">
                <ListView.Header>
                    <TextBlock Text="Fotos, Videos und Dokumente. Hochladen und Ansehen im Browser oder in der App." Margin="0,0,0,8"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:FileRow">
                        <Grid ColumnSpacing="12" Padding="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Kind}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Size}" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Created}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Material -->
            <ListView x:Name="PanelMaterial" Visibility="Collapsed" ItemsSource="{x:Bind ViewModel.Orders}" SelectionMode="None"
                      AutomationProperties.Name="Bestellungen">
                <ListView.Header>
                    <TextBlock Text="Bestellungen für diese Baustelle. Neue Bestellungen und Bedarfsrechnung im Browser." Margin="0,0,0,8"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:OrderRow">
                        <Grid ColumnSpacing="12" Padding="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Number}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Delivery}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Supplier}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Lines}" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="4" Text="{x:Bind Total}" TextAlignment="Right" />
                            <TextBlock Grid.Column="5" Text="{x:Bind Status}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
