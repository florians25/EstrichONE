{
  "name": "estrichone-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "EstrichONE Weboberfläche (OpenUI5, TypeScript)",
  "scripts": {
    "start": "ui5 serve --port 4200 --accept-remote-connections",
    "build": "ui5 build --all --clean-dest --dest build && node scripts/package.mjs build dist",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@openui5/types": "1.136.22",
    "@playwright/test": "1.56.1",
    "@types/leaflet": "1.9.20",
    "@types/qrcode": "1.5.6",
    "@ui5/cli": "4.0.71",
    "jsdom": "^27.4.0",
    "typescript": "~5.9.3",
    "ui5-middleware-simpleproxy": "3.9.0",
    "ui5-tooling-modules": "3.41.2",
    "ui5-tooling-transpile": "3.13.1",
    "vitest": "^4.0.0"
  }
}
