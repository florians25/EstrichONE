{
  "name": "estrichone-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "EstrichONE Weboberfläche (OpenUI5, TypeScript)",
  "scripts": {
    "start": "ui5 serve --port 4200 --accept-remote-connections",
    "build": "ui5 build --all --clean-dest --dest build && node scripts/package.mjs build dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "audit": "npm audit --omit=dev --audit-level=moderate && npm audit --audit-level=high"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@openui5/types": "1.136.22",
    "@playwright/test": "1.64.1",
    "@types/leaflet": "1.9.22",
    "@types/qrcode": "1.5.6",
    "@ui5/cli": "4.0.71",
    "jsdom": "^27.4.0",
    "typescript": "~5.9.3",
    "ui5-middleware-simpleproxy": "3.9.0",
    "ui5-tooling-modules": "3.42.0",
    "ui5-tooling-transpile": "3.14.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "pacote": "^21.5.2",
    "sigstore": "^4.1.1",
    "@sigstore/core": "^3.2.1",
    "glob@>=9 <14.0.2": "^14.0.3",
    "minimatch@>=9 <11.0.1": "^11.0.4",
    "body-parser@<1.20.9": "^1.20.9",
    "body-parser@>=2 <2.4.0": "^2.4.0",
    "serialize-javascript": "^7.1.3",
    "@npmcli/map-workspaces": {
      "minimatch": "^11.0.4"
    }
  }
}
