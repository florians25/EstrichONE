<mvc:View controllerName="estrichone.controller.App"
	xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:tnt="sap.tnt" xmlns:core="sap.ui.core" xmlns:eo="estrichone.control"
	displayBlock="true" height="100%">
	<App id="root" autoFocus="false">
		<Page id="authPage" showHeader="false" enableScrolling="true" class="eoAuthPage">
			<VBox class="eoNoticeStack" renderType="Bare" visible="{= ${notices>/banners}.length > 0 }">
				<VBox items="{notices>/banners}" renderType="Bare" class="eoNoticeList">
					<eo:NoticeCard kind="{notices>kind}" tone="{notices>tone}" icon="{notices>icon}" label="{notices>label}" title="{notices>title}"
						text="{notices>text}" period="{notices>period}" relative="{notices>relative}" remaining="{notices>remaining}"
						source="{notices>source}" dismissible="{notices>dismissible}" mode="banner" details=".onNoticeDetails" dismiss=".onNoticeClose"/>
				</VBox>
				<Button text="{notices>/moreText}" icon="{= ${notices>/moreCount} > 0 ? 'sap-icon://slim-arrow-down' : 'sap-icon://slim-arrow-up' }"
					type="Transparent" press=".onNoticeToggle" visible="{= ${notices>/moreCount} > 0 || ${notices>/expanded} }" class="eoNoticeMore"/>
			</VBox>
			<NavContainer id="authNav" height="100%" autoFocus="false"/>
		</Page>
		<Page id="barePage" showHeader="false" enableScrolling="true" class="eoBarePage">
			<NavContainer id="bareNav" height="100%" autoFocus="false"/>
		</Page>
		<tnt:ToolPage id="toolPage" sideExpanded="{view>/sideExpanded}" class="eoToolPage">
			<tnt:header>
				<f:ShellBar id="shellBar" title="EstrichONE" secondTitle="{session>/server/serverName}"
					homeIcon="{view>/logo}" homeIconTooltip="{i18n>shell.home}" homeIconPressed=".onHome"
					showMenuButton="true" menuButtonPressed=".onToggleSide" showNotifications="true"
					notificationsNumber="{view>/notifications/count}" notificationsPressed=".onNotifications"
					avatarPressed=".onAvatar" showCopilot="false">
					<f:profile>
						<Avatar id="profileAvatar" initials="{view>/initials}" displaySize="XS" tooltip="{i18n>shell.profile}"
							ariaLabelledBy="profileLabel"/>
					</f:profile>
					<f:additionalContent>
						<SearchField id="globalSearch" width="26rem" placeholder="Suchen: Bauakten, Altakten, Kunden, Dokumente …" class="eoShellSearch"
							search=".onSearch" suggest=".onSuggest" enableSuggestions="true" ariaLabelledBy="globalSearchLabel"
							visible="{= !${session>/mustChangePassword} }"/>
						<Button id="newBauakteButton" text="{i18n>shell.newBauakte}" tooltip="{i18n>shell.newBauakteTooltip}" icon="sap-icon://add" type="Emphasized"
							press=".onNewBauakte" visible="{= ${session>/permissions/bauakten.create} === true }" class="eoShellNew"
							ariaDescribedBy="newBauakteShortcut"/>
						<Button id="chatButton" icon="sap-icon://discussion-2" tooltip="{= ${view>/chatUnread} > 0 ? 'Chat – ' + ${view>/chatUnread} + ' ungelesen' : 'Chat' }"
							type="Transparent" press=".onChat" visible="{= ${session>/permissions/chat.use} === true }" class="eoShellChat">
							<customData><BadgeCustomData key="badge" value="{= ${view>/chatUnread} > 99 ? '99+' : String(${view>/chatUnread}) }"
								visible="{= ${view>/chatUnread} > 0 }"/></customData>
						</Button>
						<OverflowToolbarButton id="phoneButton" text="{i18n>shell.phone}" tooltip="{i18n>shell.phone}" icon="sap-icon://outgoing-call" press=".onQuickCall"
							visible="{= ${session>/permissions/contacts.edit} === true }"/>
						<!-- Fehler melden / Funktion wünschen: direkt links neben dem Profil; in schmalen Fenstern im Überlaufmenü. -->
						<OverflowToolbarButton id="feedbackButton" text="{i18n>shell.feedback}" tooltip="{i18n>shell.feedback}" icon="sap-icon://feedback"
							press=".onFeedback" visible="{= !${session>/mustChangePassword} }"/>
					</f:additionalContent>
				</f:ShellBar>
			</tnt:header>
			<tnt:sideContent>
				<tnt:SideNavigation id="sideNavigation" itemSelect=".onNavigate" itemPress=".onNavPress" selectedKey="{view>/navKey}">
					<tnt:NavigationList id="navigationList"/>
					<tnt:fixedItem>
						<tnt:NavigationList id="fixedNavigation">
							<tnt:NavigationListItem id="navFeedback" key="__myFeedback" text="{i18n>shell.myFeedback}" icon="sap-icon://feedback"
								selectable="false" tooltip="Meine Fehlermeldungen und Funktionswünsche mit Status und Antworten"/>
							<tnt:NavigationListItem id="navSettings" key="__settings" text="{i18n>settings.title}" icon="sap-icon://action-settings"
								selectable="false"/>
						</tnt:NavigationList>
					</tnt:fixedItem>
				</tnt:SideNavigation>
			</tnt:sideContent>
			<tnt:mainContents>
				<FlexBox direction="Column" height="100%" renderType="Bare" class="eoMain">
					<VBox items="{notices>/health}" visible="{= ${notices>/health}.length > 0 }" class="eoNoticeBar">
						<MessageStrip text="{notices>text}" type="{notices>type}" showIcon="true" customIcon="{notices>icon}" class="eoNotice eoHealthBanner"/>
					</VBox>
					<MessageStrip id="updateHint" text="{updates>/text}" type="{updates>/type}" showIcon="true" customIcon="sap-icon://locked"
						visible="{updates>/visible}" showCloseButton="true" close=".onUpdateHintClose" class="eoNotice eoUpdateHint">
						<link><Link text="Versionshinweise" href="{updates>/url}" target="_blank" visible="{= !!${updates>/url} }"/></link>
					</MessageStrip>
					<MessageStrip id="twoFactorBanner" text="{i18n>security.banner}" type="Warning" showIcon="true" customIcon="sap-icon://shield"
						visible="{= ${session>/twoFactorRestricted} === true }" class="eoNotice">
						<link><Link text="{i18n>security.bannerAction}" href="/konto/sicherheit"/></link>
					</MessageStrip>
					<VBox class="eoNoticeStack" renderType="Bare" visible="{= ${notices>/banners}.length > 0 }">
						<VBox items="{notices>/banners}" renderType="Bare" class="eoNoticeList">
							<eo:NoticeCard kind="{notices>kind}" tone="{notices>tone}" icon="{notices>icon}" label="{notices>label}" title="{notices>title}"
								text="{notices>text}" period="{notices>period}" relative="{notices>relative}" remaining="{notices>remaining}"
								source="{notices>source}" dismissible="{notices>dismissible}" mode="banner" details=".onNoticeDetails" dismiss=".onNoticeClose"/>
						</VBox>
						<Button text="{notices>/moreText}" icon="{= ${notices>/moreCount} > 0 ? 'sap-icon://slim-arrow-down' : 'sap-icon://slim-arrow-up' }"
							type="Transparent" press=".onNoticeToggle" visible="{= ${notices>/moreCount} > 0 || ${notices>/expanded} }" class="eoNoticeMore"/>
					</VBox>
					<NavContainer id="content" autoFocus="false" height="100%" class="eoContent">
						<layoutData><FlexItemData growFactor="1" baseSize="0"/></layoutData>
					</NavContainer>
					<OverflowToolbar id="statusBar" design="Solid" style="Clear" class="eoStatusBar" height="2rem">
						<core:Icon src="{= ${view>/online} ? 'sap-icon://connected' : 'sap-icon://disconnected' }"
							color="{= ${view>/online} ? 'Positive' : 'Negative' }"/>
						<Text text="{= ${view>/online} ? ${i18n>status.connected} + ' ' + (${session>/server/serverName} || '') : ${i18n>status.offline} }"/>
						<ToolbarSeparator/>
						<Text text="{i18n>status.version} {session>/server/serverVersion}"/>
						<ToolbarSpacer/>
						<core:Icon src="sap-icon://person-placeholder"/>
						<Text text="{session>/user/displayName}"/>
						<ToolbarSeparator/>
						<Text text="{view>/today}"/>
					</OverflowToolbar>
				</FlexBox>
			</tnt:mainContents>
		</tnt:ToolPage>
	</App>
	<FlexBox id="maintenanceOverlay" visible="{notices>/page}" direction="Column" alignItems="Center" justifyContent="Center" class="eoMaintenance"
		renderType="Bare">
		<Image src="{view>/loginLogo}" alt="EstrichONE" height="3rem" class="sapUiMediumMarginBottom"/>
		<IllustratedMessage illustrationType="sapIllus-SimpleConnection" title="Wartungsarbeiten" description="{notices>/pageText}"
			enableDefaultTitleAndDescription="false">
			<additionalContent>
				<VBox alignItems="Center">
					<Text text="{notices>/pageEnd}" class="sapUiSmallMarginBottom" visible="{= !!${notices>/pageEnd} }"/>
					<HBox>
						<Button text="Erneut prüfen" icon="sap-icon://refresh" press=".onMaintenanceRecheck" busy="{notices>/checking}" class="sapUiTinyMarginEnd"/>
						<Button text="Als Administrator anmelden" icon="sap-icon://key-user-settings" type="Transparent" press=".onMaintenanceAdmin"
							visible="{notices>/canBypass}"/>
					</HBox>
					<Text text="Die Seite prüft automatisch alle 30 Sekunden und arbeitet danach weiter." class="eoMuted sapUiSmallMarginTop"/>
				</VBox>
			</additionalContent>
		</IllustratedMessage>
	</FlexBox>
	<FlexBox id="outageOverlay" visible="{= ${notices>/outage} &amp;&amp; !${notices>/page} }" direction="Column" alignItems="Center" justifyContent="Center"
		class="eoMaintenance eoOutage" renderType="Bare">
		<Image src="{view>/loginLogo}" alt="EstrichONE" height="3rem" class="sapUiMediumMarginBottom"/>
		<IllustratedMessage illustrationType="sapIllus-UnableToLoad" title="{notices>/outageTitle}" description="{notices>/outageText}"
			enableDefaultTitleAndDescription="false">
			<additionalContent>
				<VBox alignItems="Center">
					<Text text="{notices>/outageSince}" class="sapUiSmallMarginBottom"/>
					<Button text="Jetzt erneut versuchen" icon="sap-icon://refresh" type="Emphasized" press=".onOutageRetry" busy="{notices>/checking}"/>
					<Text text="{notices>/outageNext}" class="eoMuted sapUiSmallMarginTop"/>
				</VBox>
			</additionalContent>
		</IllustratedMessage>
	</FlexBox>
	<core:InvisibleText id="profileLabel" text="{i18n>shell.profileMenu} {session>/user/displayName}"/>
	<core:InvisibleText id="globalSearchLabel" text="{i18n>shell.searchLabel}"/>
	<core:InvisibleText id="newBauakteShortcut" text="{i18n>shell.newBauakteShortcut}"/>
</mvc:View>
