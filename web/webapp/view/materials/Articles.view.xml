<mvc:View controllerName="estrichone.controller.materials.Articles" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:core="sap.ui.core"
	core:require="{fmt: 'estrichone/model/formatter'}" height="100%">
	<f:DynamicPage id="page" toggleHeaderOnTitleClick="false">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading><Title text="{i18n>nav.articles}" level="H1"/></f:heading>
				<f:expandedContent><Text text="Verkaufsartikel und Leistungen mit Preis netto und Steuersatz, wie sie in Angeboten stehen. Mit „Lexware Office: Artikel“ abgeglichen mit den Artikeln in Lexware Office."/></f:expandedContent>
				<f:actions>
					<Button id="articleSyncNow" text="Jetzt abgleichen" icon="sap-icon://synchronize" press=".onSync" visible="{= ${view>/syncEnabled} === true &amp;&amp; ${session>/permissions/materials.manage} === true }"/>
					<Button id="articleNew" text="Eintrag anlegen" icon="sap-icon://add" type="Emphasized" press=".onNew" visible="{= ${session>/permissions/materials.manage} === true }"/>
				</f:actions>
			</f:DynamicPageTitle>
		</f:title>
		<f:header>
			<f:DynamicPageHeader pinnable="false">
				<!-- Filterleiste wie im SAP List Report -->
				<FlexBox wrap="Wrap" alignItems="End" class="eoSalesFilters">
					<VBox class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
						<Label text="Suche" labelFor="articleSearch"/>
						<SearchField id="articleSearch" width="18rem" placeholder="Bezeichnung, Artikelnummer" liveChange=".refresh" value="{view>/f/query}"/>
					</VBox>
					<VBox class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
						<Label text="Art" labelFor="articleKind"/>
						<Select id="articleKind" selectedKey="{view>/f/kind}" change=".refresh" width="10rem">
							<core:Item key="" text="Alle"/><core:Item key="service" text="Leistung"/><core:Item key="product" text="Material"/>
						</Select>
					</VBox>
					<VBox class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
						<Label text="Einheit" labelFor="articleUnit"/>
						<Select id="articleUnit" selectedKey="{view>/f/unit}" change=".refresh" items="{view>/units}" width="9rem">
							<core:Item key="{view>key}" text="{view>text}"/>
						</Select>
					</VBox>
					<VBox class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
						<Label text="Abgleich mit Lexware Office" labelFor="articleFilter"/>
						<Select id="articleFilter" selectedKey="{view>/f/sync}" change=".refresh" items="{view>/filters}" width="16rem">
							<core:Item key="{view>key}" text="{view>text}"/>
						</Select>
					</VBox>
					<VBox class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
						<Label text="Aktiv" labelFor="articleActive"/>
						<Select id="articleActive" selectedKey="{view>/f/active}" change=".refresh" width="9rem">
							<core:Item key="active" text="Aktiv"/><core:Item key="inactive" text="Inaktiv"/><core:Item key="all" text="Alle"/>
						</Select>
					</VBox>
				</FlexBox>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<VBox renderType="Bare">
				<MessageStrip id="articleSyncStand" text="{view>/standText}" type="{view>/standType}" showIcon="true" visible="{= !!${view>/standText} }" class="sapUiSmallMarginBottom"/>
				<Table id="articleTable" contextualWidth="Auto" items="{view>/shown}" busy="{view>/busy}" sticky="HeaderToolbar,ColumnHeaders" growing="true" growingThreshold="100"
					mode="{= ${session>/permissions/materials.manage} === true ? 'MultiSelect' : 'None' }" selectionChange=".onSelection"
					popinLayout="GridSmall" noDataText="Noch keine Einträge. Legen Sie Leistungen und Artikel an oder gleichen Sie mit Lexware Office ab.">
					<headerToolbar>
						<OverflowToolbar>
							<Title text="{= 'Artikel und Leistungen (' + ${view>/shown}.length + ')' }" level="H2"/>
							<ToolbarSpacer/>
							<Button id="articleSort" text="Sortieren" icon="sap-icon://sort" press=".onSort" tooltip="Sortieren nach Spalte"/>
							<Button id="articlePrices" text="Preise ändern" icon="sap-icon://edit" press=".onPrices" enabled="{= ${view>/selected} > 0 }"
								visible="{= ${session>/permissions/materials.manage} === true }" tooltip="Preise der ausgewählten Einträge um Prozent ändern, mit Vorschau"/>
							<Button id="articleToggle" text="{= ${view>/selectedActive} ? 'Inaktiv setzen' : 'Aktiv setzen' }" icon="sap-icon://switch-views" press=".onToggleSelected"
								enabled="{= ${view>/selected} > 0 }" visible="{= ${session>/permissions/materials.manage} === true }"/>
						</OverflowToolbar>
					</headerToolbar>
					<columns>
						<Column width="8rem" minScreenWidth="Tablet" demandPopin="true"><Text text="Artikelnummer"/></Column>
						<Column><Text text="Bezeichnung"/></Column>
						<Column width="6.5rem" minScreenWidth="Tablet" demandPopin="true"><Text text="Art"/></Column>
						<Column width="5.5rem"><Text text="Einheit"/></Column>
						<Column width="8rem" hAlign="End"><Text text="Preis netto"/></Column>
						<Column width="4.5rem" hAlign="End" minScreenWidth="Desktop" demandPopin="true"><Text text="USt"/></Column>
						<Column width="8rem" hAlign="End" minScreenWidth="Desktop" demandPopin="true"><Text text="Preis brutto"/></Column>
						<Column width="14rem"><Text text="Abgleich mit Lexware Office"/></Column>
						<Column width="9rem" hAlign="End" minScreenWidth="Desktop" demandPopin="true"/>
					</columns>
					<items>
						<ColumnListItem type="Navigation" press=".onOpenItem" highlight="{= ${view>isActive} ? 'None' : 'Warning' }">
							<Text text="{view>articleNumber}" class="eoTabular"/>
							<VBox renderType="Bare">
								<Text text="{view>title}" class="eoStrong" wrapping="true"/>
								<Text text="{view>description}" visible="{= !!${view>description} }" class="eoMuted" maxLines="2"/>
								<Text text="Inaktiv" class="eoMuted" visible="{= !${view>isActive} }"/>
							</VBox>
							<Text text="{view>kindText}"/>
							<Text text="{view>unit}"/>
							<Text text="{path: 'view>netPrice', formatter: 'fmt.money'}" class="eoTabular"/>
							<Text text="{view>taxText}" class="eoTabular"/>
							<Text text="{view>grossText}" class="eoTabular"/>
							<VBox renderType="Bare">
								<ObjectStatus text="{view>syncText}" state="{view>syncState}" icon="{view>syncIcon}"/>
								<Text text="{view>sync/error}" visible="{= !!${view>sync/error} }" class="eoMuted"/>
							</VBox>
							<HBox justifyContent="End" renderType="Bare" wrap="Wrap">
								<Button text="Abweichungen" icon="sap-icon://compare" type="Transparent" press=".onDeviations" visible="{= ${view>sync/state} === 'deviations' }"
									tooltip="Abweichungen zu Lexware Office entscheiden"/>
								<Button icon="sap-icon://action" type="Transparent" tooltip="In Lexware öffnen" press=".onOpen" visible="{= !!${view>lexwareUrl} }"/>
							</HBox>
						</ColumnListItem>
					</items>
				</Table>
				<Table id="articleOnlyLexware" items="{view>/onlyLexware}" visible="{= ${view>/onlyLexware}.length > 0 }" class="sapUiMediumMarginTop" popinLayout="GridSmall" contextualWidth="Auto">
					<headerToolbar>
						<Toolbar><Title text="In Lexware Office, noch nicht übernommen: möglicher Treffer in EstrichONE, bitte entscheiden" level="H3" wrapping="true"/></Toolbar>
					</headerToolbar>
					<columns>
						<Column><Text text="Artikel in Lexware Office"/></Column>
						<Column><Text text="Möglicher Treffer in EstrichONE"/></Column>
						<Column width="22rem" hAlign="End"/>
					</columns>
					<items>
						<ColumnListItem>
							<VBox renderType="Bare">
								<Text text="{view>article/title}" class="eoStrong"/>
								<Text text="{view>remoteText}" class="eoMuted"/>
							</VBox>
							<VBox renderType="Bare">
								<Text text="{view>candidateTitle}"/>
								<Text text="{view>reasonText}" class="eoMuted"/>
							</VBox>
							<HBox justifyContent="End" renderType="Bare" wrap="Wrap">
								<Button text="Verknüpfen" icon="sap-icon://chain-link" type="Transparent" press=".onLinkCandidate" visible="{= !!${view>candidateId} }"/>
								<Button text="Trotzdem übernehmen" type="Transparent" press=".onImportAnyway"/>
							</HBox>
						</ColumnListItem>
					</items>
				</Table>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
