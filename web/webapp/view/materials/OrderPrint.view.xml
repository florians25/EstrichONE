<mvc:View controllerName="estrichone.controller.materials.OrderPrint" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core">
	<VBox busy="{view>/busy}">
		<OverflowToolbar class="eoPrintToolbar eoNoPrint" style="Clear">
			<Title text="{view>/title}" level="H1"/>
			<ToolbarSpacer/>
			<Button text="{i18n>report.print}" icon="sap-icon://print" type="Emphasized" press=".onPrint" enabled="{= !!${view>/html} }"/>
			<Button text="{i18n>common.close}" press=".onClose"/>
		</OverflowToolbar>
		<core:HTML content="{view>/html}" sanitizeContent="false"/>
	</VBox>
</mvc:View>
