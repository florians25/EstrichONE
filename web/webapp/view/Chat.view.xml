<mvc:View controllerName="estrichone.controller.Chat" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core" height="100%">
	<FlexBox id="chatRoot" height="100%" renderType="Bare" class="eoChat">
		<!-- Unterhaltungen -->
		<VBox class="eoChatSide" renderType="Bare">
			<HBox alignItems="Center" justifyContent="SpaceBetween" class="eoChatSideHead" renderType="Bare">
				<HBox alignItems="Center" renderType="Bare" class="eoChatSideTitle">
					<Title text="{= ${view>/archive} ? 'Chat-Archiv' : 'Chat' }" level="H2" titleStyle="H4"/>
					<core:Icon src="sap-icon://connected" visible="{view>/live}" class="eoChatLive" tooltip="Echtzeit verbunden"/>
				</HBox>
				<HBox renderType="Bare">
					<Button id="chatTeams" icon="sap-icon://collaborate" tooltip="In Microsoft Teams öffnen" type="Transparent" press=".onOpenTeams"
						visible="{= ${session>/teams/available} === true }"/>
					<Button id="chatExport" icon="sap-icon://download" tooltip="Meine Chatverläufe exportieren (JSON)" type="Transparent" press=".onExport"
						visible="{= ${view>/archive} === true }"/>
					<Button icon="sap-icon://add-employee" tooltip="Neuer Einzelchat" type="Transparent" press=".onNewDirect" ariaLabelledBy="chatNewDirectLabel"
						visible="{= !${view>/archive} }"/>
					<Button id="chatNewGroup" icon="sap-icon://add-contact" tooltip="Neue Gruppe" type="Transparent" press=".onNewGroup" visible="{= ${view>/canAdmin} &amp;&amp; !${view>/archive} }"
						ariaLabelledBy="chatNewGroupLabel"/>
					<Button icon="sap-icon://action-settings" tooltip="Meine Chat-Einstellungen" type="Transparent" press=".onMySettings"/>
				</HBox>
			</HBox>
			<MessageStrip id="chatArchiveStrip" visible="{= ${view>/archive} === true }" type="Information" showIcon="true" class="eoChatReadOnly"
				text="Unterhaltungen finden jetzt in Microsoft Teams statt. Hier bleiben die bisherigen Verläufe lesbar und exportierbar.">
				<link><Link text="In Teams öffnen" press=".onOpenTeams"/></link>
			</MessageStrip>
			<SearchField id="chatSearch" placeholder="Chats und Nachrichten durchsuchen" liveChange=".onSearch" class="eoChatSearch" ariaLabelledBy="chatSearchLabel"/>
			<ScrollContainer vertical="true" horizontal="false" height="100%" class="eoChatSideScroll">
				<layoutData><FlexItemData growFactor="1" baseSize="0"/></layoutData>
				<List id="chatList" items="{view>/filtered}" mode="SingleSelectMaster" selectionChange=".onSelect" showSeparators="None"
					noDataText="{= ${view>/loaded} ? (${view>/query} ? 'Kein Chat mit diesem Namen.' : ${view>/archive} ? 'Keine archivierten Unterhaltungen.' : 'Noch keine Unterhaltungen. Mit „Neuer Einzelchat“ beginnen.') : 'Wird geladen …' }"
					class="eoChatConvList">
					<CustomListItem selected="{= ${view>id} === ${view>/activeId} }" class="eoChatConv" type="Active">
						<customData><core:CustomData key="unread" value="{= ${view>unreadCount} > 0 ? 'yes' : 'no' }" writeToDom="true"/></customData>
						<HBox alignItems="Center" class="eoChatConvRow" renderType="Bare">
							<Avatar initials="{view>initials}" src="{view>icon}" displaySize="S" backgroundColor="{view>accent}" class="eoChatAvatar"
								decorative="true"/>
							<VBox class="eoChatConvText" renderType="Bare">
								<HBox justifyContent="SpaceBetween" alignItems="Baseline" renderType="Bare">
									<HBox alignItems="Center" renderType="Bare" class="eoChatConvTitleRow">
										<core:Icon src="{view>kindIcon}" visible="{= !!${view>kindIcon} }" class="eoChatKind" tooltip="{view>kindText}"/>
										<Text text="{view>title}" wrapping="false" class="eoChatConvTitle"/>
									</HBox>
									<Text text="{view>time}" wrapping="false" class="eoChatConvTime"/>
								</HBox>
								<HBox justifyContent="SpaceBetween" alignItems="Center" renderType="Bare">
									<Text text="{view>preview}" wrapping="false" class="eoChatConvPreview"/>
									<HBox renderType="Bare" alignItems="Center">
										<core:Icon src="sap-icon://bell-2" visible="{view>muted}" class="eoChatMuted" tooltip="Stumm geschaltet"/>
										<Text text="{view>unreadCount}" visible="{= ${view>unreadCount} > 0 }" class="eoChatBadge"/>
									</HBox>
								</HBox>
							</VBox>
						</HBox>
					</CustomListItem>
				</List>
				<VBox visible="{= ${view>/hits}.length > 0 || ${view>/searching} }" renderType="Bare" class="eoChatHits">
					<Title text="{= ${view>/searching} ? 'Nachrichten werden gesucht …' : 'Nachrichten' }" level="H3" titleStyle="H6" class="eoChatHitsTitle"/>
					<List id="chatHits" items="{view>/hits}" showSeparators="Inner" class="eoChatHitList">
						<CustomListItem type="Active" press=".onHit">
							<VBox renderType="Bare" class="eoChatHit">
								<HBox justifyContent="SpaceBetween" renderType="Bare">
									<Text text="{view>conversationTitle}" wrapping="false" class="eoChatConvTitle"/>
									<Text text="{view>time}" wrapping="false" class="eoChatConvTime"/>
								</HBox>
								<FormattedText htmlText="{view>html}" class="eoChatHitText"/>
							</VBox>
						</CustomListItem>
					</List>
				</VBox>
			</ScrollContainer>
			<Text text="{view>/retentionHint}" class="eoChatRetention"/>
		</VBox>

		<!-- Verlauf -->
		<VBox id="chatPane" class="eoChatPane" renderType="Bare">
			<layoutData><FlexItemData growFactor="1" baseSize="0" minWidth="0"/></layoutData>
			<IllustratedMessage visible="{= !${view>/activeId} }" illustrationType="sapIllus-NoActivities" illustrationSize="Auto" enableVerticalResponsiveness="true"
				title="Wählen Sie eine Unterhaltung" enableDefaultTitleAndDescription="false" class="eoChatEmpty"
				description="Nachrichten, Fotos und PDFs werden verschlüsselt gespeichert und nach {view>/retentionDays} Tagen automatisch gelöscht.">
				<additionalContent>
					<Button text="Neuer Einzelchat" icon="sap-icon://add-employee" type="Emphasized" press=".onNewDirect" visible="{= !${view>/archive} }"/>
					<Button text="In Teams öffnen" icon="sap-icon://collaborate" type="Emphasized" press=".onOpenTeams" visible="{= ${view>/archive} === true }"/>
				</additionalContent>
			</IllustratedMessage>
			<HBox visible="{= !!${view>/activeId} }" alignItems="Center" class="eoChatHead" renderType="Bare">
				<Button icon="sap-icon://nav-back" type="Transparent" press=".onBack" tooltip="Zur Liste" class="eoChatBack"/>
				<Avatar initials="{view>/active/initials}" src="{view>/active/icon}" displaySize="S" backgroundColor="{view>/active/accent}"
					press=".onInfo" class="eoChatAvatar" tooltip="Info"/>
				<VBox class="eoChatHeadText" renderType="Bare">
					<Title id="chatTitle" text="{view>/active/title}" level="H3" titleStyle="H5" wrapping="false"/>
					<Text text="{= ${view>/typing} || ${view>/active/subtitle} }" wrapping="false"
						class="{= ${view>/typing} ? 'eoChatHeadSub eoChatTyping' : 'eoMuted eoChatHeadSub' }"/>
				</VBox>
				<Button icon="sap-icon://inspection" type="Transparent" press=".onOpenBauakte" tooltip="Bauakte öffnen" visible="{= !!${view>/active/bauakteId} }"/>
				<Button icon="sap-icon://search" type="Transparent" press=".onSearchInChat" tooltip="In dieser Unterhaltung suchen"/>
				<Button icon="sap-icon://attachment-photo" type="Transparent" press=".onMedia" tooltip="Medien und Dokumente"/>
				<Button id="chatMuteBtn" icon="{= ${view>/active/muted} ? 'sap-icon://bell-2' : 'sap-icon://bell' }" type="Transparent" press=".onMute"
					tooltip="{= ${view>/active/muted} ? 'Stummschaltung aufheben' : 'Stumm schalten …' }"/>
				<Button icon="sap-icon://hint" type="Transparent" press=".onInfo" tooltip="{= ${view>/active/kind} === 'group' ? 'Gruppeninfo' : 'Info'}"/>
			</HBox>
			<HBox visible="{= !!${view>/activeId} &amp;&amp; ${view>/pinned}.length > 0 }" alignItems="Center" class="eoChatPinned" renderType="Bare">
				<core:Icon src="sap-icon://pushpin-off" class="eoChatPinIcon"/>
				<VBox renderType="Bare" class="eoChatPinnedText">
					<Text text="{= ${view>/pinned}.length > 1 ? 'Angeheftet (' + ${view>/pinned}.length + ')' : 'Angeheftet' }" class="eoChatPinnedLabel"/>
					<Link text="{view>/pinnedPreview}" press=".onPinnedJump" wrapping="false"/>
				</VBox>
			</HBox>
			<VBox id="chatDrop" visible="{= !!${view>/activeId} }" class="eoChatDropZone" renderType="Bare">
				<layoutData><FlexItemData growFactor="1" baseSize="0"/></layoutData>
				<ScrollContainer id="chatScroll" vertical="true" horizontal="false" height="100%" class="eoChatScroll">
					<core:HTML id="chatMessages" content="&lt;div class='eoChatLog'&gt;&lt;/div&gt;" preferDOM="false" sanitizeContent="false"/>
				</ScrollContainer>
			</VBox>
			<VBox visible="{= !!${view>/activeId} }" class="eoChatFooter" renderType="Bare">
				<HBox visible="{= !!${view>/compose/mode} }" alignItems="Center" class="eoChatContext" renderType="Bare">
					<core:Icon src="{= ${view>/compose/mode} === 'edit' ? 'sap-icon://edit' : 'sap-icon://response' }" class="eoChatContextIcon"/>
					<VBox renderType="Bare" class="eoChatContextText">
						<Text text="{view>/compose/title}" class="eoChatContextTitle" wrapping="false"/>
						<Text text="{view>/compose/preview}" class="eoMuted eoChatContextPreview" wrapping="false"/>
					</VBox>
					<Button icon="sap-icon://decline" type="Transparent" press=".onCancelContext" tooltip="Abbrechen"/>
				</HBox>
				<HBox visible="{= ${view>/pending}.length > 0 }" class="eoChatPendingList" renderType="Bare" items="{view>/pending}">
					<VBox renderType="Bare" class="eoChatPendingItem">
						<Avatar src="{view>preview}" initials="PDF" displayShape="Square" displaySize="M" decorative="true"
							backgroundColor="Accent6" class="eoChatPendingThumb"/>
						<Text text="{view>label}" wrapping="false" class="eoChatPendingName"/>
						<Button icon="sap-icon://decline" type="Transparent" press=".onRemovePending" tooltip="Entfernen" class="eoChatPendingRemove"/>
					</VBox>
				</HBox>
				<MessageStrip visible="{= !!${view>/active} &amp;&amp; (${view>/active/canPost} === false || ${view>/archive} === true) }" type="Information" showIcon="true"
					text="{= ${view>/archive} ? 'Chat-Archiv: nur lesen. Neue Nachrichten bitte in Microsoft Teams schreiben.' : ${view>/blocked} ? 'Sie sind im Chat gesperrt und können nur lesen.' : 'Ankündigungsgruppe: Nur Admins können schreiben.' }"
					class="eoChatReadOnly"/>
				<HBox visible="{= ${view>/active/canPost} !== false &amp;&amp; !${view>/archive} }" alignItems="End" class="eoChatComposer" renderType="Bare">
					<Button id="chatAttach" icon="sap-icon://attachment" type="Transparent" press=".onAttachMenu" tooltip="Foto, Dokument, Kamera oder Standort"
						enabled="{view>/attachmentsEnabled}" class="eoChatTool"/>
					<TextArea id="chatInput" value="{view>/draft}" valueLiveUpdate="true" growing="true" growingMaxLines="6" rows="1" width="100%"
						placeholder="{= ${view>/listening} ? 'Bitte sprechen. Der Text erscheint hier …' : 'Nachricht schreiben …' }" maxLength="4000"
						showExceededText="false" class="eoChatInput" ariaLabelledBy="chatInputLabel" liveChange=".onDraftChange">
						<layoutData><FlexItemData growFactor="1"/></layoutData>
					</TextArea>
					<ToggleButton id="chatDictate" icon="sap-icon://microphone" type="Transparent" press=".onDictate" pressed="{view>/listening}"
						visible="{view>/canDictate}" class="eoChatTool"
						tooltip="Diktieren (Spracherkennung des Browsers). Text vor dem Senden prüfen; es wird kein Audio gespeichert."/>
					<Button id="chatSend" icon="{= ${view>/compose/mode} === 'edit' ? 'sap-icon://accept' : 'sap-icon://paper-plane' }" type="Emphasized"
						press=".onSend" enabled="{= ${view>/draft}.trim().length > 0 || ${view>/pending}.length > 0 }"
						tooltip="{= ${view>/compose/mode} === 'edit' ? 'Änderung speichern (Enter)' : 'Senden (Enter)' }" class="eoChatSend"/>
				</HBox>
				<Text text="{view>/hint}" class="eoChatHint"/>
			</VBox>
		</VBox>
	</FlexBox>
	<core:InvisibleText id="chatNewDirectLabel" text="Neuer Einzelchat"/>
	<core:InvisibleText id="chatNewGroupLabel" text="Neue Gruppe"/>
	<core:InvisibleText id="chatSearchLabel" text="Chats und Nachrichten durchsuchen"/>
	<core:InvisibleText id="chatInputLabel" text="Nachricht"/>
</mvc:View>
