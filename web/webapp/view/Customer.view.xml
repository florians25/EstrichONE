<mvc:View controllerName="estrichone.controller.Customer" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:uxap="sap.uxap" xmlns:form="sap.ui.layout.form"
	xmlns:core="sap.ui.core" core:require="{fmt: 'estrichone/model/formatter'}" height="100%">
	<uxap:ObjectPageLayout id="objectPage" upperCaseAnchorBar="false" useIconTabBar="true" showFooter="false" busy="{view>/busy}"
		navigate=".onSection" headerContentPinnable="false" toggleHeaderOnTitleClick="false">
		<uxap:headerTitle>
			<uxap:ObjectPageDynamicHeaderTitle>
				<uxap:breadcrumbs><Breadcrumbs currentLocationText="{view>/c/name}"><Link text="Kunden" href="/kunden"/></Breadcrumbs></uxap:breadcrumbs>
				<uxap:heading>
					<HBox alignItems="Center" wrap="Wrap" renderType="Bare">
						<Title text="{view>/c/name}" level="H1" wrapping="true" class="sapUiTinyMarginEnd"/>
						<ObjectStatus text="{= ${view>/c/kind} === 'company' ? 'Gewerbekunde' : 'Privatkunde' }" state="Information" inverted="true"/>
						<ObjectStatus id="customerState" text="{view>/stateText}" state="Warning" inverted="true" visible="{= !!${view>/stateText} }" class="sapUiTinyMarginBegin"/>
					</HBox>
				</uxap:heading>
				<uxap:expandedContent><Text text="{view>/headline}"/></uxap:expandedContent>
				<uxap:snappedContent><Text text="{view>/headline}"/></uxap:snappedContent>
				<uxap:actions>
					<Button text="Anrufen" icon="sap-icon://call" press=".onCall" visible="{= !!${view>/primaryPhone} }" tooltip="{= 'Anrufen: ' + ${view>/primaryPhone} }"/>
					<Button text="E-Mail" icon="sap-icon://email" press=".onMail" visible="{= !!${view>/primaryEmail} }" tooltip="{= 'E-Mail an ' + ${view>/primaryEmail} }"/>
					<Button text="Route" icon="sap-icon://map-3" press=".onRoute" visible="{= !!${view>/routeUrl} }" tooltip="Route zur Kundenanschrift planen"/>
					<Button text="Bearbeiten" icon="sap-icon://edit" press=".onEdit" visible="{= ${session>/permissions/contacts.edit} === true &amp;&amp; !${view>/c/anonymizedAt} }"/>
					<Button id="reactivateCustomer" text="Reaktivieren" icon="sap-icon://undo" press=".onReactivate"
						visible="{= ${session>/permissions/contacts.edit} === true &amp;&amp; !!${view>/c/archivedAt} &amp;&amp; !${view>/c/anonymizedAt} }"/>
					<Button id="removeCustomer" text="{= ${view>/c/archivedAt} ? 'Löschen' : 'Löschen/Archivieren' }" icon="sap-icon://delete" press=".onRemove"
						visible="{= (${session>/permissions/contacts.edit} === true || ${session>/permissions/contacts.delete} === true) &amp;&amp; !${view>/c/anonymizedAt} }"/>
					<Button text="Neue Bauakte" icon="sap-icon://add-document" type="Emphasized" press=".onNewBauakte" visible="{= ${session>/permissions/bauakten.create} === true &amp;&amp; !${view>/c/archivedAt} }"/>
				</uxap:actions>
			</uxap:ObjectPageDynamicHeaderTitle>
		</uxap:headerTitle>
		<uxap:headerContent>
			<VBox renderType="Bare" class="eoCustomerHead">
				<FlexBox class="eoKpiBar" items="{view>/kpis}" wrap="Wrap" renderType="Bare">
					<VBox class="eoKpiItem" renderType="Bare">
						<Label text="{view>label}" wrapping="true"/>
						<ObjectStatus text="{view>value}" state="{view>state}" class="eoKpiFigure"/>
						<Text text="{view>hint}" class="eoKpiHint" visible="{= !!${view>hint} }"/>
					</VBox>
				</FlexBox>
				<FlexBox wrap="Wrap" class="eoStaffHeaderFacts eoCustomerFacts" renderType="Bare">
					<VBox><Label text="Anschrift"/><Text text="{view>/address}"/></VBox>
					<VBox><Label text="Telefon"/><Link text="{view>/primaryPhone}" href="tel:{view>/primaryPhone}" emptyIndicatorMode="On"/></VBox>
					<VBox><Label text="E-Mail"/><Link text="{view>/primaryEmail}" href="mailto:{view>/primaryEmail}" emptyIndicatorMode="On" class="eoWrapAny"/></VBox>
					<VBox visible="{= !!${view>/mainPerson} }"><Label text="Ansprechpartner"/><Text text="{view>/mainPerson}"/></VBox>
				</FlexBox>
			</VBox>
		</uxap:headerContent>
		<uxap:sections>
			<uxap:ObjectPageSection id="secOverview" title="Übersicht">
				<uxap:subSections><uxap:ObjectPageSubSection>
					<VBox renderType="Bare">
						<MessageStrip id="archivedStrip" text="{view>/stateHint}" type="Warning" showIcon="true" visible="{= !!${view>/stateHint} }" class="sapUiSmallMarginBottom"/>
						<MessageStrip text="{view>/c/notes}" type="Information" showIcon="true" visible="{= !!${view>/c/notes} }" class="sapUiSmallMarginBottom eoPre"
							customIcon="sap-icon://notes"/>
						<form:SimpleForm editable="false" layout="ResponsiveGridLayout" columnsXL="3" columnsL="2" columnsM="2" labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" adjustLabelSpan="false" singleContainerFullSize="false" class="eoDenseForm">
							<core:Title text="Stammdaten"/>
							<Label text="Art"/><Text text="{= ${view>/c/kind} === 'company' ? 'Gewerbekunde' : 'Privatkunde' }"/>
							<Label text="Anrede / Titel"/><Text text="{view>/salutation}"/>
							<Label text="Kundennummer"/><Text text="{= ${view>/c/customerNumber} || '–' }"/>
							<Label text="Geburtstag" visible="{= !!${view>/c/birthday} }"/><Text text="{path: 'view>/c/birthday', formatter: 'fmt.date'}" visible="{= !!${view>/c/birthday} }"/>
							<Label text="Bevorzugt"/><Text text="{view>/channel}"/>
							<Label text="Website"/><Link text="{view>/c/website}" href="{view>/c/website}" target="_blank" emptyIndicatorMode="On"/>
							<core:Title text="Anschrift"/>
							<Label text="Anschrift"/><Text text="{view>/address}"/>
							<Label text="Rechnung an"/><Text text="{view>/billing}"/>
							<Label text="Lieferung an"/><Text text="{view>/delivery}"/>
							<core:Title text="Steuer"/>
							<Label text="USt-IdNr."/><Text text="{= ${view>/c/vatId} || '–' }"/>
							<Label text="Steuernummer"/><Text text="{= ${view>/c/taxNumber} || '–' }"/>
						</form:SimpleForm>
					</VBox>
				</uxap:ObjectPageSubSection></uxap:subSections>
			</uxap:ObjectPageSection>
			<uxap:ObjectPageSection id="secBauakten" title="Bauakten">
				<uxap:subSections><uxap:ObjectPageSubSection>
					<Table id="customerBauakten" items="{view>/shownBauakten}" noDataText="{view>/bauakteEmpty}" popinLayout="GridSmall" contextualWidth="Auto">
						<headerToolbar><OverflowToolbar>
							<SegmentedButton selectedKey="{view>/bauakteFilter}" selectionChange=".onBauakteFilter">
								<items>
									<SegmentedButtonItem key="" text="{= 'Alle (' + ${view>/counts/all} + ')' }"/>
									<SegmentedButtonItem key="active" text="{= 'Laufend (' + ${view>/counts/active} + ')' }"/>
									<SegmentedButtonItem key="inquiry" text="{= 'Anfragen (' + ${view>/counts/inquiry} + ')' }"/>
									<SegmentedButtonItem key="old" text="{= 'Abgeschlossen (' + ${view>/counts/old} + ')' }"/>
								</items>
							</SegmentedButton>
							<ToolbarSpacer/>
							<SearchField width="14rem" placeholder="Bauvorhaben, Nummer, Ort" value="{view>/bauakteSearch}" liveChange=".onBauakteFilter"/>
							<Button text="Neue Bauakte" icon="sap-icon://add-document" press=".onNewBauakte" visible="{= ${session>/permissions/bauakten.create} === true }"/>
						</OverflowToolbar></headerToolbar>
						<columns>
							<Column width="7rem"><Text text="Nummer"/></Column><Column><Text text="Bauvorhaben"/></Column>
							<Column minScreenWidth="Tablet" demandPopin="true"><Text text="Baustelle"/></Column>
							<Column width="9rem"><Text text="Status"/></Column><Column width="7rem" minScreenWidth="Tablet" demandPopin="true"><Text text="Geändert"/></Column>
						</columns>
						<items>
							<ColumnListItem type="Navigation" press=".onBauakte">
								<Text text="{= ${view>number} || '–' }" class="eoTabular"/><Text text="{view>title}" class="eoStrong"/>
								<Text text="{view>place}"/>
								<ObjectStatus text="{path: 'view>status', formatter: 'fmt.bauakteStatusText'}" state="{path: 'view>status', formatter: 'fmt.bauakteStatusState'}" inverted="true"/>
								<Text text="{path: 'view>updatedAt', formatter: 'fmt.date'}"/>
							</ColumnListItem>
						</items>
					</Table>
				</uxap:ObjectPageSubSection></uxap:subSections>
			</uxap:ObjectPageSection>
			<uxap:ObjectPageSection id="secContacts" title="Kontakte">
				<uxap:subSections><uxap:ObjectPageSubSection>
					<FlexBox wrap="Wrap" renderType="Bare" class="eoCustomerContacts">
						<List items="{view>/reach}" noDataText="Keine Telefonnummern oder E-Mail-Adressen erfasst." class="eoCustomerContactList">
							<headerToolbar><Toolbar><Title text="Telefon und E-Mail" level="H3"/><ToolbarSpacer/>
								<Button icon="sap-icon://edit" type="Transparent" tooltip="Telefon und E-Mail bearbeiten" press=".onEdit" visible="{= ${session>/permissions/contacts.edit} === true }"/></Toolbar></headerToolbar>
							<CustomListItem>
								<HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiSmallMarginBeginEnd sapUiTinyMarginTopBottom">
									<HBox alignItems="Center"><core:Icon src="{view>icon}" class="sapUiSmallMarginEnd"/>
										<VBox><Link text="{view>value}" href="{view>href}" class="eoWrapAny"/><Text text="{view>label}" class="eoMuted"/></VBox></HBox>
									<Button icon="sap-icon://copy" type="Transparent" tooltip="{= 'Kopieren: ' + ${view>value} }" press=".onCopy"/>
								</HBox>
							</CustomListItem>
						</List>
						<List id="customerPersons" items="{view>/persons}" noDataText="{= ${view>/c/kind} === 'company' ? 'Noch kein Ansprechpartner erfasst.' : 'Keine weiteren Ansprechpartner erfasst.' }" class="eoCustomerContactList">
							<headerToolbar><Toolbar><Title text="Ansprechpartner" level="H3"/><ToolbarSpacer/>
								<Button text="Ansprechpartner hinzufügen" icon="sap-icon://add" type="Transparent" press=".onAddPerson" visible="{= ${session>/permissions/contacts.edit} === true }"/></Toolbar></headerToolbar>
							<CustomListItem>
								<HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiSmallMarginBeginEnd sapUiTinyMarginTopBottom">
									<HBox alignItems="Center"><core:Icon src="sap-icon://person-placeholder" class="sapUiSmallMarginEnd"/>
										<VBox>
											<Text text="{view>name}" class="eoStrong"/>
											<Text text="{view>function}" class="eoMuted" visible="{= !!${view>function} }"/>
											<HBox renderType="Bare" wrap="Wrap">
												<Link text="{view>phone}" href="tel:{view>phone}" visible="{= !!${view>phone} }" class="sapUiSmallMarginEnd"/>
												<Link text="{view>email}" href="mailto:{view>email}" visible="{= !!${view>email} }" class="eoWrapAny"/>
											</HBox>
										</VBox></HBox>
									<HBox visible="{= ${session>/permissions/contacts.edit} === true }">
										<Button icon="sap-icon://edit" type="Transparent" tooltip="{= 'Bearbeiten: ' + ${view>name} }" press=".onEditPerson"/>
										<Button icon="sap-icon://delete" type="Transparent" tooltip="{= 'Entfernen: ' + ${view>name} }" press=".onDeletePerson"/>
									</HBox>
								</HBox>
							</CustomListItem>
						</List>
					</FlexBox>
				</uxap:ObjectPageSubSection></uxap:subSections>
			</uxap:ObjectPageSection>
			<uxap:ObjectPageSection id="secDocuments" title="Dokumente">
				<uxap:subSections><uxap:ObjectPageSubSection>
					<VBox>
						<Text text="Dokumente aus allen Bauakten des Kunden, gegliedert nach Bauakte und Dokumentart. Ein Klick öffnet die Vorschau. Fotos stehen in der jeweiligen Bauakte unter „Fotos &amp; Videos“." class="eoMuted sapUiTinyMarginBottom"/>
						<Table items="{path: 'view>/documents', sorter: [{path: 'group', group: true}]}" noDataText="In den Bauakten dieses Kunden liegen noch keine Dokumente." class="eoDenseTable" popinLayout="GridSmall">
							<columns>
								<Column><Text text="Dokument"/></Column><Column width="10rem" minScreenWidth="Tablet" demandPopin="true"><Text text="Freigabe"/></Column>
								<Column width="9rem" minScreenWidth="Tablet" demandPopin="true"><Text text="Hochgeladen"/></Column>
							</columns>
							<items>
								<ColumnListItem type="Active" press=".onDocument">
									<HBox alignItems="Center"><core:Icon src="{view>icon}" class="sapUiTinyMarginEnd"/><Text text="{view>file/originalName}"/></HBox>
									<Text text="{view>approvalText}"/>
									<Text text="{path: 'view>file/createdAt', formatter: 'fmt.date'}"/>
								</ColumnListItem>
							</items>
						</Table>
					</VBox>
				</uxap:ObjectPageSubSection></uxap:subSections>
			</uxap:ObjectPageSection>
			<uxap:ObjectPageSection id="secHistory" title="Notizen und Verlauf">
				<uxap:subSections><uxap:ObjectPageSubSection>
					<VBox renderType="Bare">
						<Toolbar style="Clear"><Title text="Notiz" level="H3"/><ToolbarSpacer/>
							<Button text="Notiz bearbeiten" icon="sap-icon://notes" type="Transparent" press=".onEditNotes" visible="{= ${session>/permissions/contacts.edit} === true }"/></Toolbar>
						<Text text="{= ${view>/c/notes} || 'Keine Notiz erfasst.' }" class="eoPre sapUiSmallMarginBottom"/>
						<List items="{view>/history}" noDataText="Noch kein Verlauf." growing="true" growingThreshold="30" headerText="Verlauf">
							<StandardListItem title="{view>title}" description="{view>text}" info="{path: 'view>at', formatter: 'fmt.dateTime'}" icon="{view>icon}"
								type="{= ${view>to} ? 'Navigation' : 'Inactive' }" press=".onHistory"/>
						</List>
					</VBox>
				</uxap:ObjectPageSubSection></uxap:subSections>
			</uxap:ObjectPageSection>
		</uxap:sections>
	</uxap:ObjectPageLayout>
</mvc:View>
