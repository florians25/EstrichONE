<mvc:View controllerName="estrichone.controller.Start" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:l="sap.ui.layout"
	xmlns:core="sap.ui.core" xmlns:card="sap.f.cards" core:require="{fmt: 'estrichone/model/formatter'}" height="100%">
	<f:DynamicPage id="page" toggleHeaderOnTitleClick="false">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading><Title id="startTitle" text="{view>/greeting}" level="H1" wrapping="true"/></f:heading>
				<f:expandedContent><Text text="{view>/today}"/></f:expandedContent>
				<f:snappedContent><Text text="{view>/today}"/></f:snappedContent>
				<f:actions>
					<Button text="{i18n>common.refresh}" icon="sap-icon://refresh" press=".onRefresh"/>
				</f:actions>
			</f:DynamicPageTitle>
		</f:title>
		<f:header>
			<f:DynamicPageHeader pinnable="false">
				<!-- Kennzahlen als SAP Cards (numerischer Kopf, anklickbar) in einem Raster gleicher Höhe -->
				<f:GridContainer id="kpiCards" items="{view>/kpis}" snapToRow="true" class="eoKpiCards">
					<f:layout>
						<f:GridContainerSettings rowSize="4.5rem" columnSize="15rem" gap="0.75rem"/>
					</f:layout>
					<f:Card height="100%" class="eoKpiCard">
						<f:layoutData><f:GridContainerItemLayoutData rows="2" columns="1"/></f:layoutData>
						<f:header>
							<card:NumericHeader title="{view>title}" subtitle="{view>subtitle}" number="{view>value}" iconSrc="{view>icon}"
								state="{= ${view>color} === 'Error' ? 'Error' : ${view>color} === 'Critical' ? 'Critical' : ${view>color} === 'Good' ? 'Good' : 'Neutral' }"
								details="{view>footer}" detailsMaxLines="1" press=".onTile"/>
						</f:header>
					</f:Card>
				</f:GridContainer>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<FlexBox class="eoStartGrid" renderType="Bare">
				<Panel headerText="Schnellzugriff" backgroundDesign="Solid" class="eoCardPanel">
					<FlexBox items="{view>/groups}" wrap="Wrap" class="eoQuickGroups" renderType="Bare">
						<VBox class="eoQuickGroup" renderType="Bare">
							<Title text="{view>label}" level="H3" titleStyle="H6" class="eoQuickTitle"/>
							<VBox items="{path: 'view>tiles', templateShareable: false}" renderType="Bare">
								<Button text="{view>label}" icon="{view>icon}" type="Transparent" press=".onTile" class="eoQuickLink"/>
							</VBox>
						</VBox>
					</FlexBox>
				</Panel>
				<VBox renderType="Bare" class="eoSideStack">
					<Panel visible="{= ${session>/permissions/planning.read} === true }" backgroundDesign="Solid" class="eoCardPanel">
						<headerToolbar>
							<OverflowToolbar style="Clear">
								<Title text="{i18n>start.today}" level="H2"/>
								<ToolbarSpacer/>
								<Link text="{i18n>start.weekPlan}" href="/planung"/>
							</OverflowToolbar>
						</headerToolbar>
						<List items="{view>/assignments}" noDataText="{i18n>start.nothingToday}" busy="{view>/busy}" showSeparators="Inner" class="eoCompactList">
							<StandardListItem title="{view>bauakteNumber} {view>bauakteTitle}" description="{view>activity} · {view>crewName}"
								info="{path: 'view>startTime', formatter: 'fmt.time'}" infoState="{= ${view>warnings}.length ? 'Warning' : 'None' }"
								type="Navigation" press=".onAssignment" icon="{path: 'view>kind', formatter: 'fmt.kindIcon'}" wrapping="true"
								tooltip="{= ${view>warnings}.length ? ${view>warnings}.length + ' Hinweise' : '' }"/>
						</List>
					</Panel>
					<Panel visible="{= ${view>/approvals}.length > 0 }" backgroundDesign="Solid" class="eoCardPanel">
						<headerToolbar>
							<OverflowToolbar style="Clear">
								<Title text="Warten auf Genehmigung" level="H2"/>
								<ToolbarSpacer/>
								<Link text="Alle Freigaben" href="/dokumente?reiter=freigaben"/>
							</OverflowToolbar>
						</headerToolbar>
						<List items="{view>/approvals}" showSeparators="Inner" class="eoCompactList">
							<StandardListItem title="{view>fileName}" description="{= (${view>bauakteNumber} || '') + ' ' + ${view>bauakteTitle} + ' · von ' + ${view>requestedByName} }"
								icon="sap-icon://approvals" type="Navigation" press=".onApproval" wrapping="true"/>
						</List>
					</Panel>
					<Panel visible="{= ${session>/permissions/backup.manage} === true &amp;&amp; !!${view>/backup} }" backgroundDesign="Solid" class="eoCardPanel">
						<headerToolbar>
							<OverflowToolbar style="Clear">
								<Title text="{i18n>start.backup}" level="H2"/>
								<ToolbarSpacer/>
								<Link text="{i18n>common.open}" href="/system/sicherung"/>
							</OverflowToolbar>
						</headerToolbar>
						<VBox class="eoPanelBody" renderType="Bare">
							<ObjectStatus text="{view>/backup/text}" state="{view>/backup/state}" icon="sap-icon://upload-to-cloud"/>
							<Text text="{view>/backup/detail}" class="eoMuted"/>
							<MessageStrip visible="{= !!${view>/monitor} }" type="{view>/monitor/type}" text="{view>/monitor/text}" showIcon="true" class="sapUiSmallMarginTop"/>
						</VBox>
					</Panel>
				</VBox>
			</FlexBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
