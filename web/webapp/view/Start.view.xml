<mvc:View controllerName="estrichone.controller.Start" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:l="sap.ui.layout"
	xmlns:core="sap.ui.core" xmlns:card="sap.f.cards" xmlns:eo="estrichone.control" core:require="{fmt: 'estrichone/model/formatter'}" height="100%">
	<f:DynamicPage id="page" toggleHeaderOnTitleClick="false">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading><Title id="startTitle" text="{view>/greeting}" level="H1" wrapping="true"/></f:heading>
				<f:expandedContent><Text text="{view>/today}"/></f:expandedContent>
				<f:snappedContent><Text text="{view>/today}"/></f:snappedContent>
				<f:actions>
					<Button text="{i18n>common.refresh}" icon="sap-icon://refresh" press=".onRefresh"/>
				</f:actions>
			</f:DynamicPageTitle>
		</f:title>
		<f:content>
			<VBox renderType="Bare" class="eoStartBody">
			<!-- SAP Cards, kompakt: Kopf mit Kennzahl rechts, darunter bis zu vier Einträge; Raster passt sich der Breite an
			     (CSS-Grid mit Mindestbreite je Karte), Höhe nach Inhalt, Karten einer Reihe gleich hoch -->
			<FlexBox id="startCards" items="{path: 'view>/cards', templateShareable: false}" renderType="Bare" class="eoStartCards">
				<f:Card class="eoStartCard">
					<f:header>
						<card:NumericHeader title="{view>title}" subtitle="{view>subtitle}" number="{view>value}" iconSrc="{view>icon}" state="{view>state}"
							details="{view>details}" detailsMaxLines="1" press=".onTile"/>
					</f:header>
					<f:content>
						<List items="{path: 'view>rows', templateShareable: false}" showSeparators="None" noDataText="{view>empty}" busy="{view>loading}"
							busyIndicatorDelay="0">
							<StandardListItem type="Active" press=".onRow" title="{view>text}" icon="{view>icon}" info="{view>side}" infoState="{view>sideState}"
								wrapping="false" tooltip="{view>text}"/>
						</List>
					</f:content>
				</f:Card>
			</FlexBox>
			<FlexBox class="eoStartGrid" renderType="Bare">
				<Panel headerText="Schnellzugriff" backgroundDesign="Solid" class="eoCardPanel">
					<FlexBox items="{view>/groups}" wrap="Wrap" class="eoQuickGroups" renderType="Bare">
						<VBox class="eoQuickGroup" renderType="Bare">
							<Title text="{view>label}" level="H3" titleStyle="H6" class="eoQuickTitle"/>
							<VBox items="{path: 'view>tiles', templateShareable: false}" renderType="Bare">
								<Button text="{view>label}" icon="{view>icon}" type="Transparent" press=".onTile" class="eoQuickLink"/>
							</VBox>
						</VBox>
					</FlexBox>
				</Panel>
				<VBox renderType="Bare" class="eoSideStack">
					<!-- Systemhinweise zum Nachlesen: alle aktuellen, auch im Banner ausgeblendete -->
					<Panel id="startNotices" visible="{= ${notices>/all}.length > 0 }" backgroundDesign="Solid" class="eoCardPanel eoStartNotices">
						<headerToolbar>
							<OverflowToolbar style="Clear">
								<core:Icon src="sap-icon://bell"/>
								<Title text="Systemhinweise" level="H2"/>
								<ToolbarSpacer/>
								<ObjectStatus text="{= ${notices>/all}.length }" state="{= ${notices>/all}.length &amp;&amp; ${notices>/all/0/tone} === 'Error' ? 'Error' : 'Information' }" inverted="true"/>
							</OverflowToolbar>
						</headerToolbar>
						<VBox items="{notices>/all}" renderType="Bare" class="eoPanelBody eoNoticeList">
							<eo:NoticeCard kind="{notices>kind}" tone="{notices>tone}" icon="{notices>icon}" label="{notices>label}" title="{notices>title}"
								text="{notices>text}" period="{notices>period}" relative="{notices>relative}" remaining="{notices>remaining}"
								source="{notices>source}" dismissible="false" mode="tile" details=".onNoticeDetails"/>
						</VBox>
					</Panel>
					<Panel visible="{= ${session>/permissions/backup.manage} === true &amp;&amp; !!${view>/backup} }" backgroundDesign="Solid" class="eoCardPanel">
						<headerToolbar>
							<OverflowToolbar style="Clear">
								<Title text="{i18n>start.backup}" level="H2"/>
								<ToolbarSpacer/>
								<Link text="{i18n>common.open}" href="/system/sicherung"/>
							</OverflowToolbar>
						</headerToolbar>
						<VBox class="eoPanelBody" renderType="Bare">
							<ObjectStatus text="{view>/backup/text}" state="{view>/backup/state}" icon="sap-icon://upload-to-cloud"/>
							<Text text="{view>/backup/detail}" class="eoMuted"/>
							<MessageStrip visible="{= !!${view>/monitor} }" type="{view>/monitor/type}" text="{view>/monitor/text}" showIcon="true" class="sapUiSmallMarginTop"/>
						</VBox>
					</Panel>
					<Panel visible="{= ${view>/kpis}.length > 0 }" backgroundDesign="Solid" class="eoCardPanel">
						<headerToolbar><OverflowToolbar style="Clear"><Title text="Kennzahlen" level="H2"/></OverflowToolbar></headerToolbar>
						<List items="{view>/kpis}" showSeparators="Inner" class="eoCompactList">
							<StandardListItem title="{view>title}" info="{view>value}" infoState="{view>infoState}" icon="{view>icon}" type="Navigation" press=".onTile"/>
						</List>
					</Panel>
				</VBox>
			</FlexBox>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
