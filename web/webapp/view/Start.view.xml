<mvc:View controllerName="estrichone.controller.Start" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:l="sap.ui.layout"
	xmlns:core="sap.ui.core" core:require="{fmt: 'estrichone/model/formatter'}" height="100%">
	<f:DynamicPage id="page" toggleHeaderOnTitleClick="false" class="sapUiNoContentPadding">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading><Title id="startTitle" text="{view>/greeting}" level="H1" wrapping="true"/></f:heading>
				<f:expandedContent><Text text="{view>/today}"/></f:expandedContent>
				<f:snappedContent><Text text="{view>/today}"/></f:snappedContent>
				<f:actions>
					<Button text="{i18n>common.refresh}" icon="sap-icon://refresh" press=".onRefresh"/>
				</f:actions>
			</f:DynamicPageTitle>
		</f:title>
		<f:header>
			<f:DynamicPageHeader pinnable="false">
				<FlexBox class="eoTiles" items="{view>/kpis}">
					<GenericTile header="{view>title}" subheader="{view>subtitle}" frameType="OneByOne" press=".onTile" tooltip="{view>title}"
						state="{= ${view>loading} ? 'Loading' : 'Loaded' }">
						<TileContent footer="{view>footer}">
							<NumericContent value="{view>value}" icon="{view>icon}" withMargin="false" valueColor="{view>color}"/>
						</TileContent>
					</GenericTile>
				</FlexBox>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<l:Grid defaultSpan="XL8 L8 M12 S12" class="sapUiSmallMarginTop" containerQuery="true">
				<VBox items="{view>/groups}">
					<layoutData><l:GridData span="XL8 L8 M12 S12"/></layoutData>
					<Panel headerText="{view>label}" class="sapUiSmallMarginBottom" backgroundDesign="Solid">
						<FlexBox class="eoTiles" items="{path: 'view>tiles', templateShareable: false}">
							<GenericTile header="{view>label}" frameType="OneByOne" press=".onTile" ariaLabel="{view>label}" sizeBehavior="Small">
								<TileContent><ImageContent src="{view>icon}"/></TileContent>
							</GenericTile>
						</FlexBox>
					</Panel>
				</VBox>
				<VBox>
					<layoutData><l:GridData span="XL4 L4 M12 S12"/></layoutData>
					<Panel headerText="{i18n>start.today}" visible="{= ${session>/permissions/planning.read} === true }" backgroundDesign="Solid" class="sapUiSmallMarginBottom">
						<headerToolbar>
							<OverflowToolbar style="Clear">
								<Title text="{i18n>start.today}" level="H2"/>
								<ToolbarSpacer/>
								<Link text="{i18n>start.weekPlan}" href="/planung"/>
							</OverflowToolbar>
						</headerToolbar>
						<List items="{view>/assignments}" noDataText="{i18n>start.nothingToday}" busy="{view>/busy}">
							<ObjectListItem title="{view>bauakteNumber} {view>bauakteTitle}" number="{path: 'view>startTime', formatter: 'fmt.time'}"
								type="Navigation" press=".onAssignment" icon="{path: 'view>kind', formatter: 'fmt.kindIcon'}">
								<attributes>
									<ObjectAttribute text="{view>activity}"/>
									<ObjectAttribute text="{view>crewName}"/>
								</attributes>
								<firstStatus><ObjectStatus text="{= ${view>warnings}.length ? ${view>warnings}.length + ' Hinweise' : '' }" state="Warning"/></firstStatus>
							</ObjectListItem>
						</List>
					</Panel>
					<Panel headerText="Warten auf Genehmigung" visible="{= ${view>/approvals}.length > 0 }" backgroundDesign="Solid" class="sapUiSmallMarginBottom">
						<List items="{view>/approvals}">
							<StandardListItem title="{view>fileName}" description="{= (${view>bauakteNumber} || '') + ' ' + ${view>bauakteTitle} + ' · von ' + ${view>requestedByName} }"
								icon="sap-icon://approvals" type="Navigation" press=".onApproval"/>
						</List>
						<Link text="Alle Freigaben" href="/dokumente?reiter=freigaben" class="sapUiTinyMarginTop"/>
					</Panel>
					<Panel headerText="{i18n>start.backup}" visible="{= ${session>/permissions/backup.manage} === true &amp;&amp; !!${view>/backup} }" backgroundDesign="Solid">
						<ObjectStatus text="{view>/backup/text}" state="{view>/backup/state}" icon="sap-icon://upload-to-cloud" class="sapUiSmallMarginBottom"/>
						<Text text="{view>/backup/detail}"/>
						<Link text="{i18n>common.open}" href="/system/sicherung" class="sapUiTinyMarginTop"/>
					</Panel>
				</VBox>
			</l:Grid>
		</f:content>
	</f:DynamicPage>
</mvc:View>
