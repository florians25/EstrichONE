<mvc:View controllerName="estrichone.controller.admin.BackupTargets" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" height="100%">
	<f:DynamicPage id="page" toggleHeaderOnTitleClick="false">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading><Title text="{i18n>nav.backupTargets}" level="H1"/></f:heading>
				<f:expandedContent><Text text="Zusätzliche Sicherung auf einem anderen Rechner (NAS, alter PC, Raspberry Pi) – nur anhängen, Löschen unmöglich: Schutz vor Brand, Diebstahl und Verschlüsselungstrojanern."/></f:expandedContent>
				<f:actions>
					<Button text="Backup-Ziel koppeln" icon="sap-icon://chain-link" type="Emphasized" press=".onPair"/>
					<Button icon="sap-icon://refresh" tooltip="Aktualisieren" press=".onRefresh"/>
				</f:actions>
			</f:DynamicPageTitle>
		</f:title>
		<f:content>
			<VBox busy="{view>/busy}">
				<MessageStrip type="Information" showIcon="true" class="sapUiSmallMarginBottom" visible="{= ${view>/items}.length === 0 }"
					text="Auf dem Zielrechner (Linux mit Docker) einmal ausführen: sudo docker run --rm -v /var/run/docker.sock:/var/run/docker.sock ghcr.io/florians25/estrichone-installer:latest backup-ziel – er zeigt Adresse und Kopplungscode. Danach „Backup-Ziel koppeln“ wählen."/>
				<MessageStrip type="Warning" showIcon="true" class="sapUiSmallMarginBottom" visible="{= ${view>/items}.length > 0 }"
					text="Notfallzugang herunterladen und zusammen mit dem Backup-Passwort (.env) getrennt vom Server aufbewahren – nur damit lässt sich nach einem Totalverlust vom Backup-Ziel wiederherstellen."/>
				<List items="{view>/items}" noDataText="Kein Backup-Ziel gekoppelt." showSeparators="All">
					<CustomListItem>
						<HBox justifyContent="SpaceBetween" alignItems="Start" wrap="Wrap" class="sapUiSmallMargin">
							<VBox>
								<Title text="{view>name}" level="H3"/>
								<Text text="{view>address} · Version {view>serverVersion} · gekoppelt {view>paired}"/>
								<Text text="Fingerabdruck {view>fingerprintDisplay}" class="sapUiTinyMarginTop"/>
								<ObjectStatus text="{view>runText}" state="{view>runState}" class="sapUiTinyMarginTop"/>
								<ObjectStatus text="{view>remoteText}" state="{view>remoteState}" class="sapUiTinyMarginTop"/>
								<Text text="{view>lastError}" visible="{= !!${view>lastError} }" class="sapUiTinyMarginTop"/>
							</VBox>
							<HBox>
								<Button text="Notfallzugang" icon="sap-icon://download" press=".onRecovery"/>
								<Button text="Entfernen" icon="sap-icon://delete" type="Transparent" press=".onRemove" class="sapUiTinyMarginBegin"/>
							</HBox>
						</HBox>
					</CustomListItem>
				</List>
				<HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiMediumMarginTop sapUiTinyMarginBottom">
					<VBox>
						<Title text="Backup-Ziele, die ziehen" level="H2"/>
						<Text text="Für ein Ziel ohne feste Adresse (zuhause hinter dem Router), wenn dieser Server öffentlich erreichbar ist (z. B. im Rechenzentrum): Das Ziel verbindet sich selbst und holt die verschlüsselten Sicherungen – keine Portfreigabe nötig."/>
					</VBox>
					<Button text="Ziel, das zieht, hinzufügen" icon="sap-icon://add" press=".onCreateMirror" enabled="{view>/mirrorsAvailable}"/>
				</HBox>
				<MessageStrip type="Information" showIcon="true" visible="{= !${view>/mirrorsAvailable} }" class="sapUiSmallMarginBottom"
					text="Nur mit lokalem Hauptziel (BACKUP_REPOSITORY=/repository, Standard) und laufendem Backup-Dienst verfügbar."/>
				<List items="{view>/mirrors}" noDataText="Kein Ziel, das zieht." showSeparators="All">
					<CustomListItem>
						<HBox justifyContent="SpaceBetween" alignItems="Start" wrap="Wrap" class="sapUiSmallMargin">
							<VBox>
								<Title text="{view>title}" level="H3"/>
								<ObjectStatus text="{view>stateText}" state="{view>state}" class="sapUiTinyMarginTop"/>
								<Text text="{view>detail}" class="sapUiTinyMarginTop"/>
							</VBox>
							<Button text="Entfernen" icon="sap-icon://delete" type="Transparent" press=".onRemoveMirror"/>
						</HBox>
					</CustomListItem>
				</List>
				<VBox visible="{= ${view>/peers/items}.length > 0 }" class="sapUiMediumMarginTop">
					<HBox justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap" class="sapUiTinyMarginBottom">
						<VBox>
							<Title text="Aktualisierung der Zusatzserver" level="H2"/>
							<Text text="Per Fernaktualisierung auf die Version dieses Servers ({view>/peers/current}) bringen – Daten bleiben, bei Problemen springt der Rechner automatisch auf die bisherige Version zurück."/>
						</VBox>
						<Button text="Alle aktualisieren ({view>/peers/updatable})" icon="sap-icon://download-from-cloud" type="Emphasized"
							enabled="{= ${view>/peers/updatable} > 0 }" press=".onPeerUpdateAll"/>
					</HBox>
					<MessageStrip type="Warning" showIcon="true" class="sapUiSmallMarginBottom" visible="{= ${view>/peers/outdated} > 0 }"
						text="{view>/peers/outdated} Zusatzserver laufen noch mit einer älteren Version als dieser Server ({view>/peers/current})."/>
					<List items="{view>/peers/items}" showSeparators="All">
						<CustomListItem>
							<HBox justifyContent="SpaceBetween" alignItems="Start" wrap="Wrap" class="sapUiSmallMargin">
								<VBox>
									<Title text="{view>name}" level="H3"/>
									<Text text="{view>kindText} · {view>versionText} · {view>reachText}"/>
									<ObjectStatus text="{view>stateText}" state="{view>state}" class="sapUiTinyMarginTop"/>
									<Text text="Noch ohne Updater: einmal am Rechner mit dem aktuellen Installer aktualisieren, danach per Knopfdruck." visible="{view>needsLocal}" class="sapUiTinyMarginTop"/>
									<HBox alignItems="Center" class="sapUiTinyMarginTop">
										<Switch state="{view>autoUpdate}" customTextOn=" " customTextOff=" " change=".onPeerAuto" tooltip="Automatisch mitaktualisieren"/>
										<Text text="nach Updates dieses Servers automatisch mitaktualisieren" class="sapUiTinyMarginBegin"/>
									</HBox>
								</VBox>
								<HBox>
									<BusyIndicator size="1rem" visible="{view>active}" class="sapUiTinyMarginEnd"/>
									<Button text="Aktualisieren" icon="sap-icon://download-from-cloud" type="Emphasized" visible="{view>canUpdate}" press=".onPeerUpdate"/>
									<Button text="Befehl für den Rechner" icon="sap-icon://command-line-interfaces" visible="{view>needsLocal}" press=".onPeerCommand"/>
								</HBox>
							</HBox>
						</CustomListItem>
					</List>
				</VBox>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
