<mvc:View controllerName="estrichone.controller.admin.Overview" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:core="sap.ui.core" height="100%">
	<f:DynamicPage id="page" toggleHeaderOnTitleClick="false" class="eoAdmin eoAdminHub">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading><Title text="Verwaltung" level="H1"/></f:heading>
				<f:expandedContent><Text text="Alle Einstellungen und Verwaltungsbereiche, nach Themen gruppiert und durchsuchbar."/></f:expandedContent>
				<f:actions><Button text="{i18n>common.refresh}" icon="sap-icon://refresh" press=".onRefresh"/></f:actions>
			</f:DynamicPageTitle>
		</f:title>
		<f:header>
			<f:DynamicPageHeader pinnable="false">
				<VBox renderType="Bare" class="eoAdminHubHead">
					<MessageStrip id="adminStatus" text="{view>/status/text}" type="{view>/status/type}" customIcon="{view>/status/icon}" showIcon="true"
						visible="{= !!${view>/status} }" class="eoAdminStatus"/>
					<SearchField id="adminSearch" value="{view>/query}" liveChange=".onSearch" search=".onSearchSubmit" width="100%" class="eoAdminSearch"
						placeholder="Verwaltung durchsuchen: z. B. Backup, Logo, Passwort, Push, Speicher …" ariaLabelledBy="adminSearchLabel"/>
				</VBox>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<VBox renderType="Bare">
				<VBox items="{path: 'view>/sections', templateShareable: false}" renderType="Bare" class="eoAdminGroups">
					<VBox renderType="Bare" class="eoAdminGroup">
						<Title text="{view>title}" level="H2" titleStyle="H4"/>
						<Text text="{view>description}" class="eoMuted eoAdminGroupText"/>
						<List items="{path: 'view>areas', templateShareable: false}" showSeparators="None" class="eoAdminTiles">
							<CustomListItem type="Active" press=".onOpen" class="eoAdminTile">
								<HBox class="eoAdminTileBody" renderType="Bare">
									<core:Icon src="{view>icon}" class="eoAdminTileIcon"/>
									<VBox renderType="Bare" class="eoAdminTileText">
										<HBox alignItems="Center" justifyContent="SpaceBetween" class="eoAdminTileHead" renderType="Bare">
											<Title text="{view>title}" level="H3" titleStyle="H6" wrapping="true"/>
											<ObjectStatus text="{view>statusText}" state="{view>statusState}" inverted="true" visible="{= !!${view>statusText} }" class="eoNoShrink"/>
										</HBox>
										<Text text="{view>description}" class="eoMuted" maxLines="2"/>
									</VBox>
								</HBox>
							</CustomListItem>
						</List>
					</VBox>
				</VBox>
				<IllustratedMessage illustrationType="sapIllus-NoSearchResults" illustrationSize="Spot" enableDefaultTitleAndDescription="false"
					title="Nichts gefunden" description="Kein Verwaltungsbereich passt zu Ihrer Suche. Anderes Stichwort versuchen?" visible="{= ${view>/sections}.length === 0 }"/>
			</VBox>
		</f:content>
	</f:DynamicPage>
	<core:InvisibleText id="adminSearchLabel" text="Verwaltung durchsuchen"/>
</mvc:View>
