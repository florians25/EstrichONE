<mvc:View controllerName="estrichone.controller.admin.MasterData" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:core="sap.ui.core" height="100%">
	<f:DynamicPage id="page" toggleHeaderOnTitleClick="false">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading><Title text="{i18n>nav.masterData}" level="H1"/></f:heading>
				<f:expandedContent><Text text="Auswahllisten, Formulare für Basisdaten und Erstbegehung, Textbausteine und Vorlagen"/></f:expandedContent>
				<f:actions>
					<Button text="{view>/addText}" icon="sap-icon://add" type="Emphasized" press=".onAdd" visible="{= ${view>/canManage} &amp;&amp; !!${view>/addText} }"/>
				</f:actions>
			</f:DynamicPageTitle>
		</f:title>
		<f:content>
			<VBox>
				<FlexBox class="eoMasterData" alignItems="Start">
					<VBox class="eoMdNav" width="16rem">
						<List mode="SingleSelectMaster" selectionChange=".onNav" class="eoMdNavList" showSeparators="None">
							<GroupHeaderListItem title="Auswahllisten"/>
							<StandardListItem title="Wertelisten" icon="sap-icon://list" selected="{= ${view>/tab} === 'valueList' }" info="{= String(${view>/listCount} || '') }"><customData><core:CustomData key="tab" value="valueList"/></customData></StandardListItem>
							<GroupHeaderListItem title="Formulare"/>
							<StandardListItem title="Basisdaten" icon="sap-icon://form" selected="{= ${view>/tab} === 'form' }"><customData><core:CustomData key="tab" value="form"/></customData></StandardListItem>
							<StandardListItem title="Erstbegehung" icon="sap-icon://inspection" selected="{= ${view>/tab} === 'inspectionForm' }"><customData><core:CustomData key="tab" value="inspectionForm"/></customData></StandardListItem>
							<GroupHeaderListItem title="Vorlagen und Texte"/>
							<StandardListItem title="Textbausteine" icon="sap-icon://text" selected="{= ${view>/tab} === 'textBlock' }" info="{= String(${view>/textBlock}.length) }"><customData><core:CustomData key="tab" value="textBlock"/></customData></StandardListItem>
							<StandardListItem title="Ordnervorlagen" icon="sap-icon://folder" selected="{= ${view>/tab} === 'folderTemplate' }" info="{= String(${view>/folderTemplate}.length) }"><customData><core:CustomData key="tab" value="folderTemplate"/></customData></StandardListItem>
							<StandardListItem title="Bauakten-Vorlagen" icon="sap-icon://copy" selected="{= ${view>/tab} === 'bauakteTemplate' }" info="{= String(${view>/bauakteTemplate}.length) }"><customData><core:CustomData key="tab" value="bauakteTemplate"/></customData></StandardListItem>
							<GroupHeaderListItem title="Weitere Stammdaten"/>
							<StandardListItem title="Kunden" icon="sap-icon://customer" type="Navigation" press=".onLink"><customData><core:CustomData key="href" value="/kunden"/></customData></StandardListItem>
							<StandardListItem title="Lieferanten" icon="sap-icon://supplier" type="Navigation" press=".onLink"><customData><core:CustomData key="href" value="/lieferanten"/></customData></StandardListItem>
							<StandardListItem title="Materialstamm" icon="sap-icon://product" type="Navigation" press=".onLink"><customData><core:CustomData key="href" value="/material"/></customData></StandardListItem>
							<StandardListItem title="Kolonnen" icon="sap-icon://group" type="Navigation" press=".onLink"><customData><core:CustomData key="href" value="/planung/kolonnen"/></customData></StandardListItem>
							<StandardListItem title="Geräte und Fahrzeuge" icon="sap-icon://shipping-status" type="Navigation" press=".onLink"><customData><core:CustomData key="href" value="/planung/geraete"/></customData></StandardListItem>
							<StandardListItem title="Benutzer" icon="sap-icon://employee" type="Navigation" press=".onLink"><customData><core:CustomData key="href" value="/verwaltung/benutzer"/></customData></StandardListItem>
							<StandardListItem title="Rollen und Rechte" icon="sap-icon://role" type="Navigation" press=".onLink"><customData><core:CustomData key="href" value="/verwaltung/rollen"/></customData></StandardListItem>
							<StandardListItem title="Firmendaten" icon="sap-icon://building" type="Navigation" press=".onLink"><customData><core:CustomData key="href" value="/system/firmendaten"/></customData></StandardListItem>
						</List>
					</VBox>
					<VBox class="eoMdContent">
						<layoutData><FlexItemData growFactor="1" minWidth="0"/></layoutData>
						<Title text="{view>/tabTitle}" level="H2" class="sapUiSmallMarginBottom"/>
					<VBox visible="{= ${view>/tab} === 'valueList' }" class="eoMdPane">
							<OverflowToolbar style="Clear">
								<Label text="Liste" labelFor="listSelect"/>
								<Select id="listSelect" selectedKey="{view>/list}" items="{view>/lists}" change=".onListChange" width="16rem">
									<core:Item key="{view>key}" text="{view>text}"/>
								</Select>
								<ToolbarSpacer/>
								<Button text="Neue Liste" icon="sap-icon://add-folder" press=".onNewList" visible="{view>/canManage}"/>
							</OverflowToolbar>
							<Table items="{view>/listItems}" noDataText="Diese Liste ist leer." popinLayout="GridSmall" class="eoDenseTable">
								<columns>
									<Column><Text text="Bezeichnung"/></Column>
									<Column width="8rem"><Text text="Kurzform"/></Column>
									<Column width="10rem" minScreenWidth="Tablet" demandPopin="true"><Text text="Schlüssel"/></Column>
									<Column width="6rem"><Text text="Aktiv"/></Column>
									<Column width="10rem" hAlign="End" visible="{view>/canManage}"><Text text=""/></Column>
								</columns>
								<items>
									<ColumnListItem>
										<Text text="{view>label}"/>
										<Text text="{= ${view>shortLabel} || '–' }"/>
										<Text text="{view>key}" class="eoMuted eoTabular"/>
										<Switch state="{view>isActive}" change=".onToggleItem" enabled="{view>/canManage}" customTextOn="Ja" customTextOff="Nein"/>
										<HBox justifyContent="End">
											<Button icon="sap-icon://navigation-up-arrow" type="Transparent" tooltip="Nach oben" press=".onMoveItem">
												<customData><core:CustomData key="dir" value="-1"/></customData>
											</Button>
											<Button icon="sap-icon://navigation-down-arrow" type="Transparent" tooltip="Nach unten" press=".onMoveItem">
												<customData><core:CustomData key="dir" value="1"/></customData>
											</Button>
											<Button icon="sap-icon://edit" type="Transparent" tooltip="Umbenennen" press=".onEditItem"/>
										</HBox>
									</ColumnListItem>
								</items>
							</Table>
											</VBox>
					<VBox visible="{= ${view>/tab} === 'form' || ${view>/tab} === 'inspectionForm' }" class="eoMdPane">
							<MessageStrip text="{view>/formHint}"
								type="Information" showIcon="true" class="sapUiTinyMarginBottom"/>
							<OverflowToolbar style="Clear">
								<Button text="Feld hinzufügen" icon="sap-icon://add" press=".onAddField" visible="{view>/canManage}"/>
								<Button text="Gruppe anlegen" icon="sap-icon://add-folder" press=".onAddGroup" visible="{view>/canManage}"/>
								<ToolbarSpacer/>
								<Button text="Formular speichern" type="Emphasized" icon="sap-icon://save" press=".onSaveForm" enabled="{view>/formDirty}" visible="{view>/canManage}"/>
							</OverflowToolbar>
							<Table items="{view>/formRows}" popinLayout="GridSmall" contextualWidth="Auto" class="eoDenseTable">
								<columns>
									<Column><Text text="Feld"/></Column>
									<Column width="7rem"><Text text="Typ"/></Column>
									<Column width="4rem" hAlign="Center"><Text text="Pflicht"/></Column>
									<Column width="4rem" hAlign="Center"><Text text="{= ${view>/tab} === 'inspectionForm' ? 'Fotos' : 'Badge' }"/></Column>
									<Column width="9.5rem" hAlign="End" visible="{view>/canManage}"><Text text=""/></Column>
								</columns>
								<items>
									<ColumnListItem highlight="{= ${view>group} ? 'Information' : 'None' }">
										<VBox>
											<Title text="{view>label}" level="H4" visible="{view>group}"/>
											<Text text="{view>label}" visible="{= !${view>group} }"/>
											<Text text="{= (${view>builtin} ? 'eingebaut' : 'eigenes Feld') + (${view>listText} ? ' · ' + ${view>listText} : '') }" class="eoMuted" visible="{= !${view>group} }"/>
										</VBox>
										<Text text="{view>typeText}"/>
										<CheckBox selected="{view>required}" visible="{= !${view>group} }" select=".onFormFlag" enabled="{view>/canManage}"/>
										<CheckBox selected="{view>badge}" visible="{= !${view>group} }" select=".onFormFlag" enabled="{view>/canManage}"/>
										<HBox justifyContent="End">
											<Button icon="sap-icon://navigation-up-arrow" type="Transparent" tooltip="Nach oben" press=".onMoveRow">
												<customData><core:CustomData key="dir" value="-1"/></customData>
											</Button>
											<Button icon="sap-icon://navigation-down-arrow" type="Transparent" tooltip="Nach unten" press=".onMoveRow">
												<customData><core:CustomData key="dir" value="1"/></customData>
											</Button>
											<Button icon="sap-icon://edit" type="Transparent" tooltip="Bearbeiten" press=".onEditRow"/>
											<Button icon="sap-icon://delete" type="Transparent" tooltip="Entfernen" press=".onRemoveRow"/>
										</HBox>
									</ColumnListItem>
								</items>
							</Table>
											</VBox>
					<VBox visible="{= ${view>/tab} === 'textBlock' }" class="eoMdPane">
							<Table items="{view>/textBlock}" noDataText="Noch keine Textbausteine." popinLayout="GridSmall">
								<columns>
									<Column width="14rem"><Text text="Name"/></Column>
									<Column><Text text="Text"/></Column>
									<Column width="7rem"><Text text="Status"/></Column>
									<Column width="9rem" hAlign="End" visible="{view>/canManage}"><Text text=""/></Column>
								</columns>
								<items>
									<ColumnListItem>
										<Text text="{view>name}"/>
										<Text text="{view>content/text}" maxLines="3"/>
										<ObjectStatus text="{= ${view>isActive} ? 'Aktiv' : 'Inaktiv' }" state="{= ${view>isActive} ? 'Success' : 'None' }"/>
										<HBox justifyContent="End">
											<Button icon="sap-icon://edit" type="Transparent" tooltip="Bearbeiten" press=".onEdit"/>
											<Button icon="sap-icon://delete" type="Transparent" tooltip="Löschen" press=".onDelete"/>
										</HBox>
									</ColumnListItem>
								</items>
							</Table>
											</VBox>
					<VBox visible="{= ${view>/tab} === 'folderTemplate' }" class="eoMdPane">
							<Table items="{view>/folderTemplate}" noDataText="Noch keine Ordnervorlagen – Unterordner werden dann in jeder Bauakte angeboten." popinLayout="GridSmall">
								<columns>
									<Column width="14rem"><Text text="Name"/></Column>
									<Column width="12rem"><Text text="Dokumentart"/></Column>
									<Column><Text text="Unterordner"/></Column>
									<Column width="9rem" hAlign="End" visible="{view>/canManage}"><Text text=""/></Column>
								</columns>
								<items>
									<ColumnListItem>
										<Text text="{view>name}"/>
										<Text text="{view>categoryText}"/>
										<Text text="{view>foldersText}"/>
										<HBox justifyContent="End">
											<Button icon="sap-icon://edit" type="Transparent" tooltip="Bearbeiten" press=".onEdit"/>
											<Button icon="sap-icon://delete" type="Transparent" tooltip="Löschen" press=".onDelete"/>
										</HBox>
									</ColumnListItem>
								</items>
							</Table>
											</VBox>
					<VBox visible="{= ${view>/tab} === 'bauakteTemplate' }" class="eoMdPane">
							<Table items="{view>/bauakteTemplate}" noDataText="Noch keine Vorlagen – bei der Anlage einer Bauakte wählbar (Beschreibung und Räume)." popinLayout="GridSmall">
								<columns>
									<Column width="14rem"><Text text="Name"/></Column>
									<Column><Text text="Beschreibung"/></Column>
									<Column><Text text="Räume"/></Column>
									<Column width="9rem" hAlign="End" visible="{view>/canManage}"><Text text=""/></Column>
								</columns>
								<items>
									<ColumnListItem>
										<Text text="{view>name}"/>
										<Text text="{view>content/description}" maxLines="2"/>
										<Text text="{view>roomsText}"/>
										<HBox justifyContent="End">
											<Button icon="sap-icon://edit" type="Transparent" tooltip="Bearbeiten" press=".onEdit"/>
											<Button icon="sap-icon://delete" type="Transparent" tooltip="Löschen" press=".onDelete"/>
										</HBox>
									</ColumnListItem>
								</items>
							</Table>
											</VBox>
					</VBox>
				</FlexBox>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
