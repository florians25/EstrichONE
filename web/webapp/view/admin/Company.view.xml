<mvc:View controllerName="estrichone.controller.admin.Company" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:form="sap.ui.layout.form"
	xmlns:core="sap.ui.core" height="100%">
	<f:DynamicPage id="page" toggleHeaderOnTitleClick="false" busy="{view>/busy}">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading><Title text="Systemeinstellungen" level="H1"/></f:heading>
				<f:expandedContent><Text text="Firmendaten, Logo, Vorgaben und Verhalten von EstrichONE für alle Benutzer."/></f:expandedContent>
				<f:actions><Button id="settingsSave" text="{i18n>common.save}" icon="sap-icon://save" type="Emphasized" press=".onSave" enabled="{view>/loaded}"/></f:actions>
			</f:DynamicPageTitle>
		</f:title>
		<f:content>
			<IconTabBar id="settingsTabs" selectedKey="{view>/tab}" expandable="false" headerMode="Inline" stretchContentHeight="false" applyContentPadding="true">
				<items>
					<IconTabFilter key="firma" text="Firma">
						<form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanL="3" labelSpanM="4" maxContainerCols="1" width="52rem">
							<core:Title text="Firmendaten (Briefkopf)"/>
							<Label text="Firmenname" labelFor="coName" required="true"/><Input id="coName" value="{view>/c/name}" maxLength="200"/>
							<Label text="Straße" labelFor="coStreet"/><Input id="coStreet" value="{view>/c/street}" maxLength="200"/>
							<Label text="PLZ" labelFor="coPostal"/><Input id="coPostal" value="{view>/c/postalCode}" maxLength="10"/>
							<Label text="Ort" labelFor="coCity"/><Input id="coCity" value="{view>/c/city}" maxLength="100"/>
							<Label text="Telefon" labelFor="coPhone"/><Input id="coPhone" value="{view>/c/phone}" maxLength="50"/>
							<Label text="E-Mail" labelFor="coMail"/><Input id="coMail" value="{view>/c/email}" type="Email" maxLength="320"/>
							<Label text="Website" labelFor="coWeb"/><Input id="coWeb" value="{view>/c/website}" maxLength="200"/>
							<core:Title text="Firmenlogo"/>
							<Label text="Logo"/>
							<VBox>
								<Image src="{view>/logoUrl}" visible="{view>/logo/hasLogo}" height="4rem" alt="Firmenlogo" decorative="false" class="eoLogoPreview"/>
								<Text text="Noch kein Logo. Es erscheint im Web (Kopfzeile) und auf allen PDFs; das EstrichONE-Logo bleibt zusätzlich in der Fußzeile." visible="{= !${view>/logo/hasLogo} }" class="eoMuted"/>
								<HBox class="sapUiTinyMarginTop eoEntryRow">
									<Button id="logoUpload" text="Logo hochladen …" icon="sap-icon://upload" press=".onLogoUpload"/>
									<Button text="Entfernen" icon="sap-icon://delete" press=".onLogoDelete" visible="{view>/logo/hasLogo}"/>
								</HBox>
								<Text text="PNG, JPEG oder WebP, am besten quer mit transparentem Hintergrund." class="eoMuted sapUiTinyMarginTop"/>
							</VBox>
						</form:SimpleForm>
					</IconTabFilter>
					<IconTabFilter key="bauakte" text="Bauakten">
						<form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanL="4" labelSpanM="4" maxContainerCols="1" width="56rem">
							<core:Title text="Nummernkreis"/>
							<Label text="Aufbau der Aktennummer" labelFor="setPattern"/>
							<Input id="setPattern" value="{view>/s/numbering/bauaktePattern}" maxLength="40" valueLiveUpdate="true"
								description="z. B. {JJJJ}-{NNN} → {view>/patternExample}"/>
							<core:Title text="Vorgaben für neue Bauakten"/>
							<Label text="Hinweis „Erstbegehung fehlt“"/><Switch state="{view>/s/bauakte/warnMissingInspection}" customTextOn=" " customTextOff=" "/>
							<Label text="Vorgeschlagene Vorlage" labelFor="setTemplate"/>
							<Select id="setTemplate" selectedKey="{view>/s/bauakte/defaultTemplateId}" items="{view>/templates}" forceSelection="false">
								<core:Item key="{view>key}" text="{view>text}"/>
							</Select>
							<core:Title text="Status automatisch"/>
							<Label text="„Geplant“ → „In Ausführung“" labelFor="setAutoStart"/>
							<Select id="setAutoStart" selectedKey="{view>/s/bauakte/autoStart}">
								<core:Item key="both" text="Erster Einsatztag oder erste Aktivität vor Ort"/>
								<core:Item key="firstAssignmentDay" text="Am ersten Einsatztag (geplanter Einsatz heute)"/>
								<core:Item key="firstSiteActivity" text="Bei erster Aktivität vor Ort (Foto, Bautagebuch, Erstbegehung)"/>
								<core:Item key="manual" text="Nur von Hand"/>
							</Select>
							<Label text="Nach Abnahme abschließen"/><Switch id="setAutoComplete" state="{view>/s/bauakte/autoCompleteAfterAcceptance}" customTextOn=" " customTextOff=" "/>
							<Label text="Freigabelink für Kunden gültig" labelFor="setLinkDays"/>
							<StepInput id="setLinkDays" value="{view>/s/bauakte/acceptanceLinkDays}" min="1" max="60" description="Tage" width="12rem"/>
						</form:SimpleForm>
					</IconTabFilter>
					<IconTabFilter key="dokumente" text="Dokumente und Freigaben">
						<form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanL="4" labelSpanM="4" maxContainerCols="1" width="56rem">
							<core:Title text="Freigaben"/>
							<Label text="Vorgeschlagene Frist" labelFor="setDueDays"/>
							<StepInput id="setDueDays" value="{view>/s/approvals/defaultDueDays}" min="0" max="90" description="Tage (0 = keine)" width="14rem"/>
							<Label text="Vorgeschlagene Rolle" labelFor="setRole"/>
							<Select id="setRole" selectedKey="{view>/s/approvals/defaultRoleId}" items="{view>/roles}" forceSelection="false">
								<core:Item key="{view>key}" text="{view>text}"/>
							</Select>
							<Label text="Kommentar beim Freigeben verlangen"/><Switch state="{view>/s/approvals/requireCommentOnApprove}" customTextOn=" " customTextOff=" "/>
							<core:Title text="Ordner und Dokumentarten"/>
							<Label text=""/><Link text="Ordnervorlagen und Bauakten-Vorlagen in den Stammdaten pflegen" href="/verwaltung/stammdaten"/>
							<Label text=""/><Link text="Aufbewahrung im Archiv (Fristen je Dokumentart)" href="/system/archiv"/>
						</form:SimpleForm>
					</IconTabFilter>
					<IconTabFilter key="sitzungen" text="Anmeldung">
						<form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanL="4" labelSpanM="4" maxContainerCols="1" width="56rem">
							<core:Title text="Sitzungen im Browser"/>
							<Label text="Abmelden nach Leerlauf" labelFor="setIdle"/>
							<StepInput id="setIdle" value="{view>/s/session/idleHours}" min="1" max="168" description="Stunden" width="12rem"/>
							<Label text="„Angemeldet bleiben“" labelFor="setRemember"/>
							<StepInput id="setRemember" value="{view>/s/session/rememberDays}" min="1" max="90" description="Tage" width="12rem"/>
							<Label text=""/><Text text="Bei Aktivität verlängert sich die Sitzung von selbst. Läuft sie ab, erscheint ein Anmeldedialog – Eingaben bleiben erhalten." class="eoMuted"/>
						</form:SimpleForm>
					</IconTabFilter>
					<IconTabFilter key="benachrichtigungen" text="Benachrichtigungen">
						<form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanL="4" labelSpanM="4" maxContainerCols="1" width="56rem">
							<core:Title text="E-Mails (wirksam, sobald ein E-Mail-Konto eingerichtet ist)"/>
							<Label text="Freigabe angefordert"/><Switch state="{view>/s/notifications/approvalRequested}" customTextOn=" " customTextOff=" "/>
							<Label text="Freigabe entschieden"/><Switch state="{view>/s/notifications/approvalDecided}" customTextOn=" " customTextOff=" "/>
							<Label text="Helpdesk-Meldungen"/><Switch state="{view>/s/notifications/helpdeskUpdates}" customTextOn=" " customTextOff=" "/>
							<Label text="Zugangsbrief neuer Benutzer"/><Switch state="{view>/s/notifications/newUserLetterByEmail}" customTextOn=" " customTextOff=" "/>
							<Label text=""/><Link text="E-Mail-Konto einrichten" href="/system/e-mail"/>
						</form:SimpleForm>
						<form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanL="4" labelSpanM="4" maxContainerCols="1" width="56rem"
							visible="{= !!${view>/push} }">
							<core:Title text="Pushnachrichten und Postfach"/>
							<Label text=""/>
							<Text text="Jede Benachrichtigung landet im Postfach (Glocke). Zusätzlich als Pushnachricht im Browser (Web Push) und in der iOS-App (APNs)." class="eoMuted"/>
							<Label text="Web Push (Browser)"/><Switch id="pushWeb" state="{view>/push/webPushEnabled}" customTextOn=" " customTextOff=" "/>
							<Label text="Inhalt in Pushnachrichten zeigen"/>
							<VBox>
								<Switch id="pushContent" state="{view>/push/showContent}" customTextOn=" " customTextOff=" "/>
								<Text text="Aus: Auf dem Sperrbildschirm steht nur „Neue Benachrichtigung“; der Inhalt erscheint nach dem Öffnen." class="eoMuted"/>
							</VBox>
							<Label text="Kontakt für Push-Dienste" labelFor="pushSubject"/>
							<Input id="pushSubject" value="{view>/push/vapidSubjectInput}" maxLength="200" placeholder="{view>/push/vapidSubject}"/>
							<Label text="Registrierte Geräte"/>
							<Text text="{= ${view>/push/webDevices} + ' Browser · ' + ${view>/push/iosDevices} + ' iPhone/iPad · ' + ${view>/push/androidDevices} + ' Android' }"/>
							<core:Title text="Apple Push (APNs) für die iOS-App"/>
							<Label text="Status"/>
							<ObjectStatus id="pushApnsStatus" text="{= ${view>/push/apnsReady} ? 'Eingerichtet' + (${view>/push/apnsFromEnvironment} ? ' (aus .env)' : '') : 'Nicht eingerichtet – App erhält nur das Postfach' }"
								state="{= ${view>/push/apnsReady} ? 'Success' : 'None' }" icon="{= ${view>/push/apnsReady} ? 'sap-icon://sys-enter-2' : 'sap-icon://hint' }"/>
							<Label text="APNs verwenden"/><Switch id="pushApns" state="{view>/push/apnsEnabled}" customTextOn=" " customTextOff=" "/>
							<Label text="Key-ID" labelFor="pushKeyId"/><Input id="pushKeyId" value="{view>/push/apnsKeyId}" maxLength="10" width="12rem" placeholder="ABC123DEFG"/>
							<Label text="Team-ID" labelFor="pushTeamId"/><Input id="pushTeamId" value="{view>/push/apnsTeamId}" maxLength="10" width="12rem" placeholder="Team-ID (10 Zeichen)"/>
							<Label text="Bundle-ID der App" labelFor="pushBundle"/><Input id="pushBundle" value="{view>/push/apnsBundleId}" maxLength="200" placeholder="de.estrichone.EstrichONE"/>
							<Label text="Umgebung"/>
							<SegmentedButton selectedKey="{= ${view>/push/apnsProduction} ? 'prod' : 'sandbox' }" selectionChange=".onApnsEnvironment">
								<items><SegmentedButtonItem key="prod" text="Produktion (App Store, TestFlight)"/><SegmentedButtonItem key="sandbox" text="Sandbox (Xcode)"/></items>
							</SegmentedButton>
							<Label text="Schlüssel (.p8)"/>
							<HBox alignItems="Center" wrap="Wrap" class="eoSystemItem">
								<ObjectStatus text="{= ${view>/push/apnsKey} ? 'Neuer Schlüssel ausgewählt – wird beim Speichern verschlüsselt abgelegt' : ${view>/push/apnsKeyStored} ? 'Gespeichert (verschlüsselt)' : 'Kein Schlüssel' }"
									state="{= ${view>/push/apnsKey} || ${view>/push/apnsKeyStored} ? 'Success' : 'Warning' }"/>
								<Button text=".p8-Datei wählen …" icon="sap-icon://upload" press=".onApnsKey"/>
								<Button text="Entfernen" type="Transparent" press=".onApnsKeyRemove" visible="{= ${view>/push/apnsKeyStored} &amp;&amp; !${view>/push/apnsFromEnvironment} }"/>
							</HBox>
							<Label text=""/>
							<HBox class="eoSystemItem">
								<Button text="Testnachricht an mich" icon="sap-icon://paper-plane" press=".onPushTest"/>
								<Link text="Anleitung (docs/benachrichtigungen.md)" href="https://github.com/florians25/EstrichONE/blob/main/docs/benachrichtigungen.md" target="_blank"/>
							</HBox>
						</form:SimpleForm>
					</IconTabFilter>
					<IconTabFilter key="darstellung" text="Darstellung und Karte">
						<form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanL="4" labelSpanM="4" maxContainerCols="1" width="56rem">
							<core:Title text="Darstellung (Vorgabe für neue Benutzer)"/>
							<Label text="Farbschema" labelFor="setTheme"/>
							<Select id="setTheme" selectedKey="{view>/s/appearance/defaultTheme}" items="{view>/themes}">
								<core:Item key="{view>id}" text="{view>text}"/>
							</Select>
							<Label text="Dichte" labelFor="setDensity"/>
							<SegmentedButton id="setDensity" selectedKey="{view>/s/appearance/density}">
								<items><SegmentedButtonItem key="compact" text="Kompakt"/><SegmentedButtonItem key="cozy" text="Komfortabel (Touch)"/></items>
							</SegmentedButton>
							<core:Title text="Karte"/>
							<Label text="Kachelserver" labelFor="setTiles"/>
							<Input id="setTiles" value="{view>/s/map/tileUrl}" placeholder="https://tile.openstreetmap.org/{z}/{x}/{y}.png" maxLength="300"/>
							<Label text="Quellenangabe" labelFor="setAttribution"/><Input id="setAttribution" value="{view>/s/map/attribution}" maxLength="300"/>
							<Label text=""/><Text text="Der öffentliche OpenStreetMap-Server ist für geringe Nutzung gedacht. Bei vielen Benutzern einen eigenen oder kommerziellen Kachelserver (HTTPS) eintragen." class="eoMuted"/>
						</form:SimpleForm>
					</IconTabFilter>
					<IconTabFilter key="pdf" text="PDF-Layout">
						<form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanL="4" labelSpanM="4" maxContainerCols="1" width="56rem">
							<core:Title text="Ausdrucke (Bauakte, Abnahme, Planung, Benutzerbrief)"/>
							<Label text="Firmenlogo im Kopf"/><Switch state="{view>/s/pdf/showCompanyLogo}" customTextOn=" " customTextOff=" "/>
							<Label text="EstrichONE-Logo in der Fußzeile"/><Switch state="{view>/s/pdf/showEstrichOneLogo}" customTextOn=" " customTextOff=" "/>
							<Label text="Akzentfarbe" labelFor="setAccent"/>
							<Input id="setAccent" value="{view>/s/pdf/accentColor}" maxLength="7" width="8rem" placeholder="#1F4E79"/>
							<Label text="Zusätzliche Fußzeile" labelFor="setFooter"/>
							<Input id="setFooter" value="{view>/s/pdf/footerText}" maxLength="200" placeholder="z. B. Bankverbindung, Registergericht, USt-IdNr."/>
							<Label text="Fotos je Zeile" labelFor="setPhotos"/>
							<StepInput id="setPhotos" value="{view>/s/pdf/photosPerRow}" min="1" max="3" width="8rem"/>
						</form:SimpleForm>
					</IconTabFilter>
					<IconTabFilter key="speicher" text="Speicher">
						<form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanL="4" labelSpanM="4" maxContainerCols="1" width="56rem">
							<core:Title text="Fotos und Dokumente speicherschonend ablegen"/>
							<Label text=""/>
							<Text text="Gilt für alle Uploads aus Web und Apps. Fotos werden als JPEG mit mozjpeg neu kodiert, nach EXIF gedreht und bei Bedarf verkleinert; Aufnahmezeit und GPS bleiben erhalten. Vorschaustufen 320, 1280 und 2560 Pixel (WebP)." class="eoMuted"/>
							<Label text="Fotos unverändert speichern"/>
							<Switch id="mediaKeep" state="{view>/s/media/keepOriginalPhotos}" customTextOn=" " customTextOff=" "/>
							<Label text="Bildqualität (JPEG)" labelFor="mediaQuality"/>
							<HBox alignItems="Center" class="eoSystemItem">
								<StepInput id="mediaQuality" value="{view>/s/media/photoQuality}" min="60" max="95" step="1" width="8rem" enabled="{= !${view>/s/media/keepOriginalPhotos} }"/>
								<Text text="{= ${view>/s/media/photoQuality} >= 88 ? 'sehr hoch – große Dateien' : ${view>/s/media/photoQuality} >= 78 ? 'empfohlen: scharf, etwa ein Drittel der Kameragröße' : 'sparsam – feine Details leiden' }" class="eoMuted"/>
							</HBox>
							<Label text="Längste Kante" labelFor="mediaEdge"/>
							<Select id="mediaEdge" selectedKey="{path: 'view>/s/media/photoMaxEdge', type: 'sap.ui.model.type.Integer'}" width="16rem" enabled="{= !${view>/s/media/keepOriginalPhotos} }">
								<core:Item key="2048" text="2048 px (Bildschirm)"/>
								<core:Item key="3072" text="3072 px"/>
								<core:Item key="4096" text="4096 px (empfohlen, Druck A4)"/>
								<core:Item key="6144" text="6144 px"/>
								<core:Item key="8192" text="8192 px (kaum Begrenzung)"/>
							</Select>
							<Label text="PDFs verlustfrei verdichten"/>
							<VBox>
								<Switch id="mediaPdf" state="{view>/s/media/optimizePdfs}" customTextOn=" " customTextOff=" "/>
								<Text text="Unkomprimierte Inhalte werden gepackt, Unbenutztes entfernt. Signierte oder verschlüsselte PDFs und Office-Dateien bleiben bitgenau." class="eoMuted"/>
							</VBox>
							<core:Title text="Belegung"/>
							<Label text="Gespeichert"/>
							<Text text="{view>/storage/storedText}"/>
							<Label text="Gespart"/>
							<ObjectStatus text="{view>/storage/savedText}" state="Success"/>
							<Label text="Dubletten"/>
							<Text text="{view>/storage/duplicateText}"/>
							<Label text="Auf dem Datenträger"/>
							<Text text="{view>/storage/diskText}"/>
							<Label text=""/>
							<Table items="{view>/storage/kinds}" class="eoDenseTable" width="34rem">
								<columns>
									<Column><Text text="Art"/></Column>
									<Column hAlign="End"><Text text="Dateien"/></Column>
									<Column hAlign="End"><Text text="Gespeichert"/></Column>
									<Column hAlign="End"><Text text="Hochgeladen"/></Column>
								</columns>
								<items>
									<ColumnListItem>
										<Text text="{view>label}"/><Text text="{view>files}" class="eoTabular"/><Text text="{view>bytesText}" class="eoTabular"/>
										<Text text="{view>uploadedText}" class="eoTabular"/>
									</ColumnListItem>
								</items>
							</Table>
							<core:Title text="Bestehende Dateien nachverdichten"/>
							<Label text="Kandidaten"/>
							<Text text="{= ${view>/storage/candidates} + ' Fotos/PDFs noch nicht verdichtet (archivierte bleiben unverändert)' }"/>
							<Label text="Status"/>
							<ObjectStatus text="{view>/storage/jobText}" state="{= ${view>/storage/job/running} ? 'Information' : 'None' }"
								icon="{= ${view>/storage/job/running} ? 'sap-icon://synchronize' : '' }"/>
							<Label text=""/>
							<HBox class="eoSystemItem">
								<Button id="mediaOptimize" text="Jetzt nachverdichten" icon="sap-icon://compare" press=".onOptimizeStorage"
									enabled="{= !${view>/storage/job/running} &amp;&amp; ${view>/storage/candidates} > 0 }"/>
								<Button text="Aktualisieren" icon="sap-icon://refresh" type="Transparent" press=".onStorageRefresh"/>
							</HBox>
						</form:SimpleForm>
					</IconTabFilter>
					<IconTabFilter key="module" text="Module">
						<form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanL="4" labelSpanM="4" maxContainerCols="1" width="56rem">
							<core:Title text="Module ein- und ausschalten"/>
							<Label text="Material (Material, Lieferanten, Bestellungen)" labelFor="modMaterials"/>
							<Switch id="modMaterials" state="{view>/s/modules/materials}" customTextOn=" " customTextOff=" "/>
							<Label text=""/><Text text="Abgeschaltete Module verschwinden aus Navigation, Bauakte und Übersichten. Die Daten bleiben erhalten und sind nach dem Einschalten wieder da." class="eoMuted"/>
						</form:SimpleForm>
					</IconTabFilter>
					<IconTabFilter key="system" text="System">
						<List>
							<StandardListItem title="Sicherung" description="Backup Center, Wiederherstellung" icon="sap-icon://upload-to-cloud" type="Navigation" press=".onLink" custom:path="/system/sicherung" xmlns:custom="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"/>
							<StandardListItem title="Backup-Ziele" description="Sicherung auf anderer Hardware" icon="sap-icon://it-host" type="Navigation" press=".onLink" custom:path="/system/backup-ziele" xmlns:custom="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"/>
							<StandardListItem title="Archiv" description="Revisionssichere Aufbewahrung (10 Jahre)" icon="sap-icon://attachment-zip-file" type="Navigation" press=".onLink" custom:path="/system/archiv" xmlns:custom="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"/>
							<StandardListItem title="E-Mail" description="SMTP-Konto, Vorlagen, Versandprotokoll" icon="sap-icon://email" type="Navigation" press=".onLink" custom:path="/system/e-mail" xmlns:custom="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"/>
							<StandardListItem title="Protokoll" description="Wer hat wann was getan" icon="sap-icon://activities" type="Navigation" press=".onLink" custom:path="/system/protokoll" xmlns:custom="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"/>
						</List>
					</IconTabFilter>
				</items>
			</IconTabBar>
		</f:content>
	</f:DynamicPage>
</mvc:View>
