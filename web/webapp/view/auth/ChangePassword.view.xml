<mvc:View controllerName="estrichone.controller.auth.ChangePassword" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f"
	xmlns:core="sap.ui.core" height="100%">
	<f:DynamicPage id="page" toggleHeaderOnTitleClick="false">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading><Title text="{i18n>password.title}" level="H1"/></f:heading>
			</f:DynamicPageTitle>
		</f:title>
		<f:content>
			<VBox width="32rem" class="sapUiSmallMargin">
				<MessageStrip text="{i18n>password.forced}" type="Information" showIcon="true" visible="{session>/mustChangePassword}" class="sapUiSmallMarginBottom"/>
				<MessageStrip text="{i18n>password.done}" type="Success" showIcon="true" visible="{view>/done}" class="sapUiSmallMarginBottom"/>
				<Label text="{i18n>password.current}" labelFor="pwCurrent" required="true"/>
				<Input id="pwCurrent" value="{view>/current}" valueLiveUpdate="true" type="Password" width="100%"/>
				<Label text="{i18n>password.new}" labelFor="pwNew" required="true" class="sapUiSmallMarginTop"/>
				<Input id="pwNew" value="{view>/next}" valueLiveUpdate="true" type="Password" width="100%"/>
				<Text text="{i18n>password.newHint}" class="eoHelpText"/>
				<Label text="{i18n>password.repeat}" labelFor="pwRepeat" required="true" class="sapUiSmallMarginTop"/>
				<Input id="pwRepeat" value="{view>/repeat}" valueLiveUpdate="true" type="Password" width="100%" submit=".onSubmit"/>
				<MessageStrip text="{view>/error}" type="Error" showIcon="true" visible="{= !!${view>/error} }" class="sapUiSmallMarginTop">
					<customData><core:CustomData key="role" value="alert" writeToDom="true"/></customData>
				</MessageStrip>
				<Button text="{i18n>password.submit}" type="Emphasized" press=".onSubmit" busy="{view>/busy}" class="sapUiMediumMarginTop"/>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
