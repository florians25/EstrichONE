<mvc:View controllerName="estrichone.controller.planning.Resources" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:core="sap.ui.core"
	xmlns:eo="estrichone.control" core:require="{fmt: 'estrichone/model/formatter'}" height="100%">
	<f:DynamicPage id="page" toggleHeaderOnTitleClick="false">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading><Title text="{view>/title}" level="H1"/></f:heading>
				<f:expandedContent>
					<HBox alignItems="Center" wrap="Wrap">
						<Text text="{view>/subtitle}" class="sapUiSmallMarginEnd"/>
						<Link text="Abwesenheiten: Personal (HR) › Urlaubsplan" href="/personal/urlaub?reiter=plan" visible="{= ${session>/permissions/hr.read} === true }"/>
					</HBox>
				</f:expandedContent>
				<f:actions>
					<Button text="{view>/addText}" icon="sap-icon://add" type="Emphasized" press=".onAdd" visible="{= ${session>/permissions/planning.manage} === true }"/>
				</f:actions>
			</f:DynamicPageTitle>
		</f:title>
		<f:content>
			<IconTabBar id="tabs" selectedKey="{view>/tab}" expandable="false" class="eoNoTabHeader" stretchContentHeight="false" applyContentPadding="false">
				<items>
					<IconTabFilter key="kolonnen" text="Kolonnen" count="{= ${view>/crews}.length }">
						<Table items="{view>/crews}" busy="{view>/busy}" noDataText="Noch keine Kolonnen." popinLayout="GridSmall">
							<columns>
								<Column><Text text="Kolonne"/></Column>
								<Column width="12rem" minScreenWidth="Tablet" demandPopin="true"><Text text="Kolonnenführer"/></Column>
								<Column minScreenWidth="Tablet" demandPopin="true"><Text text="Mitglieder"/></Column>
								<Column width="11rem" minScreenWidth="Tablet" demandPopin="true"><Text text="Auslastung (Woche)"/></Column>
								<Column width="7rem"><Text text="Status"/></Column>
								<Column width="14rem" hAlign="End" visible="{= ${session>/permissions/planning.manage} === true }"><Text text="Aktionen"/></Column>
							</columns>
							<items>
								<ColumnListItem>
									<HBox alignItems="Center"><eo:Swatch color="{view>color}"/><Text text="{view>name}"/></HBox>
									<Text text="{view>leaderName}"/>
									<Text text="{view>memberNames}"/>
									<ProgressIndicator percentValue="{= Math.min(100, ${view>load/percent}) }" displayValue="{view>load/percent} %" state="{view>load/state}"
										tooltip="{view>load/text}" showValue="true" height="1.25rem"/>
									<ObjectStatus text="{= ${view>isActive} ? 'Aktiv' : 'Inaktiv' }" state="{= ${view>isActive} ? 'Success' : 'None' }" inverted="true"/>
									<HBox justifyContent="End">
										<Button text="Bearbeiten" type="Transparent" press=".onEditCrew"/>
										<Button text="{= ${view>isActive} ? 'Deaktivieren' : 'Aktivieren' }" type="Transparent" press=".onToggleCrew"/>
									</HBox>
								</ColumnListItem>
							</items>
						</Table>
					</IconTabFilter>
					<IconTabFilter key="geraete" text="Fahrzeuge und Geräte" count="{= ${view>/resources}.length }">
						<IconTabBar selectedKey="{view>/deviceTab}" expandable="false" applyContentPadding="false" stretchContentHeight="false" class="eoInnerTabs">
							<items>
								<IconTabFilter key="fahrzeuge" text="Fahrzeuge" icon="sap-icon://shipping-status" count="{= ${view>/vehicles}.length }">
								<Table items="{view>/vehicles}" busy="{view>/busy}" noDataText="Noch keine Fahrzeuge." popinLayout="GridSmall">
									<columns>
										<Column width="4rem"><Text text=""/></Column>
										<Column><Text text="Bezeichnung"/></Column>
										<Column width="9rem" minScreenWidth="Tablet" demandPopin="true"><Text text="Kennzeichen"/></Column>
										<Column minScreenWidth="Desktop" demandPopin="true"><Text text="Typ / Führerschein"/></Column>
										<Column width="10rem" minScreenWidth="Tablet" demandPopin="true"><Text text="TÜV"/></Column>
										<Column width="10rem" minScreenWidth="Tablet" demandPopin="true"><Text text="Wartung"/></Column>
										<Column width="9rem" minScreenWidth="Desktop" demandPopin="true"><Text text="Kolonne"/></Column>
										<Column width="8rem"><Text text="Status"/></Column>
										<Column width="17rem" hAlign="End"><Text text="Aktionen"/></Column>
									</columns>
									<items>
										<ColumnListItem>
											<Avatar src="{view>thumb}" displaySize="XS" displayShape="Square" fallbackIcon="sap-icon://shipping-status"/>
											<VBox><Text text="{view>name}" class="eoStrong"/><Text text="{view>notes}" class="eoMuted" visible="{= !!${view>notes} }"/></VBox>
											<Text text="{= ${view>identifier} || '–' }"/>
											<Text text="{view>detailText}"/>
											<ObjectStatus text="{view>inspection/text}" state="{view>inspection/state}"/>
											<ObjectStatus text="{view>service/text}" state="{view>service/state}"/>
											<Text text="{view>crewName}"/>
											<ObjectStatus text="{= ${view>isActive} ? 'Verfügbar' : 'Außer Betrieb' }" state="{= ${view>isActive} ? 'Success' : 'None' }" inverted="true"/>
											<HBox justifyContent="End">
												<Button text="{= 'Dokumente (' + ${view>docCount} + ')' }" type="Transparent" press=".onDocuments"/>
												<Button text="Bearbeiten" type="Transparent" press=".onEditResource" visible="{= ${session>/permissions/planning.manage} === true }"/>
												<Button text="{= ${view>isActive} ? 'Außer Betrieb' : 'Verfügbar' }" type="Transparent" press=".onToggleResource" visible="{= ${session>/permissions/planning.manage} === true }"/>
											</HBox>
										</ColumnListItem>
									</items>
								</Table>
								</IconTabFilter>
								<IconTabFilter key="maschinen" text="Pumpen &amp; Maschinen" icon="sap-icon://wrench" count="{= ${view>/machines}.length }">
								<Table items="{view>/machines}" busy="{view>/busy}" noDataText="Noch keine Pumpen oder Maschinen." popinLayout="GridSmall">
									<columns>
										<Column width="4rem"><Text text=""/></Column>
										<Column><Text text="Bezeichnung"/></Column>
										<Column width="9rem" minScreenWidth="Tablet" demandPopin="true"><Text text="Seriennummer"/></Column>
										<Column minScreenWidth="Desktop" demandPopin="true"><Text text="Art / Typ"/></Column>
										<Column width="10rem" minScreenWidth="Tablet" demandPopin="true"><Text text="Prüfung"/></Column>
										<Column width="10rem" minScreenWidth="Tablet" demandPopin="true"><Text text="Wartung"/></Column>
										<Column width="9rem" minScreenWidth="Desktop" demandPopin="true"><Text text="Kolonne"/></Column>
										<Column width="8rem"><Text text="Status"/></Column>
										<Column width="17rem" hAlign="End"><Text text="Aktionen"/></Column>
									</columns>
									<items>
										<ColumnListItem>
											<Avatar src="{view>thumb}" displaySize="XS" displayShape="Square" fallbackIcon="sap-icon://wrench"/>
											<VBox><Text text="{view>name}" class="eoStrong"/><Text text="{view>notes}" class="eoMuted" visible="{= !!${view>notes} }"/></VBox>
											<Text text="{= ${view>identifier} || '–' }"/>
											<Text text="{view>detailText}"/>
											<ObjectStatus text="{view>inspection/text}" state="{view>inspection/state}"/>
											<ObjectStatus text="{view>service/text}" state="{view>service/state}"/>
											<Text text="{view>crewName}"/>
											<ObjectStatus text="{= ${view>isActive} ? 'Verfügbar' : 'Außer Betrieb' }" state="{= ${view>isActive} ? 'Success' : 'None' }" inverted="true"/>
											<HBox justifyContent="End">
												<Button text="{= 'Dokumente (' + ${view>docCount} + ')' }" type="Transparent" press=".onDocuments"/>
												<Button text="Bearbeiten" type="Transparent" press=".onEditResource" visible="{= ${session>/permissions/planning.manage} === true }"/>
												<Button text="{= ${view>isActive} ? 'Außer Betrieb' : 'Verfügbar' }" type="Transparent" press=".onToggleResource" visible="{= ${session>/permissions/planning.manage} === true }"/>
											</HBox>
										</ColumnListItem>
									</items>
								</Table>
								</IconTabFilter>
							</items>
						</IconTabBar>
					</IconTabFilter>
				</items>
			</IconTabBar>
		</f:content>
	</f:DynamicPage>
</mvc:View>
