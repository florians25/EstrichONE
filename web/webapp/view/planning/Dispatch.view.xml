<mvc:View controllerName="estrichone.controller.planning.Dispatch" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:core="sap.ui.core"
	xmlns:eo="estrichone.control" height="100%">
	<f:DynamicPage id="page" toggleHeaderOnTitleClick="false" class="eoDispatchPage">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading><Title text="Wer fährt wohin" level="H1"/></f:heading>
				<f:expandedContent><Text text="{view>/subtitle}"/></f:expandedContent>
				<f:snappedContent><Text text="{view>/subtitle}"/></f:snappedContent>
				<f:actions>
					<Button text="Baustelle zuordnen" icon="sap-icon://add" type="Emphasized" press=".onAddSite" visible="{view>/board/canPlan}"/>
					<Button text="PDF" icon="sap-icon://pdf-attachment" press=".onPdf" tooltip="Wer fährt wohin als PDF (Aushang, Fahrerliste)"/>
					<Button icon="sap-icon://print" tooltip="Drucken" press=".onPrint"/>
					<Button icon="sap-icon://refresh" tooltip="Neu laden" press=".onRefresh"/>
				</f:actions>
			</f:DynamicPageTitle>
		</f:title>
		<f:header>
			<f:DynamicPageHeader pinnable="false">
				<FlexBox wrap="Wrap" alignItems="Center" class="eoEntryRow">
					<SegmentedButton selectedKey="{view>/dayKey}" selectionChange=".onDayKey">
						<items>
							<SegmentedButtonItem key="heute" text="Heute"/>
							<SegmentedButtonItem key="morgen" text="Morgen"/>
							<SegmentedButtonItem key="datum" text="Anderer Tag"/>
						</items>
					</SegmentedButton>
					<Button icon="sap-icon://navigation-left-arrow" tooltip="Vorheriger Tag" press=".onPrev"/>
					<DatePicker value="{view>/day}" valueFormat="yyyy-MM-dd" displayFormat="EEEE, dd.MM.yyyy" width="15rem" change=".onPick" ariaLabelledBy="dispatchDayLabel"/>
					<core:InvisibleText id="dispatchDayLabel" text="Tag"/>
					<Button icon="sap-icon://navigation-right-arrow" tooltip="Nächster Tag" press=".onNext"/>
					<ToolbarSpacer/>
					<SearchField value="{view>/search}" liveChange=".onSearch" placeholder="Baustelle oder Kolonne suchen" width="16rem"/>
				</FlexBox>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<VBox busy="{view>/busy}" busyIndicatorDelay="200">
				<MessageStrip text="{view>/error}" type="Error" showIcon="true" visible="{= !!${view>/error} }" class="sapUiSmallMarginBottom"/>
				<MessageStrip text="Baustelle aus dem Vorrat auf eine Kolonne ziehen – oder „Kolonne zuordnen…“ wählen. Zwischen Kolonnen verschieben per Ziehen, zurück in den Vorrat ziehen entfernt die Zuordnung. Eine Baustelle kann mehreren Kolonnen zugeordnet sein."
					type="Information" showIcon="true" visible="{view>/board/canPlan}" class="sapUiSmallMarginBottom eoNoPrint"/>
				<FlexBox id="dispatchRoot" alignItems="Start" wrap="Wrap" class="eoDispatch">
					<VBox class="eoDispatchPool" width="19rem">
						<Panel class="eoDispatchSitePool">
							<customData><core:CustomData key="dropsite" value="pool" writeToDom="true"/></customData>
							<headerToolbar>
								<Toolbar><Title text="{= 'Baustellen (' + ${view>/pool}.length + ' aktiv)' }" level="H3"/><ToolbarSpacer/>
									<Button icon="sap-icon://add" tooltip="Weitere Baustelle zuordnen" press=".onAddSite" visible="{view>/board/canPlan}"/></Toolbar>
							</headerToolbar>
							<List items="{view>/pool}" noDataText="Keine aktive Bauakte gefunden." showSeparators="Inner">
								<CustomListItem class="eoDispatchPerson" highlight="{= ${view>crewCount} === 0 ? 'Warning' : 'None' }">
									<customData>
										<core:CustomData key="dragkind" value="site" writeToDom="true"/>
										<core:CustomData key="dragid" value="{view>bauakteId}" writeToDom="true"/>
									</customData>
									<HBox alignItems="Center" class="sapUiTinyMargin">
										<VBox class="eoGrow">
											<Text text="{= (${view>number} ? ${view>number} + ' · ' : '') + ${view>title} }" class="eoStrong" wrapping="true"/>
											<Text text="{view>address}" class="eoMuted" visible="{= !!${view>address} }" wrapping="true"/>
											<ObjectStatus text="{view>crewText}" state="{= ${view>crewCount} === 0 ? 'Warning' : 'Information' }"/>
										</VBox>
										<Button icon="sap-icon://group" type="Transparent" tooltip="{= 'Kolonne zuordnen: ' + ${view>title} }" press=".onAssignSite" visible="{view>/board/canPlan}"/>
									</HBox>
								</CustomListItem>
							</List>
						</Panel>
						<Panel headerText="{= 'Abwesend / Termine (' + ${view>/away}.length + ')' }" class="sapUiSmallMarginTop" visible="{= ${view>/away}.length > 0 }">
							<List items="{view>/away}" showSeparators="Inner">
								<StandardListItem title="{view>name}" description="{view>note}" icon="sap-icon://general-leave-request"/>
							</List>
						</Panel>
					</VBox>
					<VBox class="eoGrow eoDispatchSites">
						<Text text="Keine Kolonnen angelegt (Planung › Kolonnen und Geräte)." class="eoMuted sapUiSmallMargin" visible="{= ${view>/lanes}.length === 0 }"/>
						<VBox items="{view>/lanes}" class="eoDispatchLanes">
							<VBox class="eoDispatchLane">
								<customData><core:CustomData key="dropsite" value="{view>id}" writeToDom="true"/></customData>
								<HBox alignItems="Center" wrap="Wrap" class="eoDispatchLaneHead">
									<eo:Swatch color="{view>color}"/>
									<Title text="{view>name}" level="H3" class="sapUiTinyMarginEnd"/>
									<Text text="{view>info}" class="eoMuted sapUiTinyMarginEnd"/>
									<ObjectStatus text="{view>vehicleText}" icon="sap-icon://shipping-status" visible="{= !!${view>vehicleText} }" class="sapUiTinyMarginEnd"/>
									<ObjectStatus text="{view>absentText}" state="Warning" icon="sap-icon://general-leave-request" visible="{= !!${view>absentText} }" class="sapUiTinyMarginEnd"/>
									<ObjectStatus text="{= ${view>sites}.length + ' Baustellen am Tag' }" state="Information" visible="{= ${view>sites}.length > 1 }" class="sapUiTinyMarginEnd"/>
									<ObjectStatus text="{view>warningText}" state="Warning" icon="sap-icon://alert" visible="{= !!${view>warningText} }"/>
								</HBox>
								<FlexBox items="{path: 'view>sites', templateShareable: false}" wrap="Wrap" class="eoDispatchGrid">
									<VBox class="eoDispatchCard eoDispatchChip" width="17rem">
										<customData>
											<core:CustomData key="dragkind" value="site" writeToDom="true"/>
											<core:CustomData key="dragid" value="{view>bauakteId}" writeToDom="true"/>
											<core:CustomData key="dragfrom" value="{view>crewId}" writeToDom="true"/>
										</customData>
										<HBox alignItems="Start">
											<ObjectStatus text="{view>timeText}" state="Information" inverted="true" class="sapUiTinyMarginEnd eoTabular"/>
											<VBox class="eoGrow">
												<Link text="{= (${view>number} ? ${view>number} + ' · ' : '') + ${view>title} }" href="{= '/bauakten/' + ${view>bauakteId} }" emphasized="true" wrapping="true"/>
												<Text text="{view>address}" visible="{= !!${view>address} }" class="eoMuted" wrapping="true"/>
												<Text text="{view>activity}" wrapping="true"/>
											</VBox>
											<Button icon="sap-icon://overflow" type="Transparent" tooltip="{= 'Aktionen: ' + ${view>title} }" press=".onSiteMenu" visible="{view>/board/canPlan}" class="eoNoPrint"/>
										</HBox>
									</VBox>
								</FlexBox>
								<Text text="Keine Baustelle – Baustelle hierher ziehen." class="eoMuted" visible="{= ${view>sites}.length === 0 }"/>
							</VBox>
						</VBox>
						<Panel headerText="Details: einzelne Mitarbeiter und Fahrzeuge je Baustelle" expandable="true" expanded="{view>/details}" class="sapUiSmallMarginTop eoDispatchDetails eoNoPrint">
							<HBox wrap="Wrap" class="sapUiTinyMarginBottom">
								<Text text="{= 'Noch frei: ' + (${view>/freeText} || 'niemand') }" class="eoMuted sapUiSmallMarginEnd"/>
								<Text text="{= 'Freie Fahrzeuge: ' + (${view>/idleText} || 'keine') }" class="eoMuted"/>
							</HBox>
							<FlexBox items="{view>/sites}" wrap="Wrap" class="eoDispatchGrid">
								<VBox class="eoDispatchCard eoDispatchDetailCard" width="20rem">
									<Text text="{view>title}" class="eoStrong"/>
									<Label text="Team"/>
									<FlexBox items="{path: 'view>people', templateShareable: false}" wrap="Wrap" class="eoDispatchTokens">
										<Button text="{view>name}" icon="sap-icon://employee" type="{= ${view>conflict} ? 'Attention' : 'Default' }" press=".onPersonMenu" tooltip="{view>tooltip}"/>
									</FlexBox>
									<Label text="Fahrzeuge und Geräte"/>
									<FlexBox items="{path: 'view>vehicles', templateShareable: false}" wrap="Wrap" class="eoDispatchTokens">
										<Button text="{view>name}" icon="{= ${view>kind} === 'vehicle' ? 'sap-icon://shipping-status' : 'sap-icon://wrench' }" press=".onVehicleMenu"/>
									</FlexBox>
									<MessageStrip text="{= ${view>warnings}.join(' ') }" type="Warning" visible="{= ${view>warnings}.length > 0 }" class="sapUiTinyMarginTop"/>
									<HBox class="sapUiTinyMarginTop" visible="{view>/board/canPlan}">
										<Button text="Mitarbeiter" icon="sap-icon://add-employee" press=".onAddPerson" class="sapUiTinyMarginEnd" tooltip="{= 'Mitarbeiter einteilen: ' + ${view>title} }"/>
										<Button text="Fahrzeug" icon="sap-icon://add" press=".onAddVehicle" tooltip="{= 'Fahrzeug einteilen: ' + ${view>title} }"/>
									</HBox>
								</VBox>
							</FlexBox>
						</Panel>
						<Panel headerText="Termine ohne Bauvorhaben" visible="{= ${view>/appointments}.length > 0 }" class="sapUiSmallMarginTop">
							<List items="{view>/appointments}">
								<StandardListItem title="{view>title}" description="{view>description}" info="{view>time}" icon="sap-icon://appointment"/>
							</List>
						</Panel>
					</VBox>
				</FlexBox>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
