<mvc:View controllerName="estrichone.controller.Today" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:grid="sap.ui.layout.cssgrid"
	xmlns:core="sap.ui.core" core:require="{fmt: 'estrichone/model/formatter'}" height="100%">
	<f:DynamicPage id="page" toggleHeaderOnTitleClick="false" class="eoToday">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading><Title text="{i18n>nav.today}" level="H1"/></f:heading>
				<f:expandedContent><Text text="{view>/today}"/></f:expandedContent>
				<f:snappedContent><Text text="{view>/today}"/></f:snappedContent>
				<f:actions><Button text="{i18n>common.refresh}" icon="sap-icon://refresh" press=".onRefresh"/></f:actions>
			</f:DynamicPageTitle>
		</f:title>
		<f:header>
			<f:DynamicPageHeader pinnable="false">
				<FlexBox class="eoTiles" items="{view>/kpis}">
					<GenericTile header="{view>title}" frameType="OneByHalf" press=".onKpi" state="{= ${view>loading} ? 'Loading' : 'Loaded' }">
						<TileContent><NumericContent value="{view>value}" icon="{view>icon}" valueColor="{view>color}" withMargin="false"/></TileContent>
					</GenericTile>
				</FlexBox>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<VBox>
				<grid:CSSGrid gridTemplateColumns="repeat(auto-fill, minmax(22rem, 1fr))" gridGap="1rem" class="eoTodayGrid">
					<!-- Einsätze heute nach Kolonne: doppelte Breite -->
					<Panel backgroundDesign="Solid" class="eoTodayPanel eoTodayWide" visible="{= ${session>/permissions/planning.read} === true }">
						<headerToolbar><OverflowToolbar style="Clear"><core:Icon src="sap-icon://appointment-2"/><Title text="Einsätze heute" level="H2"/>
							<ToolbarSpacer/><Link text="Wer fährt wohin" href="/planung/wer-faehrt-wohin"/><Link text="Tagesansicht" href="/planung?ansicht=tag"/></OverflowToolbar></headerToolbar>
						<Table items="{path: 'view>/assignments', sorter: {path: 'crewLabel', group: true}}" noDataText="Heute ist nichts eingeplant." class="eoDenseTable" popinLayout="GridSmall">
							<columns>
								<Column width="5.5rem"><Text text="Zeit"/></Column>
								<Column><Text text="Baustelle"/></Column>
								<Column minScreenWidth="Tablet" demandPopin="true"><Text text="Tätigkeit"/></Column>
								<Column minScreenWidth="Desktop" demandPopin="true"><Text text="Team und Geräte"/></Column>
							</columns>
							<items>
								<ColumnListItem type="Navigation" press=".onAssignment" highlight="{= ${view>warnings}.length ? 'Warning' : 'None' }">
									<Text text="{view>timeText}" class="eoTabular"/>
									<VBox><Text text="{view>bauakteNumber} {view>bauakteTitle}" class="eoStrong"/><Text text="{view>bauakteAddress}" class="eoMuted" visible="{= !!${view>bauakteAddress} }"/></VBox>
									<VBox><Text text="{view>activity}"/><Text text="{view>warningText}" class="eoWarnText" visible="{= !!${view>warningText} }"/></VBox>
									<Text text="{view>peopleText}"/>
								</ColumnListItem>
							</items>
						</Table>
					</Panel>
					<Panel backgroundDesign="Solid" class="eoTodayPanel" visible="{= ${session>/permissions/contacts.read} === true }">
						<headerToolbar><OverflowToolbar style="Clear"><core:Icon src="sap-icon://call"/><Title text="Wiedervorlagen fällig" level="H2"/>
							<ToolbarSpacer/><Link text="Anrufe" href="/anrufe"/></OverflowToolbar></headerToolbar>
						<List items="{view>/due}" noDataText="Keine fälligen Wiedervorlagen." showSeparators="Inner">
							<CustomListItem>
								<HBox justifyContent="SpaceBetween" alignItems="Center" class="eoTodayRow">
									<VBox><Text text="{view>who}"/><Text text="{= ${view>subject} || ${view>notes} || '–' }" class="eoMuted"/></VBox>
									<Button text="Erledigt" icon="sap-icon://accept" type="Transparent" press=".onDone" visible="{= ${session>/permissions/contacts.edit} === true }"/>
								</HBox>
							</CustomListItem>
						</List>
					</Panel>
					<Panel backgroundDesign="Solid" class="eoTodayPanel" visible="{= ${session>/permissions/bauakten.read} === true }">
						<headerToolbar><OverflowToolbar style="Clear"><core:Icon src="sap-icon://approvals"/><Title text="Freigaben für mich" level="H2"/>
							<ToolbarSpacer/><Link text="Alle" href="/dokumente?reiter=freigaben"/></OverflowToolbar></headerToolbar>
						<List items="{view>/approvals}" noDataText="Keine Freigaben offen." showSeparators="Inner">
							<StandardListItem title="{view>fileName}" description="{= (${view>bauakteNumber} || '') + ' ' + ${view>bauakteTitle} + ' · von ' + ${view>requestedByName} }"
								type="Navigation" press=".onApproval"/>
						</List>
					</Panel>
					<Panel backgroundDesign="Solid" class="eoTodayPanel" visible="{= ${session>/permissions/work.read} === true }">
						<headerToolbar><OverflowToolbar style="Clear"><core:Icon src="sap-icon://task"/><Title text="Meine Aufgaben und Mängel" level="H2"/></OverflowToolbar></headerToolbar>
						<List items="{view>/work}" noDataText="Keine offenen Aufgaben." showSeparators="Inner">
							<StandardListItem title="{view>title}" icon="{= ${view>kind} === 'defect' ? 'sap-icon://alert' : 'sap-icon://task' }"
								info="{path: 'view>dueDate', formatter: 'fmt.date'}" infoState="{path: 'view>dueDate', formatter: 'fmt.overdueState'}" type="Navigation" press=".onWork"/>
						</List>
					</Panel>
					<Panel backgroundDesign="Solid" class="eoTodayPanel" visible="{= ${session>/permissions/helpdesk.agent} === true }">
						<headerToolbar><OverflowToolbar style="Clear"><core:Icon src="sap-icon://headset"/><Title text="Neue Tickets" level="H2"/>
							<ToolbarSpacer/><Link text="Helpdesk" href="/it-center/helpdesk"/></OverflowToolbar></headerToolbar>
						<List items="{view>/tickets}" noDataText="Keine neuen Tickets." showSeparators="Inner">
							<StandardListItem title="{view>title}" description="{view>number} · {= ${view>reporterDisplayName} || '–' }" type="Navigation" press=".onTicket"
								info="{= ${view>reporterBlocked} ? 'kann nicht arbeiten' : '' }" infoState="Error"/>
						</List>
					</Panel>
					<Panel backgroundDesign="Solid" class="eoTodayPanel" visible="{= ${view>/absences}.length > 0 }">
						<headerToolbar><OverflowToolbar style="Clear"><core:Icon src="sap-icon://general-leave-request"/><Title text="Heute abwesend" level="H2"/></OverflowToolbar></headerToolbar>
						<List items="{view>/absences}" showSeparators="Inner">
							<StandardListItem title="{view>userName}" info="{path: 'view>kind', formatter: 'fmt.absenceText'}" infoState="Warning"/>
						</List>
					</Panel>
					<Panel backgroundDesign="Solid" class="eoTodayPanel" visible="{= ${session>/permissions/materials.read} === true &amp;&amp; ${view>/deliveries}.length > 0 }">
						<headerToolbar><OverflowToolbar style="Clear"><core:Icon src="sap-icon://shipping-status"/><Title text="Lieferungen heute" level="H2"/>
							<ToolbarSpacer/><Link text="Bestellungen" href="/bestellungen"/></OverflowToolbar></headerToolbar>
						<List items="{view>/deliveries}" showSeparators="Inner">
							<StandardListItem title="{view>supplierName}{= ${view>deliveryTime} ? ' · ' + ${view>deliveryTime} : '' }" description="{view>linesText}"
								info="{path: 'view>status', formatter: 'fmt.orderStatusText'}" type="Navigation" press=".onOrder"/>
						</List>
					</Panel>
					<Panel backgroundDesign="Solid" class="eoTodayPanel" visible="{= ${session>/permissions/contacts.read} === true }">
						<headerToolbar><OverflowToolbar style="Clear"><core:Icon src="sap-icon://inbox"/><Title text="Offene Anfragen" level="H2"/>
							<ToolbarSpacer/><Link text="Anfragen" href="/anfragen"/></OverflowToolbar></headerToolbar>
						<List items="{view>/inquiries}" noDataText="Keine offenen Anfragen." showSeparators="Inner">
							<StandardListItem title="{view>who}" description="{= ${view>subject} || '–' }" info="{path: 'view>inquiryStatus', formatter: 'fmt.inquiryStatusText'}"/>
						</List>
					</Panel>
					<Panel backgroundDesign="Solid" class="eoTodayPanel">
						<headerToolbar><OverflowToolbar style="Clear"><core:Icon src="sap-icon://folder-full"/><Title text="Zuletzt geänderte Bauakten" level="H2"/></OverflowToolbar></headerToolbar>
						<List items="{view>/recent}" noDataText="Noch keine Bauakten." showSeparators="Inner">
							<StandardListItem title="{view>number} {view>title}" description="{path: 'view>updatedAt', formatter: 'fmt.dateTime'}" type="Navigation" press=".onBauakte"
								info="{path: 'view>status', formatter: 'fmt.bauakteStatusText'}" infoState="{path: 'view>status', formatter: 'fmt.bauakteStatusState'}"/>
						</List>
					</Panel>
				</grid:CSSGrid>
				<!-- System-Status als schmale Zeile -->
				<FlexBox items="{view>/system}" wrap="Wrap" alignItems="Center" class="eoSystemRow" visible="{= ${view>/system}.length > 0 }">
					<HBox alignItems="Center" class="eoSystemItem">
						<ObjectStatus text="{view>label}: {view>text}" state="{view>state}" icon="{view>icon}"/>
						<Text text="{view>detail}" class="eoMuted" visible="{= !!${view>detail} }"/>
						<Link text="Öffnen" href="{view>to}"/>
					</HBox>
				</FlexBox>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
