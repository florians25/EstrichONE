<mvc:View controllerName="estrichone.controller.office.Quotation" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:form="sap.ui.layout.form"
	xmlns:core="sap.ui.core" height="100%">
	<f:DynamicPage id="page" toggleHeaderOnTitleClick="false" busy="{view>/busy}" showFooter="{= ${view>/q/editable} === true }">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<HBox alignItems="Center" renderType="Bare">
						<Title id="quotationTitle" text="{= ${view>/q/title} || 'Angebot' }" level="H1" wrapping="true"/>
						<ObjectStatus id="quotationBeta" text="Beta" state="Information" inverted="true" class="sapUiSmallMarginBegin"/>
					</HBox>
				</f:heading>
				<f:expandedContent>
					<HBox alignItems="Center" renderType="Bare" wrap="Wrap">
						<ObjectStatus id="quotationState" text="{view>/stateText}" state="{view>/stateState}" class="sapUiSmallMarginEnd"/>
						<Text text="{view>/subtitle}"/>
					</HBox>
				</f:expandedContent>
				<f:actions>
					<Button id="quotationOpenLexware" text="In Lexware öffnen" icon="sap-icon://action" press=".onOpenLexware" visible="{= !!${view>/q/lexwareUrl} }"/>
					<Button id="quotationToBauakte" text="Zur Bauakte" icon="sap-icon://folder-full" press=".onBauakte" visible="{= !!${view>/q/bauakteId} }"/>
				</f:actions>
			</f:DynamicPageTitle>
		</f:title>
		<f:content>
			<VBox renderType="Bare" class="sapUiSmallMargin">
				<MessageStrip id="quotationBetaHint" type="Information" showIcon="true" text="{view>/betaText}" class="sapUiSmallMarginBottom"/>
				<MessageStrip id="quotationSent" type="Success" showIcon="true" visible="{= ${view>/q/state} === 'sent' }" class="sapUiSmallMarginBottom"
					text="{= 'Als Entwurf an Lexware Office gesendet am ' + ${view>/sentText} + '. Ab jetzt gilt der Beleg in Lexware Office; Änderungen, Nummer, Festschreiben und Versand dort. Der Beleg steht in der Bauakte unter „Rechnungen und Angebote“.' }">
					<link><Link text="In Lexware öffnen" press=".onOpenLexware"/></link>
				</MessageStrip>
				<VBox id="quotationFailedBox" renderType="Bare" visible="{= ${view>/q/state} === 'failed' }" class="sapUiSmallMarginBottom">
					<MessageStrip id="quotationFailed" type="Error" showIcon="true"
						text="{= 'Das Senden an Lexware Office ist fehlgeschlagen. ' + (${view>/q/sendError} || '') + ' Sie können den Entwurf bearbeiten und erneut senden; ein bereits angelegtes Angebot wird dabei erkannt und nicht doppelt angelegt.' }"/>
					<HBox renderType="Bare" wrap="Wrap" alignItems="Center" class="sapUiTinyMarginTop">
						<Button id="quotationFix" text="{view>/fixText}" type="Emphasized" icon="sap-icon://paper-plane" press=".onFix" visible="{= !!${view>/fixText} }"
							class="sapUiSmallMarginEnd"/>
					</HBox>
					<Panel id="quotationTechnical" headerText="Technische Einzelheiten" expandable="true" expanded="false" visible="{= !!${view>/q/sendErrorTechnical} }"
						class="sapUiNoContentPadding">
						<Text text="{view>/q/sendErrorTechnical}" class="sapUiTinyMargin"/>
					</Panel>
				</VBox>
				<MessageStrip id="quotationNotLinked" type="Warning" showIcon="true" visible="{= ${view>/q/customerLinked} === false }" class="sapUiSmallMarginBottom"
					text="Der Kunde ist noch nicht mit Lexware Office verknüpft. Verknüpfen Sie ihn am Kunden im Abschnitt „Lexware Office“, danach lässt sich das Angebot senden.">
					<link><Link text="Zum Kunden" press=".onCustomer"/></link>
				</MessageStrip>
				<MessageStrip id="quotationPayError" type="Warning" showIcon="true" visible="{= !!${view>/options/paymentConditionsError} &amp;&amp; ${view>/q/editable} === true }"
					text="{view>/options/paymentConditionsError}" class="sapUiSmallMarginBottom"/>

				<form:SimpleForm id="quotationHead" editable="{view>/q/editable}" layout="ColumnLayout" columnsM="1" columnsL="2" columnsXL="2" title="Kopf">
					<Label text="Kunde"/>
					<Link id="quotationCustomer" text="{view>/q/customerName}" press=".onCustomer"/>
					<Label text="Bauakte"/>
					<Text text="{= ${view>/q/bauakteId} ? ((${view>/q/bauakteNumber} || '') + ' ' + (${view>/q/bauakteTitle} || '')) : 'keine (Angebot zum Kunden)' }"/>
					<Label text="Nummer"/>
					<Text text="wird automatisch vergeben"/>
					<Label text="Titel" required="true" labelFor="qTitle"/>
					<Input id="qTitle" value="{view>/q/title}" maxLength="200" editable="{view>/q/editable}" liveChange=".onDirty"/>
					<Label text="Gültig bis" required="true" labelFor="qValid"/>
					<DatePicker id="qValid" value="{view>/q/validUntil}" valueFormat="yyyy-MM-dd" displayFormat="dd.MM.yyyy" editable="{view>/q/editable}" change=".onDirty"/>
					<Label text="Steuerart" labelFor="qTax"/>
					<Select id="qTax" selectedKey="{view>/q/taxType}" items="{view>/taxTypes}" enabled="{view>/q/editable}" change=".onTotals" width="100%">
						<core:Item key="{view>key}" text="{view>text}" enabled="{view>allowed}"/>
					</Select>
					<Text id="qTaxHint" text="{view>/taxHint}" visible="{= !!${view>/taxHint} &amp;&amp; ${view>/q/editable} === true }" class="eoHelpText"/>
					<Label text="Zahlungsbedingung" labelFor="qPayment"/>
					<Select id="qPayment" selectedKey="{view>/q/paymentConditionId}" items="{view>/payments}" enabled="{view>/q/editable}" change=".onPayment" width="100%"
						forceSelection="false">
						<core:Item key="{view>key}" text="{view>text}"/>
					</Select>
					<Label text="Text der Zahlungsbedingung" labelFor="qPaymentLabel"/>
					<Input id="qPaymentLabel" value="{view>/q/paymentLabel}" maxLength="300" editable="{view>/q/editable}" liveChange=".onDirty"
						placeholder="z. B. Zahlbar innerhalb von 14 Tagen ohne Abzug."/>
					<Label text="Einleitung" labelFor="qIntro"/>
					<TextArea id="qIntro" value="{view>/q/introduction}" rows="3" growing="true" maxLength="4000" editable="{view>/q/editable}" liveChange=".onDirty" width="100%"/>
					<Label text="Bemerkung" labelFor="qRemark"/>
					<TextArea id="qRemark" value="{view>/q/remark}" rows="2" growing="true" maxLength="4000" editable="{view>/q/editable}" liveChange=".onDirty" width="100%"
						placeholder="Schlusstext, z. B. Wir freuen uns auf Ihren Auftrag."/>
				</form:SimpleForm>

				<Table id="quotationLines" items="{view>/lines}" class="sapUiSmallMarginTop" popinLayout="GridSmall" contextualWidth="Auto"
					noDataText="Noch keine Positionen. Wählen Sie Artikel und Leistungen aus, übernehmen Sie Vorschläge aus der Bauakte oder legen Sie eine freie Position an.">
					<headerToolbar>
						<OverflowToolbar>
							<Title text="Positionen" level="H2"/>
							<ToolbarSpacer/>
							<Button id="qSuggest" text="Vorschläge aus der Bauakte" icon="sap-icon://lightbulb" press=".onSuggest" visible="{= ${view>/q/editable} === true &amp;&amp; !!${view>/q/bauakteId} }"/>
							<Button id="qCatalog" text="Aus Artikeln und Leistungen" icon="sap-icon://tag" press=".onCatalog" visible="{view>/q/editable}"/>
							<Button id="qFree" text="Freie Position" icon="sap-icon://add" press=".onAddFree" visible="{view>/q/editable}"/>
							<Button id="qText" text="Textposition" icon="sap-icon://text" press=".onAddText" visible="{view>/q/editable}"/>
						</OverflowToolbar>
					</headerToolbar>
					<columns>
						<Column width="3rem"><Text text="Pos."/></Column>
						<Column><Text text="Bezeichnung und Beschreibung"/></Column>
						<Column width="6rem" hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Menge"/></Column>
						<Column width="5.5rem" minScreenWidth="Tablet" demandPopin="true"><Text text="Einheit"/></Column>
						<Column width="7rem" hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Einzelpreis netto"/></Column>
						<Column width="6.5rem" minScreenWidth="Desktop" demandPopin="true"><Text text="Steuersatz"/></Column>
						<Column width="5rem" hAlign="End" minScreenWidth="Desktop" demandPopin="true"><Text text="Rabatt %"/></Column>
						<Column width="7rem" hAlign="End"><Text text="Betrag netto"/></Column>
						<Column width="6.5rem" hAlign="End" visible="{view>/q/editable}"/>
					</columns>
					<items>
						<ColumnListItem>
							<Text text="{view>pos}" class="eoTabular"/>
							<VBox renderType="Bare">
								<Input value="{view>name}" maxLength="255" editable="{view>/q/editable}" liveChange=".onDirty" placeholder="{= ${view>kind} === 'text' ? 'Überschrift der Textposition' : 'Bezeichnung' }"/>
								<TextArea value="{view>description}" rows="1" growing="true" maxLength="2000" editable="{view>/q/editable}" liveChange=".onDirty" width="100%"
									placeholder="Beschreibung (optional)"/>
								<Text text="{view>sourceText}" class="eoMuted" visible="{= !!${view>sourceText} }"/>
							</VBox>
							<Input value="{view>quantityText}" textAlign="End" visible="{= ${view>kind} === 'item' }" editable="{view>/q/editable}" liveChange=".onTotals"/>
							<Input value="{view>unit}" maxLength="50" visible="{= ${view>kind} === 'item' }" editable="{view>/q/editable}" liveChange=".onDirty"/>
							<Input value="{view>priceText}" textAlign="End" visible="{= ${view>kind} === 'item' }" editable="{view>/q/editable}" liveChange=".onTotals"/>
							<Select selectedKey="{view>taxKey}" visible="{= ${view>kind} === 'item' }" enabled="{= ${view>/q/editable} === true &amp;&amp; ${view>/q/taxType} !== 'constructionService13b' &amp;&amp; ${view>/q/taxType} !== 'vatfree' }"
								change=".onTotals" width="100%">
								<core:Item key="19" text="19 %"/>
								<core:Item key="7" text="7 %"/>
								<core:Item key="0" text="0 %"/>
							</Select>
							<Input value="{view>discountText}" textAlign="End" visible="{= ${view>kind} === 'item' }" editable="{view>/q/editable}" liveChange=".onTotals" placeholder="0"/>
							<Text text="{view>netText}" class="eoTabular eoStrong"/>
							<HBox justifyContent="End" renderType="Bare">
								<Button icon="sap-icon://navigation-up-arrow" type="Transparent" tooltip="Nach oben" press=".onUp"/>
								<Button icon="sap-icon://navigation-down-arrow" type="Transparent" tooltip="Nach unten" press=".onDown"/>
								<Button icon="sap-icon://delete" type="Transparent" tooltip="Position entfernen" press=".onRemove"/>
							</HBox>
						</ColumnListItem>
					</items>
				</Table>

				<HBox justifyContent="End" class="sapUiSmallMarginTop" renderType="Bare">
					<VBox id="quotationTotals" width="26rem" renderType="Bare" class="eoQuotationTotals">
						<HBox justifyContent="SpaceBetween" renderType="Bare"><Label text="Summe netto"/><Text id="qNet" text="{view>/totals/netText}" class="eoTabular"/></HBox>
						<HBox justifyContent="SpaceBetween" renderType="Bare" class="sapUiTinyMarginTop"><Label text="{view>/totals/taxLabel}" wrapping="true"/><Text id="qTaxSum" text="{view>/totals/taxText}" class="eoTabular"/></HBox>
						<HBox justifyContent="SpaceBetween" renderType="Bare" class="sapUiTinyMarginTop"><Label text="Summe brutto" design="Bold"/><Text id="qGross" text="{view>/totals/grossText}" class="eoTabular eoStrong"/></HBox>
					</VBox>
				</HBox>
				<Text text="Die Summen sind eine Vorschau. Maßgeblich rechnet Lexware Office; Rundungen können dort um einzelne Cent abweichen." class="eoHelpText"/>
				<MessageStrip id="quotationProblems" type="Warning" showIcon="true" visible="{= ${view>/problemsText}.length > 0 &amp;&amp; ${view>/q/editable} === true }"
					text="{view>/problemsText}" class="sapUiSmallMarginTop"/>
			</VBox>
		</f:content>
		<f:footer>
			<OverflowToolbar>
				<Button id="quotationDiscard" text="Entwurf verwerfen" type="Transparent" icon="sap-icon://delete" press=".onDiscard"/>
				<ToolbarSpacer/>
				<Button id="quotationSave" text="Speichern" press=".onSave" enabled="{view>/dirty}"/>
				<Button id="quotationSend" text="Als Entwurf an Lexware Office senden" type="Emphasized" icon="sap-icon://paper-plane" press=".onSend"
					enabled="{= ${view>/q/customerLinked} === true &amp;&amp; !${view>/sending} }"/>
			</OverflowToolbar>
		</f:footer>
	</f:DynamicPage>
</mvc:View>
