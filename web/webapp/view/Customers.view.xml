<mvc:View controllerName="estrichone.controller.Customers" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:core="sap.ui.core"
	xmlns:u="sap.ui.unified" height="100%">
	<f:DynamicPage id="page" toggleHeaderOnTitleClick="false">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading><Title text="{i18n>nav.customers}" level="H1"/></f:heading>
				<f:expandedContent><Text text="Kundenstamm für Bauakten und Anfragen"/></f:expandedContent>
				<f:actions>
					<u:FileUploader id="importFile" buttonOnly="true" buttonText="CSV importieren" icon="sap-icon://upload" fileType="csv,txt"
						change=".onImport" visible="{= ${session>/permissions/contacts.edit} === true }" sameFilenameAllowed="true" style="Transparent"/>
					<Button text="Neuer Kunde" icon="sap-icon://add-employee" type="Emphasized" press=".onNew" visible="{= ${session>/permissions/contacts.edit} === true }"/>
				</f:actions>
			</f:DynamicPageTitle>
		</f:title>
		<f:content>
			<Table items="{view>/items}" busy="{view>/busy}" sticky="HeaderToolbar,ColumnHeaders" noDataText="Keine Kunden gefunden." popinLayout="GridSmall"
				growing="true" growingThreshold="100">
				<headerToolbar>
					<OverflowToolbar>
						<Title text="{= ${view>/items}.length } Kunden" level="H2"/>
						<ToolbarSpacer/>
						<SegmentedButton selectedKey="{view>/kind}" selectionChange=".onFilter">
							<items>
								<SegmentedButtonItem key="" text="Alle"/>
								<SegmentedButtonItem key="company" text="Firmen"/>
								<SegmentedButtonItem key="person" text="Privat"/>
							</items>
						</SegmentedButton>
						<Select selectedKey="{view>/sort}" change=".onFilter" tooltip="Sortierung" width="11rem">
							<core:Item key="name" text="Nach Name"/><core:Item key="number" text="Nach Kundennummer"/>
							<core:Item key="city" text="Nach Ort"/><core:Item key="recent" text="Zuletzt geändert"/>
						</Select>
						<SearchField width="22rem" placeholder="Name, Nummer, Ort, Telefon, E-Mail, Ansprechpartner" search=".onSearch" value="{view>/search}"/>
					</OverflowToolbar>
				</headerToolbar>
				<columns>
					<Column width="8rem"><Text text="Kd.-Nr."/></Column>
					<Column><Text text="Name"/></Column>
					<Column width="6rem" minScreenWidth="Tablet" demandPopin="true"><Text text="Art"/></Column>
					<Column minScreenWidth="Tablet" demandPopin="true"><Text text="Ort"/></Column>
					<Column minScreenWidth="Tablet" demandPopin="true"><Text text="Telefon"/></Column>
					<Column minScreenWidth="Desktop" demandPopin="true"><Text text="E-Mail"/></Column>
					<Column width="9rem" hAlign="End"><Text text=""/></Column>
				</columns>
				<items>
					<ColumnListItem type="Navigation" press=".onOpen">
						<FormattedText htmlText="{view>numberHtml}" class="eoTabular"/>
						<VBox>
							<FormattedText htmlText="{view>nameHtml}" class="eoStrong"/>
							<Text text="{view>sub}" class="eoMuted" visible="{= !!${view>sub} }"/>
						</VBox>
						<Text text="{= ${view>kind} === 'company' ? 'Firma' : 'Privat' }"/>
						<FormattedText htmlText="{view>placeHtml}"/>
						<FormattedText htmlText="{view>phonesHtml}"/>
						<FormattedText htmlText="{view>emailsHtml}"/>
						<HBox justifyContent="End">
							<Button icon="sap-icon://edit" type="Transparent" tooltip="{= 'Bearbeiten: ' + ${view>name} }" press=".onEdit" visible="{= ${session>/permissions/contacts.edit} === true }"/>
							<Link text="Bauakten" href="/bauakten?kunde={view>id}" class="sapUiTinyMarginBegin"/>
						</HBox>
					</ColumnListItem>
				</items>
			</Table>
		</f:content>
	</f:DynamicPage>
</mvc:View>
