<mvc:View controllerName="estrichone.controller.bauakte.sections.Contacts" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f"
	xmlns:card="sap.f.cards" xmlns:grid="sap.ui.layout.cssgrid" xmlns:core="sap.ui.core">
	<VBox>
		<FlexBox wrap="Wrap" justifyContent="SpaceBetween" alignItems="Center" class="eoEntryRow">
			<Title text="Kontakte und Beteiligte ({= ${ct>/cards}.length })" level="H3"/>
			<FlexBox wrap="Wrap" alignItems="Center" class="eoEntryRow eoNoShrink" visible="{akte>/canEdit}">
				<Button text="Kontakt erfassen" icon="sap-icon://add-contact" type="Emphasized" press=".onQuickAdd"/>
				<Button text="Aus Kundenstamm übernehmen" icon="sap-icon://customer" press=".onFromContacts" visible="{= ${session>/permissions/contacts.read} === true }"/>
			</FlexBox>
		</FlexBox>
		<grid:CSSGrid items="{ct>/cards}" gridTemplateColumns="repeat(auto-fill, minmax(19rem, 1fr))" gridGap="1rem" class="eoContactGrid sapUiSmallMarginTop">
			<f:Card>
				<f:header>
					<card:Header title="{ct>name}" subtitle="{ct>company}" iconSrc="{ct>icon}" iconDisplayShape="Circle"/>
				</f:header>
				<f:content>
					<VBox width="100%" class="sapUiSmallMarginBeginEnd sapUiSmallMarginBottom">
						<ObjectStatus text="{ct>roleText}" state="{ct>roleState}" inverted="true" class="sapUiTinyMarginBottom"/>
						<Text text="{ct>address}" visible="{= !!${ct>address} }" wrapping="true"/>
						<Text text="{ct>note}" visible="{= !!${ct>note} }" wrapping="true" class="eoPre eoMuted sapUiTinyMarginTop"/>
						<FlexBox wrap="Wrap" alignItems="Center" class="eoEntryRow sapUiSmallMarginTop">
							<Button icon="sap-icon://call" text="{ct>phone}" visible="{= !!${ct>phone} }" press=".onCall" tooltip="Anrufen"/>
							<Button icon="sap-icon://email" text="E-Mail" visible="{= !!${ct>email} }" press=".onMail" tooltip="{ct>email}"/>
							<Button icon="sap-icon://edit" type="Transparent" tooltip="Bearbeiten" press=".onEditCard" visible="{= ${ct>editable} &amp;&amp; ${akte>/canEdit} }"/>
							<Button icon="sap-icon://delete" type="Transparent" tooltip="Entfernen" press=".onRemoveCard" visible="{= ${ct>removable} &amp;&amp; ${akte>/canEdit} }"/>
						</FlexBox>
					</VBox>
				</f:content>
			</f:Card>
		</grid:CSSGrid>
		<Title text="Team" level="H3" class="sapUiMediumMarginTop sapUiTinyMarginBottom"/>
		<FlexBox wrap="Wrap" alignItems="Center" class="eoEntryRow" items="{ct>/team}">
			<HBox alignItems="Center" class="eoTeamChip">
				<Avatar initials="{ct>initials}" displaySize="XS" class="sapUiTinyMarginEnd"/>
				<VBox>
					<Text text="{ct>displayName}"/>
					<Text text="{ct>roleText}" class="eoMuted"/>
				</VBox>
			</HBox>
		</FlexBox>
		<Button text="{i18n>contacts.assign}" icon="sap-icon://add-employee" press=".onAssign" visible="{akte>/canEdit}" class="sapUiTinyMarginTop"/>
	</VBox>
</mvc:View>
