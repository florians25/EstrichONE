<mvc:View controllerName="estrichone.controller.bauakte.sections.Documentation" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m"
	xmlns:f="sap.f" xmlns:card="sap.f.cards" xmlns:form="sap.ui.layout.form" xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout" xmlns:grid="sap.ui.layout.cssgrid" xmlns:eo="estrichone.control"
	core:require="{fmt: 'estrichone/model/formatter'}">
	<IconTabBar id="docuTabs" selectedKey="{dc>/tab}" expandable="false" headerMode="Inline" stretchContentHeight="false" applyContentPadding="false"
		backgroundDesign="Transparent">
		<items>
			<!-- Bautagebuch -->
			<IconTabFilter key="tagebuch" text="{i18n>diary.title}" icon="sap-icon://notes" count="{dc>/diaryCount}" visible="{= ${session>/modules/diary} !== false }">
				<OverflowToolbar style="Clear">
					<Title text="{i18n>diary.chronicle}" level="H3"/>
					<ToolbarSpacer/>
					<SearchField width="14rem" placeholder="{i18n>diary.search}" value="{dc>/diaryQuery}" liveChange=".refreshDiary"/>
					<Button text="{i18n>diary.add}" icon="sap-icon://add" type="Emphasized" press=".onAddDiary" visible="{= ${session>/permissions/diary.write} === true }"/>
				</OverflowToolbar>
				<List id="diaryList" items="{dc>/diaryShown}" noDataText="{i18n>diary.none}" showSeparators="All" growing="true" growingThreshold="50">
					<CustomListItem>
						<VBox class="sapUiSmallMargin">
							<HBox alignItems="Center" wrap="Wrap" justifyContent="SpaceBetween">
								<HBox alignItems="Center" wrap="Wrap">
									<core:Icon src="sap-icon://calendar" class="sapUiTinyMarginEnd"/>
									<Title text="{path: 'dc>day', formatter: 'fmt.longDay'}" level="H4" class="sapUiSmallMarginEnd"/>
									<ObjectStatus text="{dc>weatherText}" icon="sap-icon://weather-proofing" visible="{= !!${dc>weatherText} }" class="sapUiSmallMarginEnd"/>
									<ObjectStatus text="{dc>timeText}" icon="sap-icon://time-entry-request" visible="{= !!${dc>timeText} }" class="sapUiSmallMarginEnd"/>
									<ObjectStatus text="{dc>crew}" icon="sap-icon://group" visible="{= !!${dc>crew} }"/>
								</HBox>
								<HBox visible="{dc>own}">
									<Button icon="sap-icon://edit" type="Transparent" tooltip="{i18n>common.edit}" press=".onEditDiary"/>
									<Button icon="sap-icon://delete" type="Transparent" tooltip="{i18n>common.delete}" press=".onDeleteDiary"/>
								</HBox>
							</HBox>
							<Text text="{dc>text}" class="eoPre sapUiTinyMarginTop"/>
							<HBox items="{path: 'dc>photos', templateShareable: false}" wrap="Wrap" renderType="Bare" class="sapUiTinyMarginTop eoMediaGrid" visible="{= ${dc>photos}.length > 0 }">
								<eo:MediaThumb src="{dc>thumb}" kind="{dc>kind}" alt="{dc>alt}" press=".onDiaryPhoto"/>
							</HBox>
							<Text text="{dc>meta}" class="eoMuted sapUiTinyMarginTop"/>
						</VBox>
					</CustomListItem>
				</List>
			</IconTabFilter>
			<!-- Erstbegehung: Status, Termin, Protokolle, Fotos und Dokumente -->
			<IconTabFilter id="erstbegehungTab" key="erstbegehung" text="Erstbegehung" icon="sap-icon://inspection" count="{dc>/initialCount}"
				visible="{= ${session>/modules/inspections} !== false }">
				<OverflowToolbar style="Clear" class="eoDocBar">
					<Title text="Erstbegehung" level="H3"/>
					<ObjectStatus id="initialStatus" text="{dc>/ib/statusText}" state="{dc>/ib/statusState}" icon="{dc>/ib/statusIcon}" inverted="true"/>
					<ToolbarSpacer/>
					<Button id="planInitialButton" text="{= ${dc>/ib/appointment} ? 'Termin ändern' : 'Termin planen' }" icon="sap-icon://appointment-2" press=".onPlanInitial"
						visible="{= ${dc>/ib/canPlan} &amp;&amp; (${dc>/ib/status} === 'open' || ${dc>/ib/status} === 'planned') }"/>
					<Button id="waiveInitialButton" text="Nicht erforderlich" icon="sap-icon://decline" press=".onWaiveInitial" tooltip="{i18n>inspections.waive}"
						visible="{= (${dc>/ib/status} === 'open' || ${dc>/ib/status} === 'planned') &amp;&amp; ${session>/permissions/bauakten.edit} === true }"/>
					<Button id="undoWaiverButton" text="Vermerk aufheben" icon="sap-icon://undo" press=".onUndoWaiver"
						visible="{= ${dc>/ib/status} === 'waived' &amp;&amp; ${session>/permissions/bauakten.edit} === true }"/>
					<Button id="initialPdfButton" text="Protokoll (PDF)" icon="sap-icon://pdf-attachment" press=".onInitialPdf" visible="{= ${dc>/ib/status} === 'done' }"/>
					<Button id="correctInitialButton" text="{i18n>inspections.correct}" icon="sap-icon://edit" press=".onCorrectInitial"
						visible="{= ${dc>/ib/status} === 'done' &amp;&amp; ${session>/permissions/inspections.write} === true }"/>
					<Button id="startInitialButton" text="Erstbegehung durchführen" icon="sap-icon://inspection" type="Emphasized" press=".onAddInitial"
						visible="{= (${dc>/ib/status} === 'open' || ${dc>/ib/status} === 'planned') &amp;&amp; ${session>/permissions/inspections.write} === true }"/>
				</OverflowToolbar>
				<!-- Eckdaten in einer Zeile: Status, Termin, durchgeführt, Ergebnis -->
				<grid:CSSGrid gridTemplateColumns="repeat(auto-fit, minmax(min(100%, 11rem), 1fr))" gridGap="0.5rem 1.5rem" class="eoFacts">
					<VBox renderType="Bare" class="eoFact">
						<Label text="Termin"/>
						<Text id="initialAppointment" text="{= ${dc>/ib/appointmentText} || 'nicht geplant' }" wrapping="true"/>
					</VBox>
					<VBox renderType="Bare" class="eoFact">
						<Label text="Durchgeführt"/>
						<Text text="{= ${dc>/latest} ? ${dc>/ib/doneText} : '–' }" wrapping="true"/>
					</VBox>
					<VBox renderType="Bare" class="eoFact">
						<Label text="Ergebnis"/>
						<ObjectStatus text="{dc>/latestResult/text}" state="{dc>/latestResult/tone}" visible="{= !!${dc>/latest} }"/>
						<Text text="–" visible="{= !${dc>/latest} }"/>
					</VBox>
					<VBox renderType="Bare" class="eoFact">
						<Label text="Protokolle"/>
						<Text text="{= ${dc>/initial}.length === 0 ? 'keine' : ${dc>/initial}.length === 1 ? '1 Protokoll' : ${dc>/initial}.length + ' Protokolle' }"/>
					</VBox>
				</grid:CSSGrid>
				<MessageStrip id="waiverStatus" text="{dc>/waiverText}" type="Information" showIcon="true" visible="{= ${dc>/ib/status} === 'waived' }" class="eoDocStrip"/>
				<HBox id="initialEmpty" alignItems="Center" class="eoEmptyRow" visible="{= ${dc>/ib/status} === 'open' || ${dc>/ib/status} === 'planned' }">
					<core:Icon src="sap-icon://inspection" class="eoEmptyRowIcon" decorative="true"/>
					<Text text="{= ${dc>/ib/status} === 'planned' ? 'Termin steht. Die Erstbegehung wird vor Ort in der App oder hier durchgeführt; das Protokoll erscheint danach hier.' : 'Noch keine Erstbegehung. Termin planen oder direkt durchführen – vor Ort in der App oder hier.' }"
						wrapping="true" class="eoEmptyRowText"/>
				</HBox>

				<f:Card id="initialProtocolCard" class="eoDocCard" visible="{= !!${dc>/latest} }">
					<f:header>
						<card:Header title="{i18n>inspections.initialProtocol}" subtitle="{dc>/latestText}" iconSrc="sap-icon://inspection"/>
					</f:header>
					<f:content>
						<VBox width="100%">
							<form:SimpleForm editable="false" layout="ResponsiveGridLayout" columnsXL="2" columnsL="2" columnsM="1"
								labelSpanXL="5" labelSpanL="5" labelSpanM="5">
								<core:Title text="{i18n>inspections.essentials}"/>
								<Label text="Ergebnis"/><ObjectStatus text="{dc>/latestResult/text}" state="{dc>/latestResult/tone}" inverted="true"/>
								<Label text="Status"/><Text text="{= ${dc>/latest/correctsInspectionId} ? 'Korrigiert' : 'Abgeschlossen' }"/>
								<Label text="Prüfer"/><Text text="{path: 'dc>/latest/performedByUserId', formatter: 'fmt.person'}"/>
								<Label text="Datum"/><Text text="{path: 'dc>/latest/performedAt', formatter: 'fmt.dateTime'}"/>
								<core:Title text="{i18n>inspections.substrate}"/>
								<Label text="Estrichart"/><Text text="{= ${dc>/screeds} || '–' }"/>
								<Label text="Fläche"/><Text text="{dc>/areaText}"/>
								<Label text="Fußbodenheizung"/><Text text="{dc>/heatingText}"/>
							</form:SimpleForm>
							<Table items="{dc>/checks}" visible="{= ${dc>/checks}.length > 0 }" class="eoCheckTable">
								<columns>
									<Column><Text text="{i18n>inspections.checkPoint}"/></Column>
									<Column width="12rem"><Text text="{i18n>inspections.result}"/></Column>
								</columns>
								<items>
									<ColumnListItem>
										<Text text="{dc>title}"/>
										<ObjectStatus text="{path: 'dc>result', formatter: 'fmt.checkText'}" state="{path: 'dc>result', formatter: 'fmt.checkState'}"/>
									</ColumnListItem>
								</items>
							</Table>
							<VBox class="sapUiSmallMargin">
								<Label text="{i18n>inspections.remarks}"/>
								<Text text="{= ${dc>/latest/remarks} || '–' }" class="eoPre"/>
								<Label text="Notizen" visible="{= !!${dc>/latest/notes} }" class="sapUiSmallMarginTop"/>
								<Text text="{dc>/latest/notes}" visible="{= !!${dc>/latest/notes} }" class="eoPre"/>
							</VBox>
						</VBox>
					</f:content>
				</f:Card>

				<!-- Fotos und Dokumente der Erstbegehung -->
				<OverflowToolbar style="Clear" class="eoDocSubBar" visible="{= !!${dc>/latest} || ${dc>/initialDocs}.length > 0 }">
					<Title text="Fotos und Dokumente" level="H4"/>
					<Text text="{= String(${dc>/latestPhotos}.length + ${dc>/initialDocs}.length) }" class="eoContactGroupCount"/>
				</OverflowToolbar>
				<HBox items="{path: 'dc>/latestPhotos', templateShareable: false}" wrap="Wrap" renderType="Bare" class="eoMediaGrid" visible="{= ${dc>/latestPhotos}.length > 0 }">
					<eo:MediaThumb src="{dc>thumb}" kind="{dc>kind}" alt="{dc>alt}" press=".onInspectionPhoto"/>
				</HBox>
				<List id="initialDocList" items="{dc>/initialDocs}" visible="{= ${dc>/initialDocs}.length > 0 }" class="eoDocList" showSeparators="Inner">
					<StandardListItem title="{dc>originalName}" description="{dc>meta}" icon="sap-icon://pdf-attachment" type="Active" press=".onInitialDoc"/>
				</List>
				<HBox alignItems="Center" class="eoEmptyRow" visible="{= !!${dc>/latest} &amp;&amp; ${dc>/latestPhotos}.length + ${dc>/initialDocs}.length === 0 }">
					<core:Icon src="sap-icon://camera" class="eoEmptyRowIcon" decorative="true"/>
					<Text text="Keine Fotos oder Dokumente zur Erstbegehung. Das Protokoll lässt sich jederzeit über „Protokoll (PDF)“ erzeugen."
						wrapping="true" class="eoEmptyRowText"/>
				</HBox>

				<!-- Alle Protokolle (auch Korrekturen und frühere Begehungen) -->
				<OverflowToolbar style="Clear" class="eoDocSubBar" visible="{= ${dc>/initial}.length > 1 }">
					<Title text="Alle Protokolle" level="H4"/>
					<Text text="{= String(${dc>/initial}.length) }" class="eoContactGroupCount"/>
				</OverflowToolbar>
				<List id="initialAllList" items="{dc>/initialAll}" visible="{= ${dc>/initial}.length > 1 }" class="eoDocList" showSeparators="Inner">
					<CustomListItem>
						<HBox alignItems="Center" justifyContent="SpaceBetween" class="eoDocListRow">
							<VBox renderType="Bare">
								<Text text="{dc>line}"/>
								<ObjectStatus text="{dc>resultText}" state="{dc>resultTone}"/>
							</VBox>
							<Button text="PDF" icon="sap-icon://pdf-attachment" type="Transparent" press=".onInitialPdfOf" tooltip="Dieses Protokoll als PDF"/>
						</HBox>
					</CustomListItem>
				</List>
			</IconTabFilter>
			<!-- CM-Messungen (Belegreife) -->
			<IconTabFilter id="messungenTab" key="pruefungen" text="CM-Messungen" icon="sap-icon://lab" count="{dc>/cmCount}" visible="{= ${session>/modules/inspections} !== false }">
				<OverflowToolbar style="Clear" class="eoDocBar">
					<Title text="{i18n>inspections.cmTitle}" level="H3"/>
					<ToolbarSpacer/>
					<Button text="{i18n>inspections.addCm}" icon="sap-icon://lab" type="Emphasized" press=".onAddCm" visible="{= ${session>/permissions/inspections.write} === true }"/>
				</OverflowToolbar>
				<Table id="cmTable" items="{dc>/cm}" noDataText="{i18n>inspections.noneCm}" popinLayout="GridSmall">
					<columns>
						<Column width="10rem"><Text text="Datum"/></Column>
						<Column><Text text="Messstelle"/></Column>
						<Column minScreenWidth="Tablet" demandPopin="true"><Text text="Estrich"/></Column>
						<Column width="5rem" hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Dicke"/></Column>
						<Column width="13rem" hAlign="End"><Text text="CM / Feuchte"/></Column>
						<Column width="11rem"><Text text="Ergebnis"/></Column>
						<Column minScreenWidth="Desktop" demandPopin="true"><Text text="Prüfer"/></Column>
						<Column minScreenWidth="Desktop" demandPopin="true"><Text text="Bemerkung"/></Column>
					</columns>
					<items>
						<ColumnListItem highlight="{path: 'dc>isReadyForCovering', formatter: 'fmt.readyState'}">
							<Text text="{path: 'dc>performedAt', formatter: 'fmt.dateTime'}" class="eoTabular"/>
							<Text text="{dc>location}"/>
							<Text text="{path: 'dc>binder', formatter: 'fmt.binderText'}{= ${dc>heated} ? ', beheizt' : '' }"/>
							<Text text="{= ${dc>thicknessMm} === null ? '–' : ${dc>thicknessMm} + ' mm' }"/>
							<Text text="{path: 'dc>measuredCmPercent', formatter: 'fmt.cm'} CM-% (Grenzwert {path: 'dc>limitCmPercent', formatter: 'fmt.cm'})" class="eoTabular"/>
							<ObjectStatus text="{path: 'dc>isReadyForCovering', formatter: 'fmt.readyText'}" state="{path: 'dc>isReadyForCovering', formatter: 'fmt.readyState'}"/>
							<Text text="{path: 'dc>performedByUserId', formatter: 'fmt.person'}"/>
							<Text text="{= (${dc>remarks} || '–') + (${dc>correctsInspectionId} ? ' (Korrektur)' : '') }"/>
						</ColumnListItem>
					</items>
				</Table>
			</IconTabFilter>
			<!-- Berichte -->
			<!-- Abnahmen -->
			<IconTabFilter id="abnahmenTab" key="abnahmen" text="Abnahmen" count="{dc>/acceptanceCount}" visible="{= ${session>/modules/acceptance} !== false }">
				<OverflowToolbar style="Clear">
					<Title text="Abnahmeprotokolle" level="H3"/>
					<ToolbarSpacer/>
					<Button id="addAcceptance" text="Abnahmeprotokoll erstellen" icon="sap-icon://signature" type="Emphasized" press=".onAddAcceptance"
						visible="{= ${session>/permissions/inspections.write} === true }"/>
				</OverflowToolbar>
				<List id="acceptanceList" items="{dc>/acceptances}" noDataText="Noch keine Abnahme. Bei der Abnahme vor Ort den Assistenten starten; Unterschriften werden auf dem Gerät erfasst.">
					<CustomListItem>
						<FlexBox wrap="Wrap" justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMargin eoEntryRow">
							<VBox>
								<HBox alignItems="Center" class="eoEntryRow">
									<ObjectStatus text="{dc>resultText}" state="{dc>resultState}" inverted="true"/>
									<ObjectStatus text="{dc>stateText}" state="{dc>stateState}"/>
								</HBox>
								<Text text="{dc>line}" class="sapUiTinyMarginTop"/>
								<Text text="{dc>customerLine}" visible="{= !!${dc>customerLine} }" class="eoMuted"/>
							</VBox>
							<HBox class="eoEntryRow">
								<Button text="PDF" icon="sap-icon://pdf-attachment" press=".onAcceptancePdf" visible="{= !!${dc>pdfFileId} }"/>
								<Button text="Freigabelink" icon="sap-icon://share-2" press=".onAcceptanceLink"
									visible="{= ${dc>state} !== 'completed' &amp;&amp; ${session>/permissions/inspections.write} === true }"/>
							</HBox>
						</FlexBox>
					</CustomListItem>
				</List>
			</IconTabFilter>

			<IconTabFilter key="berichte" text="{i18n>reports.title}" icon="sap-icon://print">
				<l:Grid defaultSpan="XL4 L4 M6 S12" class="sapUiSmallMarginTop">
					<f:Card>
						<f:header><card:Header title="{i18n>reports.site}" subtitle="{i18n>reports.siteText}" iconSrc="sap-icon://print"/></f:header>
						<f:content>
							<VBox class="sapUiSmallMargin">
								<Label text="{i18n>reports.from}" labelFor="reportFrom"/>
								<DatePicker id="reportFrom" value="{dc>/reportFrom}" valueFormat="yyyy-MM-dd" displayFormat="dd.MM.yyyy"/>
								<Label text="{i18n>reports.to}" labelFor="reportTo"/>
								<DatePicker id="reportTo" value="{dc>/reportTo}" valueFormat="yyyy-MM-dd" displayFormat="dd.MM.yyyy"/>
								<CheckBox text="{i18n>reports.withPhotos}" selected="{dc>/reportPhotos}"/>
								<CheckBox text="{i18n>reports.withWork}" selected="{dc>/reportWork}"/>
								<Button text="{i18n>reports.open}" type="Emphasized" icon="sap-icon://print" press=".onReport" class="sapUiSmallMarginTop"/>
							</VBox>
						</f:content>
					</f:Card>
					<f:Card>
						<f:header><card:Header title="{i18n>reports.acceptance}" subtitle="{i18n>reports.acceptanceText}" iconSrc="sap-icon://approvals"/></f:header>
						<f:content>
							<VBox class="sapUiSmallMargin">
								<Text text="{i18n>reports.acceptanceHelp}"/>
								<Button text="{i18n>reports.open}" icon="sap-icon://print" press=".onAcceptance" class="sapUiSmallMarginTop"/>
							</VBox>
						</f:content>
					</f:Card>
					<f:Card>
						<f:header><card:Header title="{i18n>reports.sheet}" subtitle="{i18n>reports.sheetText}" iconSrc="sap-icon://document-text"/></f:header>
						<f:content>
							<VBox class="sapUiSmallMargin">
								<Text text="{i18n>reports.sheetHelp}"/>
								<Button text="{i18n>reports.open}" icon="sap-icon://print" press=".onSheet" class="sapUiSmallMarginTop"/>
							</VBox>
						</f:content>
					</f:Card>
				</l:Grid>
			</IconTabFilter>
		</items>
	</IconTabBar>
</mvc:View>
