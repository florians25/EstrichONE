<mvc:View controllerName="estrichone.controller.bauakte.sections.Overview" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m"
	xmlns:grid="sap.ui.layout.cssgrid" xmlns:form="sap.ui.layout.form" xmlns:core="sap.ui.core" xmlns:eo="estrichone.control"
	core:require="{fmt: 'estrichone/model/formatter'}">
	<VBox class="eoOverview" width="100%">
		<!-- Kerndaten in Spalten über die volle Breite -->
		<OverflowToolbar style="Clear" height="2rem">
			<ToolbarSpacer/>
			<Button text="Kennwerte bearbeiten" icon="sap-icon://edit" type="Transparent" press=".onEditProject" visible="{= ${akte>/canEdit} === true }"/>
		</OverflowToolbar>
		<form:SimpleForm editable="false" layout="ResponsiveGridLayout" columnsXL="4" columnsL="3" columnsM="2" labelSpanXL="5" labelSpanL="5" labelSpanM="5" labelSpanS="12" emptySpanXL="0" emptySpanL="0" emptySpanM="0" adjustLabelSpan="false" singleContainerFullSize="false" breakpointXL="1400"
			class="eoDenseForm">
			<core:Title text="{i18n>overview.base}"/>
			<Label text="Bauakte"/><Text text="{= ${akte>/bauakte/number} || '–' }"/>
			<Label text="Status"/><ObjectStatus text="{path: 'akte>/bauakte/status', formatter: 'fmt.bauakteStatusText'}" state="{path: 'akte>/bauakte/status', formatter: 'fmt.bauakteStatusState'}"/>
			<Label text="Zuständig"/><Text text="{akte>/responsibleName}"/>
			<Label text="Angelegt"/><Text text="{path: 'akte>/bauakte/createdAt', formatter: 'fmt.dateTime'}"/>
			<Label text="Geändert"/><Text text="{path: 'akte>/bauakte/updatedAt', formatter: 'fmt.dateTime'}"/>
			<Label text="Beschreibung"/><Text text="{= ${akte>/bauakte/description} || '–' }" class="eoPre"/>
			<core:Title text="Bauvorhaben"/>
			<Label text="Objektart"/><Text text="{akte>/projectView/objectType}"/>
			<Label text="Geschosse"/><Text text="{akte>/projectView/floors}"/>
			<Label text="Gesamtfläche"/><Text text="{akte>/projectView/totalArea}"/>
			<Label text="Estrichart"/><Text text="{akte>/projectView/screedType}"/>
			<Label text="Konstruktion"/><Text text="{akte>/projectView/construction}"/>
			<Label text="Nenndicke"/><Text text="{akte>/projectView/thickness}"/>
			<Label text="Festigkeit"/><Text text="{akte>/projectView/strengthClass}"/>
			<Label text="Heizung"/><Text text="{akte>/projectView/heating}"/>
			<Label text="Dämmung"/><Text text="{akte>/projectView/insulation}"/>
			<Label text="Priorität"/><Text text="{akte>/projectView/priority}"/>
			<core:Title text="{i18n>overview.siteData}"/>
			<Label text="Straße"/><Text text="{= ${akte>/bauakte/street} || '–' }"/>
			<Label text="PLZ / Ort"/><Text text="{= (${akte>/bauakte/postalCode} || '') + ' ' + (${akte>/bauakte/city} || '') }"/>
			<Label text="Kontakt"/><Text text="{= ${akte>/bauakte/siteContactName} || '–' }"/>
			<Label text="Telefon"/><Link text="{akte>/phone}" href="tel:{akte>/phone}" visible="{= !!${akte>/phone} }"/>
			<Label text="Koordinaten"/><Text text="{= ${ov>/coordinates} || '–' }"/>
			<Label text="Zugang"/><Text text="{akte>/projectView/siteAccess}" class="eoPre"/>
			<Label text="Versorgung"/><Text text="{akte>/projectView/utilities}"/>
			<Label text="Hinweise"/><Text text="{= ${akte>/bauakte/siteNotes} || '–' }" class="eoPre"/>
			<core:Title text="Termine"/>
			<Label text="Beginn"/><Text text="{path: 'akte>/bauakte/plannedStart', formatter: 'fmt.date'}"/>
			<Label text="Ende"/><Text text="{path: 'akte>/bauakte/plannedEnd', formatter: 'fmt.date'}"/>
			<Label text="Nächster"/><Text text="{= ${ov>/nextValue} === '–' || !${ov>/nextValue} ? 'nicht eingeplant' : ${ov>/nextValue} + ' ' + ${ov>/nextFooter} }"/>
			<core:Title text="Dokumentation"/>
			<Label text="Offen"/>
			<Link text="{= (${ov>/openWork} || '–') + (${ov>/workFooter} ? ' · ' + ${ov>/workFooter} : '') }" press=".onToWork"/>
			<Label text="Prüfungen"/>
			<ObjectStatus text="{= (${ov>/inspectionValue} || '–') + ' ' + (${ov>/inspectionScale} || '') + ' · ' + (${ov>/inspectionFooter} || '') }"
				state="{= ${ov>/inspectionColor} === 'Good' ? 'Success' : ${ov>/inspectionColor} === 'Critical' ? 'Warning' : 'None' }"/>
			<Label text="{i18n>overview.documents}"/><Link text="{= (${ov>/documentCount} || '0') + ' · ' + (${ov>/documentFooter} || '') }" press=".onToDocuments"/>
			<Label text="{i18n>overview.photos}"/><Link text="{= ${ov>/photoText} || '0 Fotos' }" press=".onToPhotos"/>
			<Label text="{i18n>overview.diary}"/><Text text="{= (${ov>/diaryCount} || '0') + ' · ' + (${ov>/diaryFooter} || '') }"/>
		</form:SimpleForm>

		<!-- Listen als kompakte Tabellen -->
		<grid:CSSGrid gridTemplateColumns="repeat(auto-fit, minmax(26rem, 1fr))" gridGap="0.5rem 2rem" class="eoOverviewGrid">
			<Table items="{ov>/work}" noDataText="Keine offenen Aufgaben oder Mängel." visible="{= ${session>/permissions/work.read} === true }"
				class="eoDenseTable" popinLayout="GridSmall">
				<headerToolbar><OverflowToolbar style="Clear"><Title text="{i18n>overview.openWorkList}" level="H3"/><ToolbarSpacer/>
					<Button text="Alle" type="Transparent" press=".onToWork"/></OverflowToolbar></headerToolbar>
				<columns><Column width="6rem"><Text text="Art"/></Column><Column><Text text="Titel"/></Column><Column width="7rem" hAlign="End"><Text text="Fällig"/></Column></columns>
				<items><ColumnListItem>
					<ObjectStatus text="{= ${ov>kind} === 'defect' ? 'Mangel' : 'Aufgabe' }" state="{= ${ov>kind} === 'defect' ? 'Warning' : 'Information' }"/>
					<Text text="{ov>title}" wrapping="false"/>
					<ObjectStatus text="{path: 'ov>dueDate', formatter: 'fmt.date'}" state="{path: 'ov>dueDate', formatter: 'fmt.overdueState'}"/>
				</ColumnListItem></items>
			</Table>
			<Table items="{ov>/upcoming}" noDataText="Keine Einsätze geplant." visible="{= ${session>/permissions/planning.read} === true }" class="eoDenseTable">
				<headerToolbar><OverflowToolbar style="Clear"><Title text="Nächste Einsätze" level="H3"/><ToolbarSpacer/>
					<Button text="Alle" type="Transparent" press=".onToAssignments"/></OverflowToolbar></headerToolbar>
				<columns><Column width="7rem"><Text text="Tag"/></Column><Column width="4rem"><Text text="Beginn"/></Column><Column><Text text="Tätigkeit"/></Column><Column><Text text="Kolonne"/></Column></columns>
				<items><ColumnListItem>
					<Text text="{ov>dayText}"/><Text text="{ov>time}"/><Text text="{ov>kind}" wrapping="false"/><Text text="{ov>crew}" wrapping="false"/>
				</ColumnListItem></items>
			</Table>
			<Table items="{ov>/latestDocs}" noDataText="Noch keine Dokumente." class="eoDenseTable">
				<headerToolbar><OverflowToolbar style="Clear"><Title text="Neueste Dokumente" level="H3"/><ToolbarSpacer/>
					<Button text="Alle" type="Transparent" press=".onToDocuments"/></OverflowToolbar></headerToolbar>
				<columns><Column><Text text="Dokument"/></Column><Column width="9rem" hAlign="End"><Text text="Abgelegt"/></Column></columns>
				<items><ColumnListItem type="Navigation" press=".onOpenDoc">
					<HBox alignItems="Center"><core:Icon src="{ov>icon}" class="sapUiTinyMarginEnd"/><Text text="{ov>originalName}" wrapping="false"/></HBox>
					<Text text="{path: 'ov>createdAt', formatter: 'fmt.dateTime'}"/>
				</ColumnListItem></items>
			</Table>
			<Table items="{ov>/approvals}" visible="{= ${ov>/approvals}.length > 0 }" class="eoDenseTable">
				<headerToolbar><OverflowToolbar style="Clear"><Title text="Warten auf Freigabe" level="H3"/>
					<ObjectStatus text="{= ${ov>/approvals}.length }" state="Warning" inverted="true"/></OverflowToolbar></headerToolbar>
				<columns><Column><Text text="Dokument"/></Column><Column width="10rem"><Text text="Freigabe durch"/></Column></columns>
				<items><ColumnListItem type="Navigation" press=".onOpenDoc"><Text text="{ov>name}" wrapping="false"/><Text text="{ov>assignee}"/></ColumnListItem></items>
			</Table>
			<Table items="{ov>/activity}" noDataText="{i18n>overview.noActivity}" class="eoDenseTable">
				<headerToolbar><OverflowToolbar style="Clear"><Title text="{i18n>overview.activity}" level="H3"/><ToolbarSpacer/>
					<Button text="Alle" type="Transparent" press=".onActivities"/></OverflowToolbar></headerToolbar>
				<columns><Column width="9rem"><Text text="Zeit"/></Column><Column><Text text="Aktivität"/></Column></columns>
				<items><ColumnListItem><Text text="{path: 'ov>at', formatter: 'fmt.dateTime'}"/><Text text="{ov>text}"/></ColumnListItem></items>
			</Table>
			<Table items="{ov>/pinned}" visible="{= ${ov>/pinned}.length > 0 }" class="eoDenseTable">
				<headerToolbar><OverflowToolbar style="Clear"><Title text="{i18n>overview.pinned}" level="H3"/></OverflowToolbar></headerToolbar>
				<columns><Column><Text text="Notiz"/></Column></columns>
				<items><ColumnListItem><Text text="{ov>text}" class="eoPre"/></ColumnListItem></items>
			</Table>
		</grid:CSSGrid>

		<!-- Standort und Bilder kompakt nebeneinander -->
		<grid:CSSGrid gridTemplateColumns="repeat(auto-fit, minmax(26rem, 1fr))" gridGap="0.5rem 2rem" class="sapUiSmallMarginTop">
			<VBox>
				<OverflowToolbar style="Clear">
					<Title text="{i18n>overview.location}" level="H3"/>
					<Text text="{= (${akte>/bauakte/street} || '') + ' ' + (${akte>/bauakte/city} || '') }" class="eoMuted"/>
					<ToolbarSpacer/>
					<Button text="{= ${ov>/hasLocation} ? ${i18n>overview.changeLocation} : ${i18n>overview.setLocation} }" icon="sap-icon://locate-me"
						press=".onPick" visible="{= ${akte>/canEdit} === true &amp;&amp; !${ov>/picking} }" type="Transparent"/>
					<Button text="{i18n>common.cancel}" press=".onPickCancel" visible="{ov>/picking}"/>
					<Button text="{i18n>overview.saveLocation}" type="Emphasized" press=".onPickSave" visible="{ov>/picking}" enabled="{= !!${ov>/picked} }"/>
				</OverflowToolbar>
				<MessageStrip text="{i18n>overview.pickHint}" type="Information" showIcon="true" visible="{ov>/picking}" class="sapUiTinyMarginBottom"/>
				<eo:LeafletMap id="siteMap" height="11rem" markers="{ov>/markers}" pickMode="{ov>/picking}" pick=".onPicked"
					visible="{= ${ov>/hasLocation} || ${ov>/picking} }"/>
				<Text text="{i18n>overview.noLocationText}" visible="{= !${ov>/hasLocation} &amp;&amp; !${ov>/picking} }" class="eoMuted"/>
			</VBox>
			<VBox>
				<OverflowToolbar style="Clear">
					<Title text="{i18n>overview.photos}" level="H3"/>
					<Text text="{ov>/photoText}" class="eoMuted"/>
					<ToolbarSpacer/>
					<Button text="Alle" type="Transparent" press=".onGallery" visible="{= ${ov>/hero}.length > 0 }"/>
					<Button text="{i18n>overview.addPhoto}" type="Transparent" press=".onToPhotos" visible="{= ${ov>/hero}.length === 0 }"/>
				</OverflowToolbar>
				<FlexBox items="{ov>/hero}" wrap="Wrap" class="eoThumbs">
					<Image src="{ov>url}" alt="{ov>alt}" width="6.5rem" height="6.5rem" press=".onGallery" decorative="false" class="eoThumb"/>
				</FlexBox>
				<Text text="{i18n>overview.noPhotosText}" visible="{= ${ov>/hero}.length === 0 }" class="eoMuted"/>
			</VBox>
		</grid:CSSGrid>
	</VBox>
</mvc:View>
