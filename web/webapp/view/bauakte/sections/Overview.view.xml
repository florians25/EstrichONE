<mvc:View controllerName="estrichone.controller.bauakte.sections.Overview" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m"
	xmlns:grid="sap.ui.layout.cssgrid" xmlns:form="sap.ui.layout.form" xmlns:core="sap.ui.core" xmlns:eo="estrichone.control" xmlns:f="sap.f" xmlns:card="sap.f.cards"
	core:require="{fmt: 'estrichone/model/formatter'}">
	<VBox class="eoOverview" width="100%">
		<!-- Kennzahlen als SAP Cards: numerischer Kopf mit Zustand, Inhalt als kurze Liste – Raster mit gleicher Höhe -->
		<f:GridContainer id="overviewCards" snapToRow="true" class="eoOverviewCards">
			<f:layout>
				<f:GridContainerSettings rowSize="4.25rem" columnSize="15rem" gap="0.75rem"/>
			</f:layout>
			<f:Card height="100%" visible="{= ${session>/permissions/work.read} === true }">
				<f:layoutData><f:GridContainerItemLayoutData rows="3" columns="1"/></f:layoutData>
				<f:header>
					<card:NumericHeader title="Aufgaben und Mängel" subtitle="offen" number="{= ${ov>/openWork} || '0' }" iconSrc="sap-icon://task"
						state="{= ${ov>/overdue} > 0 ? 'Critical' : 'Neutral' }" details="{= ${ov>/workFooter} || 'nichts offen' }" detailsMaxLines="1" press=".onToWork"/>
				</f:header>
				<f:content>
					<List items="{ov>/workTop}" showSeparators="None" noDataText="Keine offenen Aufgaben oder Mängel." class="eoCardList">
						<CustomListItem type="Active" press=".onToWork">
							<HBox justifyContent="SpaceBetween" alignItems="Center" class="eoCardRow">
								<HBox alignItems="Center" class="eoCardRowMain">
									<core:Icon src="{= ${ov>kind} === 'defect' ? 'sap-icon://warning2' : 'sap-icon://task' }" class="eoCardRowIcon"/>
									<Text text="{ov>title}" wrapping="false"/>
								</HBox>
								<ObjectStatus text="{path: 'ov>dueDate', formatter: 'fmt.date'}" state="{path: 'ov>dueDate', formatter: 'fmt.overdueState'}" class="eoNoShrink"/>
							</HBox>
						</CustomListItem>
					</List>
				</f:content>
			</f:Card>
			<f:Card height="100%" visible="{= ${session>/permissions/planning.read} === true }">
				<f:layoutData><f:GridContainerItemLayoutData rows="3" columns="1"/></f:layoutData>
				<f:header>
					<card:NumericHeader title="Nächster Einsatz" subtitle="{= ${ov>/nextValue} === '–' ? 'nicht eingeplant' : ${ov>/nextWeekday} }"
						number="{ov>/nextValue}" iconSrc="sap-icon://appointment-2" state="Neutral" details="{ov>/nextFooter}" detailsMaxLines="1" press=".onToAssignments"/>
				</f:header>
				<f:content>
					<List items="{ov>/upcomingTop}" showSeparators="None" noDataText="Keine Einsätze geplant." class="eoCardList">
						<CustomListItem type="Active" press=".onToAssignments">
							<HBox justifyContent="SpaceBetween" alignItems="Center" class="eoCardRow">
								<HBox alignItems="Center" class="eoCardRowMain">
									<Text text="{ov>dayText}" class="eoCardRowDay eoTabular" wrapping="false"/>
									<Text text="{ov>kind}" wrapping="false"/>
								</HBox>
								<Text text="{ov>crew}" wrapping="false" class="eoMuted eoCardRowSide"/>
							</HBox>
						</CustomListItem>
					</List>
				</f:content>
			</f:Card>
			<f:Card height="100%">
				<f:layoutData><f:GridContainerItemLayoutData rows="3" columns="1"/></f:layoutData>
				<f:header>
					<card:NumericHeader title="Prüfungen" subtitle="Belegreife" number="{= ${ov>/inspectionValue} || '–' }" scale="{ov>/inspectionScale}"
						iconSrc="sap-icon://measure" state="{= ${ov>/inspectionColor} === 'Good' ? 'Good' : ${ov>/inspectionColor} === 'Critical' ? 'Critical' : 'Neutral' }"
						details="{ov>/inspectionFooter}" detailsMaxLines="1" press=".onToDocumentation"/>
				</f:header>
				<f:content>
					<VBox class="eoCardBody">
						<HBox alignItems="Center" class="eoCardRow">
							<core:Icon src="sap-icon://inspection" class="eoCardRowIcon"/>
							<Text text="{= ${ov>/hasInitial} ? 'Erstbegehung dokumentiert' : 'Erstbegehung noch offen' }"/>
						</HBox>
						<Link text="Protokoll der Erstbegehung (PDF)" href="/api/v1/bauakten/{akte>/bauakte/id}/initial-inspection.pdf" target="_blank"
							visible="{= !!${ov>/hasInitial} }" class="sapUiTinyMarginTop"/>
						<HBox alignItems="Center" class="eoCardRow sapUiTinyMarginTop">
							<core:Icon src="sap-icon://notes" class="eoCardRowIcon"/>
							<Text text="{ov>/diaryText}" wrapping="false"/>
						</HBox>
					</VBox>
				</f:content>
			</f:Card>
			<f:Card height="100%">
				<f:layoutData><f:GridContainerItemLayoutData rows="3" columns="1"/></f:layoutData>
				<f:header>
					<card:NumericHeader title="{i18n>overview.documents}" subtitle="in der Bauakte" number="{= ${ov>/documentCount} || '0' }" iconSrc="sap-icon://document"
						state="{= ${ov>/approvals}.length > 0 ? 'Critical' : 'Neutral' }"
						details="{= ${ov>/approvals}.length > 0 ? ${ov>/approvals}.length + ' warten auf Freigabe' : ${ov>/documentFooter} }" detailsMaxLines="1" press=".onToDocuments"/>
				</f:header>
				<f:content>
					<List items="{ov>/latestTop}" showSeparators="None" noDataText="Noch keine Dokumente." class="eoCardList">
						<CustomListItem type="Active" press=".onOpenDoc">
							<HBox alignItems="Center" class="eoCardRow">
								<core:Icon src="{ov>icon}" class="eoCardRowIcon"/>
								<Text text="{ov>originalName}" wrapping="false"/>
							</HBox>
						</CustomListItem>
					</List>
				</f:content>
			</f:Card>
			<f:Card height="100%">
				<f:layoutData><f:GridContainerItemLayoutData rows="3" columns="1"/></f:layoutData>
				<f:header>
					<card:NumericHeader title="{i18n>overview.photos}" subtitle="Fotos und Videos" number="{= ${ov>/photoCount} || '0' }" iconSrc="sap-icon://camera"
						state="Neutral" details="{= ${ov>/photoFooter} || 'noch keine' }" detailsMaxLines="1" press=".onToPhotos"/>
				</f:header>
				<f:content>
					<HBox items="{ov>/heroTop}" class="eoCardPhotos">
						<Image src="{ov>url}" alt="{ov>alt}" width="4rem" height="4rem" press=".onOpenPhoto" decorative="false" class="eoThumb"/>
					</HBox>
				</f:content>
			</f:Card>
		</f:GridContainer>

		<!-- Kerndaten in Spalten über die volle Breite -->
		<OverflowToolbar style="Clear" height="2rem">
			<ToolbarSpacer/>
			<Button text="Kennwerte bearbeiten" icon="sap-icon://edit" type="Transparent" press=".onEditProject" visible="{= ${akte>/canEdit} === true }"/>
		</OverflowToolbar>
		<form:SimpleForm editable="false" layout="ResponsiveGridLayout" columnsXL="3" columnsL="3" columnsM="2" labelSpanXL="5" labelSpanL="5" labelSpanM="5" labelSpanS="12" emptySpanXL="0" emptySpanL="0" emptySpanM="0" adjustLabelSpan="false" singleContainerFullSize="false" breakpointXL="1400"
			class="eoDenseForm">
			<core:Title text="{i18n>overview.base}"/>
			<Label text="Bauakte"/><Text text="{= ${akte>/bauakte/number} || '–' }"/>
			<Label text="Status"/><ObjectStatus text="{path: 'akte>/bauakte/status', formatter: 'fmt.bauakteStatusText'}" state="{path: 'akte>/bauakte/status', formatter: 'fmt.bauakteStatusState'}"/>
			<Label text="Zuständig"/><Text text="{akte>/responsibleName}"/>
			<Label text="Angelegt"/><Text text="{path: 'akte>/bauakte/createdAt', formatter: 'fmt.dateTime'}"/>
			<Label text="Geändert"/><Text text="{path: 'akte>/bauakte/updatedAt', formatter: 'fmt.dateTime'}"/>
			<Label text="Beschreibung"/><Text text="{= ${akte>/bauakte/description} || '–' }" class="eoPre"/>
			<core:Title text="{i18n>overview.siteData}"/>
			<Label text="Straße"/><Text text="{= ${akte>/bauakte/street} || '–' }"/>
			<Label text="PLZ / Ort"/><Text text="{= (${akte>/bauakte/postalCode} || '') + ' ' + (${akte>/bauakte/city} || '') }"/>
			<Label text="Kontakt"/><Text text="{= ${akte>/bauakte/siteContactName} || '–' }"/>
			<Label text="Telefon"/><Link text="{akte>/phone}" href="tel:{akte>/phone}" visible="{= !!${akte>/phone} }"/>
			<Label text="Koordinaten"/><Text text="{= ${ov>/coordinates} || '–' }"/>
			<Label text="Hinweise"/><Text text="{= ${akte>/bauakte/siteNotes} || '–' }" class="eoPre"/>
			<core:Title text="Termine"/>
			<Label text="Beginn"/><Text text="{path: 'akte>/bauakte/plannedStart', formatter: 'fmt.date'}"/>
			<Label text="Ende"/><Text text="{path: 'akte>/bauakte/plannedEnd', formatter: 'fmt.date'}"/>
			<Label text="Nächster"/><Text text="{= ${ov>/nextValue} === '–' || !${ov>/nextValue} ? 'nicht eingeplant' : ${ov>/nextValue} + ' ' + ${ov>/nextFooter} }"/>
		</form:SimpleForm>

		<!-- Kennwerte des Bauvorhabens aus dem Formular-Schema (Formular-Designer der Stammdaten) -->
		<form:Form formContainers="{akte>/projectGroups}" editable="false" class="eoDenseForm">
			<form:layout>
				<form:ResponsiveGridLayout columnsXL="4" columnsL="3" columnsM="2" labelSpanXL="5" labelSpanL="5" labelSpanM="5" labelSpanS="12"
					emptySpanXL="0" emptySpanL="0" emptySpanM="0" adjustLabelSpan="false" singleContainerFullSize="false" breakpointXL="1400"/>
			</form:layout>
			<form:FormContainer title="{akte>label}" formElements="{path: 'akte>rows', templateShareable: false}">
				<form:FormElement label="{akte>label}">
					<Text text="{akte>value}"/>
				</form:FormElement>
			</form:FormContainer>
		</form:Form>

		<!-- Listen als kompakte Tabellen -->
		<grid:CSSGrid gridTemplateColumns="repeat(auto-fit, minmax(26rem, 1fr))" gridGap="0.5rem 2rem" class="eoOverviewGrid">
			<Table items="{ov>/approvals}" visible="{= ${ov>/approvals}.length > 0 }" class="eoDenseTable">
				<headerToolbar><OverflowToolbar style="Clear"><Title text="Warten auf Freigabe" level="H3"/>
					<ObjectStatus text="{= ${ov>/approvals}.length }" state="Warning" inverted="true"/></OverflowToolbar></headerToolbar>
				<columns><Column><Text text="Dokument"/></Column><Column width="10rem"><Text text="Freigabe durch"/></Column></columns>
				<items><ColumnListItem type="Navigation" press=".onOpenDoc"><Text text="{ov>name}" wrapping="false"/><Text text="{ov>assignee}"/></ColumnListItem></items>
			</Table>
			<!-- Letzte Aktivitäten: über Aktionen › „Letzte Aktivitäten …“ und im Reiter Notizen &amp; Verlauf. -->
			<Table items="{ov>/pinned}" visible="{= ${ov>/pinned}.length > 0 }" class="eoDenseTable">
				<headerToolbar><OverflowToolbar style="Clear"><Title text="{i18n>overview.pinned}" level="H3"/></OverflowToolbar></headerToolbar>
				<columns><Column><Text text="Notiz"/></Column></columns>
				<items><ColumnListItem><Text text="{ov>text}" class="eoPre"/></ColumnListItem></items>
			</Table>
		</grid:CSSGrid>

		<!-- Standort und neueste Bilder: eine kompakte Zeile, Karte im Dialog -->
		<FlexBox wrap="Wrap" alignItems="Center" justifyContent="SpaceBetween" class="eoSiteStrip">
			<HBox alignItems="Center" class="eoInline">
				<core:Icon src="sap-icon://map" class="eoSiteIcon"/>
				<VBox>
					<Title text="{i18n>overview.location}" level="H3"/>
					<Text text="{= (${akte>/bauakte/street} || '') + ' ' + (${akte>/bauakte/postalCode} || '') + ' ' + (${akte>/bauakte/city} || '') }" visible="{ov>/hasLocation}"/>
					<Text text="{i18n>overview.noLocation}" visible="{= !${ov>/hasLocation} }" class="eoMuted"/>
				</VBox>
				<Button text="Karte" icon="sap-icon://map" press=".onShowMap" visible="{ov>/hasLocation}"/>
				<Button text="{= ${ov>/hasLocation} ? ${i18n>overview.changeLocation} : ${i18n>overview.setLocation} }" icon="sap-icon://locate-me"
					press=".onPick" visible="{= ${akte>/canEdit} === true &amp;&amp; !${ov>/picking} }" type="Transparent"/>
			</HBox>
			<HBox alignItems="Center" class="eoInline">
				<VBox alignItems="End">
					<Title text="Neueste Bilder" level="H3"/>
					<Link text="{= ${ov>/hero}.length ? 'Alle ' + ${ov>/photoText} : ${i18n>overview.addPhoto} }" press=".onToPhotos"/>
				</VBox>
				<HBox items="{ov>/hero}" class="eoPhotoStrip">
					<Image src="{ov>url}" alt="{ov>alt}" width="4.5rem" height="4.5rem" press=".onOpenPhoto" decorative="false" class="eoThumb"/>
				</HBox>
			</HBox>
		</FlexBox>
		<VBox visible="{ov>/picking}" class="sapUiSmallMarginTop">
			<OverflowToolbar style="Clear">
				<MessageStrip text="{i18n>overview.pickHint}" type="Information" showIcon="true"/>
				<ToolbarSpacer/>
				<Button text="{i18n>common.cancel}" press=".onPickCancel"/>
				<Button text="{i18n>overview.saveLocation}" type="Emphasized" press=".onPickSave" enabled="{= !!${ov>/picked} }"/>
			</OverflowToolbar>
			<eo:LeafletMap id="siteMap" height="18rem" markers="{ov>/markers}" pickMode="{ov>/picking}" pick=".onPicked"/>
		</VBox>
	</VBox>
</mvc:View>
