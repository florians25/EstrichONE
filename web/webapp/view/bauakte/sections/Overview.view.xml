<mvc:View controllerName="estrichone.controller.bauakte.sections.Overview" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m"
	xmlns:grid="sap.ui.layout.cssgrid" xmlns:form="sap.ui.layout.form" xmlns:core="sap.ui.core" xmlns:eo="estrichone.control"
	core:require="{fmt: 'estrichone/model/formatter'}">
	<VBox class="eoOverview" width="100%">
		<!-- Kerndaten in Spalten über die volle Breite -->
		<OverflowToolbar style="Clear" height="2rem">
			<ToolbarSpacer/>
			<Button text="Kennwerte bearbeiten" icon="sap-icon://edit" type="Transparent" press=".onEditProject" visible="{= ${akte>/canEdit} === true }"/>
		</OverflowToolbar>
		<!-- Freitexte (Hinweise und Zugang, Beschreibung …) als lesbare Textblöcke: Zeilenumbrüche bleiben,
		     Links, E-Mail-Adressen und Telefonnummern sind anklickbar, lange Texte zuerst gekürzt (util/freeText.ts) -->
		<grid:CSSGrid id="freeTextGrid" items="{path: 'akte>/freeTexts', templateShareable: false}" gridTemplateColumns="repeat(auto-fit, minmax(22rem, 1fr))"
			gridGap="0.75rem 1.5rem" class="eoFreeTexts">
			<VBox class="eoFreeText" renderType="Bare">
				<customData>
					<core:CustomData key="important" value="{= ${akte>important} &amp;&amp; !!${akte>text} ? 'yes' : 'no' }" writeToDom="true"/>
					<core:CustomData key="clamp" value="{= ${akte>long} &amp;&amp; !${akte>expanded} ? 'yes' : 'no' }" writeToDom="true"/>
				</customData>
				<HBox alignItems="Center" justifyContent="SpaceBetween" renderType="Bare" class="eoFreeTextHead">
					<Title text="{akte>label}" level="H3" titleStyle="H6" wrapping="true"/>
					<Button icon="sap-icon://edit" type="Transparent" tooltip="{akte>label} bearbeiten" press=".onEditFreeText"
						visible="{= ${akte>/canEdit} === true }"/>
				</HBox>
				<!-- Eigenes, bereits escaptes HTML (nur a und br, util/freeText.ts); FormattedText würde tel: und mailto: entfernen -->
				<core:HTML content="{akte>html}" visible="{= !!${akte>text} }" sanitizeContent="false" preferDOM="false"/>
				<Text text="Nicht erfasst" visible="{= !${akte>text} }" class="eoMuted"/>
				<Link text="{= ${akte>expanded} ? 'Weniger anzeigen' : 'Mehr anzeigen' }" press=".onToggleFreeText" visible="{= ${akte>long} === true }"
					class="eoFreeTextMore"/>
			</VBox>
		</grid:CSSGrid>

		<form:SimpleForm editable="false" layout="ResponsiveGridLayout" columnsXL="4" columnsL="3" columnsM="2" labelSpanXL="5" labelSpanL="5" labelSpanM="5" labelSpanS="12" emptySpanXL="0" emptySpanL="0" emptySpanM="0" adjustLabelSpan="false" singleContainerFullSize="false" breakpointXL="1400"
			class="eoDenseForm">
			<core:Title text="{i18n>overview.base}"/>
			<Label text="Bauakte"/><Text text="{= ${akte>/bauakte/number} || '–' }"/>
			<Label text="Status"/><ObjectStatus text="{path: 'akte>/bauakte/status', formatter: 'fmt.bauakteStatusText'}" state="{path: 'akte>/bauakte/status', formatter: 'fmt.bauakteStatusState'}"/>
			<Label text="Zuständig"/><Text text="{akte>/responsibleName}"/>
			<Label text="Angelegt"/><Text text="{path: 'akte>/bauakte/createdAt', formatter: 'fmt.dateTime'}"/>
			<Label text="Geändert"/><Text text="{path: 'akte>/bauakte/updatedAt', formatter: 'fmt.dateTime'}"/>
			<core:Title text="{i18n>overview.siteData}"/>
			<Label text="Straße"/><Text text="{= ${akte>/bauakte/street} || '–' }"/>
			<Label text="PLZ / Ort"/><Text text="{= (${akte>/bauakte/postalCode} || '') + ' ' + (${akte>/bauakte/city} || '') }"/>
			<Label text="Kontakt"/><Text text="{= ${akte>/bauakte/siteContactName} || '–' }"/>
			<Label text="Telefon"/><Link text="{akte>/phone}" href="tel:{akte>/phone}" visible="{= !!${akte>/phone} }"/>
			<Label text="Koordinaten"/><Text text="{= ${ov>/coordinates} || '–' }"/>
			<core:Title text="Termine"/>
			<Label text="Beginn"/><Text text="{path: 'akte>/bauakte/plannedStart', formatter: 'fmt.date'}"/>
			<Label text="Ende"/><Text text="{path: 'akte>/bauakte/plannedEnd', formatter: 'fmt.date'}"/>
			<Label text="Nächster"/><Text text="{= ${ov>/nextValue} === '–' || !${ov>/nextValue} ? 'nicht eingeplant' : ${ov>/nextValue} + ' ' + ${ov>/nextFooter} }"/>
			<core:Title text="Dokumentation"/>
			<Label text="Offen"/>
			<Link text="{= (${ov>/openWork} || '–') + (${ov>/workFooter} ? ', ' + ${ov>/workFooter} : '') }" press=".onToWork"/>
			<Label text="Prüfungen"/>
			<ObjectStatus text="{= (${ov>/inspectionValue} || '–') + (${ov>/inspectionScale} ? ' ' + ${ov>/inspectionScale} : '') + (${ov>/inspectionFooter} ? ', ' + ${ov>/inspectionFooter} : '') }"
				state="{= ${ov>/inspectionColor} === 'Good' ? 'Success' : ${ov>/inspectionColor} === 'Critical' ? 'Warning' : 'None' }"/>
			<Label text="Erstbegehung" visible="{= !!${ov>/hasInitial} }"/>
			<Link text="Protokoll (PDF) öffnen" href="/api/v1/bauakten/{akte>/bauakte/id}/initial-inspection.pdf" target="_blank" visible="{= !!${ov>/hasInitial} }"/>
			<Label text="{i18n>overview.documents}"/><Link text="{= (${ov>/documentCount} || '0') + (${ov>/documentFooter} ? ', ' + ${ov>/documentFooter} : '') }" press=".onToDocuments"/>
			<Label text="{i18n>overview.photos}"/><Link text="{= ${ov>/photoText} || '0 Fotos' }" press=".onToPhotos"/>
			<Label text="{i18n>overview.diary}"/><Text text="{= (${ov>/diaryCount} || '0') + (${ov>/diaryFooter} ? ', ' + ${ov>/diaryFooter} : '') }"/>
		</form:SimpleForm>
		<VBox id="overviewLexware" renderType="Bare" class="sapUiSmallMarginTop" visible="{= ${ov>/lx/linked} === true }">
			<form:SimpleForm editable="false" layout="ResponsiveGridLayout" columnsXL="2" columnsL="2" columnsM="1" labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
				emptySpanXL="0" emptySpanL="0" emptySpanM="0" adjustLabelSpan="false" singleContainerFullSize="false" class="eoDenseForm">
				<core:Title text="Lexware Office"/>
				<Label text="Kontakt in Lexware"/>
				<VBox>
					<Text id="overviewLexwareName" text="{ov>/lx/name}"/>
					<Text text="weicht von EstrichONE ab" class="eoMuted" visible="{ov>/lx/nameDiffers}"/>
				</VBox>
				<Label text="Kundennummer in Lexware"/><Text text="{= ${ov>/lx/number} || 'ohne Kundennummer' }"/>
				<Label text="Rechnungsanschrift"/>
				<VBox>
					<Text text="{= ${ov>/lx/address} || 'noch nicht abgeglichen' }"/>
					<Text text="weicht von EstrichONE ab" class="eoMuted" visible="{ov>/lx/addressDiffers}"/>
				</VBox>
				<Label text="E-Mail"/>
				<VBox>
					<Text text="{= ${ov>/lx/email} || 'keine Angabe' }"/>
					<Text text="weicht von EstrichONE ab" class="eoMuted" visible="{ov>/lx/emailDiffers}"/>
				</VBox>
				<core:Title text="Abgleich und Belege"/>
				<Label text="Abgleich"/>
				<VBox>
					<ObjectStatus id="overviewLexwareState" text="{ov>/lx/stateText}" state="{ov>/lx/stateState}" visible="{= !!${ov>/lx/stateText} }"/>
					<Text text="{ov>/lx/stateHint}" class="eoMuted" visible="{= !!${ov>/lx/stateHint} }"/>
				</VBox>
				<Label text="Belege"/><Text id="overviewLexwareSummary" text="{ov>/lx/summary}"/>
				<Label text=""/>
				<HBox renderType="Bare" wrap="Wrap">
					<Link text="Rechnungen und Angebote" press=".onToInvoices" class="sapUiSmallMarginEnd"/>
					<Link text="In Lexware öffnen" href="{ov>/lx/url}" target="_blank" class="sapUiSmallMarginEnd"/>
					<Link text="Zum Kunden" press=".onToLexwareCustomer"/>
				</HBox>
			</form:SimpleForm>
		</VBox>
		<HBox id="overviewLexwareHint" renderType="Bare" wrap="Wrap" class="sapUiSmallMarginTop" visible="{= ${ov>/lx/unlinkedHint} === true }">
			<Text text="Der Kunde ist nicht mit Lexware Office verknüpft." class="eoMuted sapUiTinyMarginEnd"/>
			<Link text="Beim Kunden verknüpfen" press=".onToLexwareCustomer"/>
		</HBox>

		<!-- Kennwerte des Bauvorhabens aus dem Formular-Schema (Formular-Designer der Stammdaten) -->
		<form:Form formContainers="{akte>/projectGroups}" editable="false" class="eoDenseForm">
			<form:layout>
				<form:ResponsiveGridLayout columnsXL="4" columnsL="3" columnsM="2" labelSpanXL="5" labelSpanL="5" labelSpanM="5" labelSpanS="12"
					emptySpanXL="0" emptySpanL="0" emptySpanM="0" adjustLabelSpan="false" singleContainerFullSize="false" breakpointXL="1400"/>
			</form:layout>
			<form:FormContainer title="{akte>label}" formElements="{path: 'akte>rows', templateShareable: false}">
				<form:FormElement label="{akte>label}">
					<Text text="{akte>value}"/>
				</form:FormElement>
			</form:FormContainer>
		</form:Form>

		<!-- Listen als kompakte Tabellen -->
		<grid:CSSGrid gridTemplateColumns="repeat(auto-fit, minmax(26rem, 1fr))" gridGap="0.5rem 2rem" class="eoOverviewGrid">
			<Table items="{ov>/work}" noDataText="Keine offenen Aufgaben oder Mängel." visible="{= ${session>/permissions/work.read} === true }"
				class="eoDenseTable" popinLayout="GridSmall">
				<headerToolbar><OverflowToolbar style="Clear"><Title text="{i18n>overview.openWorkList}" level="H3"/><ToolbarSpacer/>
					<Button text="Alle" type="Transparent" press=".onToWork"/></OverflowToolbar></headerToolbar>
				<columns><Column width="6rem"><Text text="Art"/></Column><Column><Text text="Titel"/></Column><Column width="7rem" hAlign="End"><Text text="Fällig"/></Column></columns>
				<items><ColumnListItem>
					<ObjectStatus text="{= ${ov>kind} === 'defect' ? 'Mangel' : 'Aufgabe' }" state="{= ${ov>kind} === 'defect' ? 'Warning' : 'Information' }"/>
					<Text text="{ov>title}" wrapping="false"/>
					<ObjectStatus text="{path: 'ov>dueDate', formatter: 'fmt.date'}" state="{path: 'ov>dueDate', formatter: 'fmt.overdueState'}"/>
				</ColumnListItem></items>
			</Table>
			<Table items="{ov>/upcoming}" noDataText="Keine Einsätze geplant." visible="{= ${session>/permissions/planning.read} === true }" class="eoDenseTable">
				<headerToolbar><OverflowToolbar style="Clear"><Title text="Nächste Einsätze" level="H3"/><ToolbarSpacer/>
					<Button text="Alle" type="Transparent" press=".onToAssignments"/></OverflowToolbar></headerToolbar>
				<columns><Column width="7rem"><Text text="Tag"/></Column><Column width="4rem"><Text text="Beginn"/></Column><Column><Text text="Tätigkeit"/></Column><Column><Text text="Kolonne"/></Column></columns>
				<items><ColumnListItem>
					<Text text="{ov>dayText}"/><Text text="{ov>time}"/><Text text="{ov>kind}" wrapping="false"/><Text text="{ov>crew}" wrapping="false"/>
				</ColumnListItem></items>
			</Table>
			<Table items="{ov>/latestDocs}" noDataText="Noch keine Dokumente." class="eoDenseTable">
				<headerToolbar><OverflowToolbar style="Clear"><Title text="Neueste Dokumente" level="H3"/><ToolbarSpacer/>
					<Button text="Alle" type="Transparent" press=".onToDocuments"/></OverflowToolbar></headerToolbar>
				<columns><Column><Text text="Dokument"/></Column><Column width="9rem" hAlign="End"><Text text="Abgelegt"/></Column></columns>
				<items><ColumnListItem type="Navigation" press=".onOpenDoc">
					<HBox alignItems="Center"><core:Icon src="{ov>icon}" class="sapUiTinyMarginEnd"/><Text text="{ov>originalName}" wrapping="false"/></HBox>
					<Text text="{path: 'ov>createdAt', formatter: 'fmt.dateTime'}"/>
				</ColumnListItem></items>
			</Table>
			<Table items="{ov>/approvals}" visible="{= ${ov>/approvals}.length > 0 }" class="eoDenseTable">
				<headerToolbar><OverflowToolbar style="Clear"><Title text="Warten auf Freigabe" level="H3"/>
					<ObjectStatus text="{= ${ov>/approvals}.length }" state="Warning" inverted="true"/></OverflowToolbar></headerToolbar>
				<columns><Column><Text text="Dokument"/></Column><Column width="10rem"><Text text="Freigabe durch"/></Column></columns>
				<items><ColumnListItem type="Navigation" press=".onOpenDoc"><Text text="{ov>name}" wrapping="false"/><Text text="{ov>assignee}"/></ColumnListItem></items>
			</Table>
			<!-- Letzte Aktivitäten: über Aktionen › „Letzte Aktivitäten …“ und im Reiter Notizen &amp; Verlauf. -->
			<Table items="{ov>/pinned}" visible="{= ${ov>/pinned}.length > 0 }" class="eoDenseTable">
				<headerToolbar><OverflowToolbar style="Clear"><Title text="{i18n>overview.pinned}" level="H3"/></OverflowToolbar></headerToolbar>
				<columns><Column><Text text="Notiz"/></Column></columns>
				<items><ColumnListItem><Text text="{ov>text}" class="eoPre"/></ColumnListItem></items>
			</Table>
		</grid:CSSGrid>

		<!-- Standort und neueste Bilder: eine kompakte Zeile, Karte im Dialog -->
		<FlexBox wrap="Wrap" alignItems="Center" justifyContent="SpaceBetween" class="eoSiteStrip">
			<HBox alignItems="Center" class="eoInline">
				<core:Icon src="sap-icon://map" class="eoSiteIcon"/>
				<VBox>
					<Title text="{i18n>overview.location}" level="H3"/>
					<Text text="{= (${akte>/bauakte/street} || '') + ' ' + (${akte>/bauakte/postalCode} || '') + ' ' + (${akte>/bauakte/city} || '') }" visible="{ov>/hasLocation}"/>
					<Text text="{i18n>overview.noLocation}" visible="{= !${ov>/hasLocation} }" class="eoMuted"/>
				</VBox>
				<Button text="Karte" icon="sap-icon://map" press=".onShowMap" visible="{ov>/hasLocation}"/>
				<Button text="{= ${ov>/hasLocation} ? ${i18n>overview.changeLocation} : ${i18n>overview.setLocation} }" icon="sap-icon://locate-me"
					press=".onPick" visible="{= ${akte>/canEdit} === true &amp;&amp; !${ov>/picking} }" type="Transparent"/>
			</HBox>
			<HBox alignItems="Center" class="eoInline">
				<VBox alignItems="End">
					<Title text="Neueste Bilder" level="H3"/>
					<Link text="{= ${ov>/hero}.length ? 'Alle ' + ${ov>/photoText} : ${i18n>overview.addPhoto} }" press=".onToPhotos"/>
				</VBox>
				<HBox items="{ov>/hero}" class="eoPhotoStrip">
					<eo:MediaThumb src="{ov>url}" kind="image" alt="{ov>alt}" press=".onOpenPhoto" class="eoMediaThumbS"/>
				</HBox>
			</HBox>
		</FlexBox>
		<VBox visible="{ov>/picking}" class="sapUiSmallMarginTop">
			<OverflowToolbar style="Clear">
				<MessageStrip text="{i18n>overview.pickHint}" type="Information" showIcon="true"/>
				<ToolbarSpacer/>
				<Button text="{i18n>common.cancel}" press=".onPickCancel"/>
				<Button text="{i18n>overview.saveLocation}" type="Emphasized" press=".onPickSave" enabled="{= !!${ov>/picked} }"/>
			</OverflowToolbar>
			<eo:LeafletMap id="siteMap" height="18rem" markers="{ov>/markers}" pickMode="{ov>/picking}" pick=".onPicked"/>
		</VBox>
	</VBox>
</mvc:View>
