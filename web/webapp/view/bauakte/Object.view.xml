<mvc:View controllerName="estrichone.controller.bauakte.Object" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:uxap="sap.uxap"
	xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout" xmlns:eo="estrichone.control"
	core:require="{fmt: 'estrichone/model/formatter'}" height="100%">
	<uxap:ObjectPageLayout id="objectPage" useIconTabBar="true" showFooter="false" upperCaseAnchorBar="false" busy="{akte>/busy}"
		headerContentPinnable="true" toggleHeaderOnTitleClick="true" navigate=".onSectionNavigate" showEditHeaderButton="false"
		sectionTitleLevel="H2" enableLazyLoading="false">
		<uxap:headerTitle>
			<uxap:ObjectPageDynamicHeaderTitle id="headerTitle">
				<uxap:breadcrumbs>
					<Breadcrumbs currentLocationText="{= ${akte>/bauakte/number} || 'Neue Bauakte' }">
						<Link text="{i18n>nav.bauakten}" href="/bauakten"/>
					</Breadcrumbs>
				</uxap:breadcrumbs>
				<uxap:expandedHeading>
					<VBox class="eoAkteTitle">
						<HBox alignItems="Center" wrap="Wrap" class="eoTitleLine">
							<Text text="{= ${akte>/bauakte/number} || 'ohne Nummer' }" class="eoAkteNumber"/>
							<Title id="bauakteTitle" text="{akte>/bauakte/title}" level="H1" wrapping="true" titleStyle="H3"/>
							<ObjectStatus text="{path: 'akte>/bauakte/status', formatter: 'fmt.bauakteStatusText'}"
								state="{path: 'akte>/bauakte/status', formatter: 'fmt.bauakteStatusState'}" inverted="true"
								icon="{path: 'akte>/bauakte/status', formatter: 'fmt.bauakteStatusIcon'}"/>
						</HBox>
						<Text text="{akte>/subtitle}" class="eoMuted"/>
					</VBox>
				</uxap:expandedHeading>
				<uxap:snappedHeading>
					<HBox alignItems="Center">
						<Avatar src="sap-icon://folder-full" displaySize="XS" class="sapUiTinyMarginEnd" backgroundColor="Accent6" decorative="true"/>
						<Title text="{akte>/bauakte/number} · {akte>/bauakte/title}" level="H1" wrapping="false"/>
					</HBox>
				</uxap:snappedHeading>
				<uxap:snappedContent>
					<ObjectStatus text="{path: 'akte>/bauakte/status', formatter: 'fmt.bauakteStatusText'}"
						state="{path: 'akte>/bauakte/status', formatter: 'fmt.bauakteStatusState'}" inverted="true"/>
				</uxap:snappedContent>
				<uxap:actions>
					<MenuButton id="statusButton" text="Status: {path: 'akte>/bauakte/status', formatter: 'fmt.bauakteStatusText'}"
						icon="sap-icon://flag" enabled="{= ${akte>/canEdit} &amp;&amp; ${akte>/bauakte/status} !== 'cancelled' }"
						ariaLabelledBy="statusLabel">
						<menu>
							<Menu itemSelected=".onStatusMenu">
								<MenuItem text="Anfrage" key="inquiry" icon="sap-icon://inbox"/>
								<MenuItem text="Geplant" key="planned" icon="sap-icon://appointment-2"/>
								<MenuItem text="In Ausführung" key="inProgress" icon="sap-icon://process"/>
								<MenuItem text="Belegreif / Trocknung" key="drying" icon="sap-icon://temperature"/>
								<MenuItem text="Abgeschlossen" key="completed" icon="sap-icon://complete"/>
							</Menu>
						</menu>
					</MenuButton>
					<Button text="{i18n>akte.takeOver}" type="Emphasized" icon="sap-icon://accept" press=".onTakeOver"
						visible="{= ${akte>/canEdit} &amp;&amp; ${akte>/bauakte/status} === 'inquiry' }"/>
					<Button text="{i18n>akte.complete}" type="Success" icon="sap-icon://complete" press=".onComplete"
						visible="{= ${akte>/canEdit} &amp;&amp; ['planned','inProgress','drying'].indexOf(${akte>/bauakte/status}) >= 0 }"/>
					<Button id="assignMeButton" text="Mir zuweisen" icon="sap-icon://add-employee" press=".onAssignMe" visible="{= ${akte>/canAssignMe} === true }"/>
					<Button text="{i18n>common.edit}" icon="sap-icon://edit" press=".onEdit" visible="{akte>/canEdit}"/>
					<MenuButton id="actionsButton" text="{i18n>common.actions}" icon="sap-icon://overflow">
						<menu>
							<Menu>
								<MenuItem text="Letzte Aktivitäten …" icon="sap-icon://history" press=".onActivities"/>
								<MenuItem text="Abnahmeprotokoll erstellen …" icon="sap-icon://signature" press=".onAcceptance"
									visible="{= ${session>/permissions/inspections.write} === true }"/>
								<MenuItem text="Erstbegehungsprotokoll (PDF)" icon="sap-icon://inspection" press=".onInspectionPdf"/>
								<MenuItem text="Schreiben an den Kunden …" icon="sap-icon://letter" press=".onLetter" visible="{akte>/canEdit}"/>
								<MenuItem text="Archivnachweis …" icon="sap-icon://attachment-zip-file" press=".onArchiveProof"/>
								<MenuItem text="Bauakte als PDF (mit Fotos)" icon="sap-icon://pdf-attachment" press=".onPdf" startsSection="true"/>
								<MenuItem text="{i18n>akte.report}" icon="sap-icon://print" press=".onReport"/>
								<MenuItem text="{i18n>akte.acceptanceSheet}" icon="sap-icon://approvals" press=".onAcceptanceSheet"/>
								<MenuItem text="{i18n>akte.sheet}" icon="sap-icon://document-text" press=".onSheet"/>
								<MenuItem text="{i18n>akte.route}" icon="sap-icon://map-3" press=".onRoute" visible="{= !!${akte>/routeUrl} }" startsSection="true"/>
								<MenuItem text="{i18n>akte.call} ({akte>/phone})" icon="sap-icon://call" press=".onCall" visible="{= !!${akte>/phone} }"/>
								<MenuItem text="{i18n>akte.mail}" icon="sap-icon://email" press=".onMail" visible="{= !!${akte>/mail} }"/>
								<MenuItem text="{i18n>common.refresh}" icon="sap-icon://refresh" press=".onReload"/>
								<MenuItem text="{i18n>akte.cancel}" icon="sap-icon://cancel" press=".onCancel" startsSection="true"
									visible="{= ${akte>/canEdit} &amp;&amp; ${akte>/bauakte/status} !== 'cancelled' }"/>
								<MenuItem text="{i18n>akte.reactivate}" icon="sap-icon://undo" press=".onReactivate"
									visible="{= ${akte>/canEdit} &amp;&amp; ${akte>/bauakte/status} === 'cancelled' }"/>
								<MenuItem text="{i18n>akte.delete}" icon="sap-icon://delete" press=".onDelete" visible="{= ${session>/permissions/bauakten.delete} === true }"/>
							</Menu>
						</menu>
					</MenuButton>
				</uxap:actions>
				<uxap:navigationActions>
					<OverflowToolbarButton type="Transparent" icon="{= ${akte>/listShown} ? 'sap-icon://full-screen' : 'sap-icon://exit-full-screen' }"
						tooltip="{= ${akte>/listShown} ? ${i18n>akte.hideList} : ${i18n>akte.showList} }" text="{= ${akte>/listShown} ? ${i18n>akte.hideList} : ${i18n>akte.showList} }"
						press=".onToggleList"/>
					<OverflowToolbarButton type="Transparent" icon="sap-icon://decline" tooltip="{i18n>common.close}" text="{i18n>common.close}" press=".onClose"/>
				</uxap:navigationActions>
			</uxap:ObjectPageDynamicHeaderTitle>
		</uxap:headerTitle>
		<uxap:headerContent>
			<VBox width="100%">
			<VBox id="dossierBox" renderType="Bare"/>
			<HBox wrap="Wrap" alignItems="Center" class="eoHintBadges eoBadgeRow">
				<HBox items="{akte>/projectBadges}" wrap="Wrap" class="eoHintBadges">
					<ObjectStatus text="{akte>text}" state="{akte>state}" icon="{akte>icon}" inverted="true"/>
				</HBox>
				<ObjectStatus text="{akte>/approvalsText}" state="Warning" inverted="true" icon="sap-icon://pending" visible="{= !!${akte>/approvalsText} }"/>
				<HBox items="{akte>/hints}" wrap="Wrap" class="eoHintBadges">
					<ObjectStatus text="{akte>text}" state="{akte>type}" inverted="true" tooltip="{akte>text}">
						<customData><core:CustomData key="role" value="listitem" writeToDom="true"/></customData>
					</ObjectStatus>
				</HBox>
			</HBox>
			<FlexBox class="eoHeadRow" alignItems="Start" justifyContent="SpaceBetween" width="100%">
				<FlexBox class="eoHeadFields" wrap="Wrap">
					<VBox class="eoHeadField">
						<Label text="{i18n>akte.customer}"/>
						<Link text="{= ${akte>/customer/name} || '–' }" href="/kunden/{akte>/customer/id}" enabled="{= !!${akte>/customer} }" wrapping="false"/>
					</VBox>
					<VBox class="eoHeadField eoHeadWide">
						<Label text="{i18n>akte.site}"/>
						<HBox alignItems="Center" class="eoInline">
							<Text text="{akte>/placeText}" wrapping="true" maxLines="2" tooltip="{akte>/placeText}"/>
							<Button icon="sap-icon://map" type="Transparent" press=".onShowMap" class="eoMapButton" tooltip="Karte" text=""/>
						</HBox>
					</VBox>
					<VBox class="eoHeadField">
						<Label text="Zuständig"/>
						<Button id="assignButton" text="{akte>/assignedText}" tooltip="{i18n>akte.assigned}: {akte>/assignedText}" press=".onAssign"
							enabled="{akte>/canEdit}" type="Transparent" class="eoFactButton"/>
					</VBox>
					<VBox class="eoHeadField eoHeadWide">
						<Label text="{i18n>akte.next}"/>
						<Text text="{akte>/kpi/nextText}" wrapping="true" maxLines="2" tooltip="{akte>/kpi/nextText}"/>
					</VBox>
					<VBox class="eoHeadField">
						<Label text="Angelegt"/>
						<Text text="{akte>/createdDate}" tooltip="{akte>/createdText}" wrapping="false"/>
					</VBox>
				</FlexBox>
				<HBox class="eoKpis">
					<VBox class="eoKpi" alignItems="End">
						<Label text="Offen"/>
						<ObjectNumber number="{akte>/kpi/openWork}" unit="{= ${akte>/kpi/defects} > 0 ? '(' + ${akte>/kpi/defects} + ' Mängel)' : '' }"
							state="{= ${akte>/kpi/overdue} > 0 ? 'Error' : ${akte>/kpi/defects} > 0 ? 'Warning' : 'None' }" class="eoKpiNumber"/>
					</VBox>
					<VBox class="eoKpi" alignItems="End">
						<Label text="Fläche"/>
						<ObjectNumber number="{akte>/kpi/area}" unit="m²" class="eoKpiNumber"/>
					</VBox>
					<VBox class="eoKpi" alignItems="End">
						<Label text="Fotos / Dokumente"/>
						<ObjectNumber number="{= ${akte>/kpi/photos} === undefined ? '–' : ${akte>/kpi/photos} + ' / ' + ${akte>/kpi/docs} }" class="eoKpiNumber"/>
					</VBox>
				</HBox>
			</FlexBox>
			</VBox>
		</uxap:headerContent>
		<uxap:sections>
			<uxap:ObjectPageSection id="uebersicht" title="{i18n>akte.sec.overview}" titleUppercase="false">
				<uxap:subSections><uxap:ObjectPageSubSection>
					<mvc:XMLView id="secOverview" viewName="estrichone.view.bauakte.sections.Overview" async="true"/>
				</uxap:ObjectPageSubSection></uxap:subSections>
			</uxap:ObjectPageSection>
			<uxap:ObjectPageSection id="kontakte" title="{i18n>akte.sec.contacts}" titleUppercase="false">
				<uxap:subSections><uxap:ObjectPageSubSection>
					<mvc:XMLView id="secContacts" viewName="estrichone.view.bauakte.sections.Contacts" async="true"/>
				</uxap:ObjectPageSubSection></uxap:subSections>
			</uxap:ObjectPageSection>
			<uxap:ObjectPageSection id="dokumente" title="{i18n>akte.sec.documents}" titleUppercase="false">
				<uxap:subSections><uxap:ObjectPageSubSection>
					<mvc:XMLView id="secDocuments" viewName="estrichone.view.bauakte.sections.Documents" async="true"/>
				</uxap:ObjectPageSubSection></uxap:subSections>
			</uxap:ObjectPageSection>
			<uxap:ObjectPageSection id="fotos" title="{i18n>akte.sec.photos}" titleUppercase="false">
				<uxap:subSections><uxap:ObjectPageSubSection>
					<mvc:XMLView id="secPhotos" viewName="estrichone.view.bauakte.sections.Photos" async="true"/>
				</uxap:ObjectPageSubSection></uxap:subSections>
			</uxap:ObjectPageSection>
			<uxap:ObjectPageSection id="dokumentation" title="{i18n>akte.sec.documentation}" titleUppercase="false">
				<uxap:subSections><uxap:ObjectPageSubSection>
					<mvc:XMLView id="secDocumentation" viewName="estrichone.view.bauakte.sections.Documentation" async="true"/>
				</uxap:ObjectPageSubSection></uxap:subSections>
			</uxap:ObjectPageSection>
			<uxap:ObjectPageSection id="raeume" title="{i18n>akte.sec.rooms}" titleUppercase="false">
				<uxap:subSections><uxap:ObjectPageSubSection>
					<mvc:XMLView id="secRooms" viewName="estrichone.view.bauakte.sections.Rooms" async="true"/>
				</uxap:ObjectPageSubSection></uxap:subSections>
			</uxap:ObjectPageSection>
			<uxap:ObjectPageSection id="aufgaben" title="{i18n>akte.sec.work}" titleUppercase="false" visible="{= ${session>/permissions/work.read} === true }">
				<uxap:subSections><uxap:ObjectPageSubSection>
					<mvc:XMLView id="secWork" viewName="estrichone.view.bauakte.sections.Work" async="true"/>
				</uxap:ObjectPageSubSection></uxap:subSections>
			</uxap:ObjectPageSection>
			<uxap:ObjectPageSection id="material" title="{i18n>akte.sec.material}" titleUppercase="false" visible="{= ${session>/permissions/materials.read} === true }">
				<uxap:subSections><uxap:ObjectPageSubSection>
					<mvc:XMLView id="secMaterial" viewName="estrichone.view.bauakte.sections.Material" async="true"/>
				</uxap:ObjectPageSubSection></uxap:subSections>
			</uxap:ObjectPageSection>
			<uxap:ObjectPageSection id="einsaetze" title="{i18n>akte.sec.assignments}" titleUppercase="false" visible="{= ${session>/permissions/planning.read} === true }">
				<uxap:subSections><uxap:ObjectPageSubSection>
					<mvc:XMLView id="secAssignments" viewName="estrichone.view.bauakte.sections.Assignments" async="true"/>
				</uxap:ObjectPageSubSection></uxap:subSections>
			</uxap:ObjectPageSection>
			<uxap:ObjectPageSection id="notizen" title="{i18n>akte.sec.notes}" titleUppercase="false">
				<uxap:subSections><uxap:ObjectPageSubSection>
					<mvc:XMLView id="secNotes" viewName="estrichone.view.bauakte.sections.Notes" async="true"/>
				</uxap:ObjectPageSubSection></uxap:subSections>
			</uxap:ObjectPageSection>
		</uxap:sections>
	</uxap:ObjectPageLayout>
	<core:InvisibleText id="statusLabel" text="Status: {path: 'akte>/bauakte/status', formatter: 'fmt.bauakteStatusText'}"/>
</mvc:View>
