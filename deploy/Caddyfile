# EstrichONE – Weboberfläche und Reverse Proxy (ADR 0007)
#
# Zwei Betriebsarten (ESTRICHONE_MODE):
#   direkt – Caddy ist von außen erreichbar und kümmert sich selbst um HTTPS:
#            öffentliche Domain → Zertifikat von Let's Encrypt; „localhost“ oder IP → eigenes Zertifikat
#            (Browser warnt einmal). HTTP leitet auf HTTPS weiter. Standard-Ports 80/443.
#   proxy  – hinter einem vorhandenen Reverse Proxy (z. B. Nginx Proxy Manager): nur HTTP auf
#            ESTRICHONE_HTTP_PORT, ohne Weiterleitung und ohne Zertifikat; HTTPS macht der Proxy.
#            X-Forwarded-For/-Proto werden nur von Adressen aus ESTRICHONE_TRUSTED_PROXIES übernommen.

#
# Härtung für den öffentlichen Betrieb (docs/sicherheit.md, Abschnitt Betrieb):
#   - Zeitgrenzen gegen Slowloris (Kopfzeilen 15 s, Leerlauf 5 min); Kopfzeilen höchstens 64 KB.
#   - Client-Adresse nur aus X-Forwarded-For vertrauenswürdiger Proxys, von rechts gelesen (trusted_proxies_strict).
#   - Rate-Limits je Client-Adresse (Plugin caddy-ratelimit, docker/web.Dockerfile), einstellbar über die .env:
#       ESTRICHONE_RATE_LOGIN (Anmeldung, Ersteinrichtung, Koppeln; Standard 30/min),
#       ESTRICHONE_RATE_SESSION (Sitzung erneuern; 300/min), ESTRICHONE_RATE_API (übrige API; 3000/min).
#     Die API begrenzt Anmeldungen zusätzlich selbst (je Konto und je Adresse).
#   - Kein Server-Header, Anmelde-Anfragen höchstens 1 MB, sonst 600 MB (Videos; Hochladen in 4-MB-Teilen).
{
	http_port {$ESTRICHONE_HTTP_PORT:80}
	https_port {$ESTRICHONE_HTTPS_PORT:443}
	order rate_limit before basic_auth
	# Eigene CA (localhost/IP) nicht in den Vertrauensspeicher des Containers eintragen (schreibgeschützt, unnötig).
	skip_install_trust
	servers {
		trusted_proxies static {$ESTRICHONE_TRUSTED_PROXIES:127.0.0.1/32}
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
		timeouts {
			read_header 15s
			read_body 30m
			idle 5m
		}
		max_header_size 64KB
	}
}

(app) {
	# Echtzeit des Chats (Server-Sent Events) nie komprimieren – sonst puffert die Kompression den Strom.
	@compress not path /api/v1/chat/events
	encode @compress zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
		-Via
	}

	@anmeldung path /api/v1/auth/login /api/v1/auth/web/login /api/v1/auth/change-password /api/v1/setup /api/v1/setup/* /api/v1/archive/pair /api/v1/backup/mirror/pair
	request_body @anmeldung {
		max_size 1MB
	}
	@sonst not path /api/v1/auth/login /api/v1/auth/web/login /api/v1/auth/change-password /api/v1/setup /api/v1/setup/* /api/v1/archive/pair /api/v1/backup/mirror/pair
	request_body @sonst {
		max_size 600MB
	}

	# Rate-Limits je Client-Adresse (429 mit Retry-After). Ziehende Backup-Ziele (/api/v1/backup/mirror/…) laden viele
	# Dateien und sind über ihren Spiegel-Token geschützt – sie zählen nicht zur allgemeinen Grenze.
	rate_limit {
		zone anmeldung {
			match {
				method POST
				path /api/v1/auth/login /api/v1/auth/web/login /api/v1/auth/change-password /api/v1/setup /api/v1/setup/* /api/v1/archive/pair /api/v1/backup/mirror/pair
			}
			key {client_ip}
			events {$ESTRICHONE_RATE_LOGIN:30}
			window 1m
		}
		zone sitzung {
			match {
				path /api/v1/auth/refresh /api/v1/auth/web/refresh
			}
			key {client_ip}
			events {$ESTRICHONE_RATE_SESSION:300}
			window 1m
		}
		zone api {
			match {
				path /api/*
				not path /api/v1/backup/mirror/*
			}
			key {client_ip}
			events {$ESTRICHONE_RATE_API:3000}
			window 1m
		}
	}

	# Chat-Echtzeit: sofort weiterreichen (flush), lange offen lassen; Nginx Proxy Manager davor beachtet X-Accel-Buffering.
	handle /api/v1/chat/events {
		reverse_proxy api:8080 {
			flush_interval -1
		}
	}

	handle /api/* {
		reverse_proxy api:8080
	}

	# Server nicht erreichbar (Neustart, Absturz, Update): API-Aufrufe bekommen Problem-JSON, Seiten die Störungsseite
	# (deploy/fallback, docs/backup.md). Antworten der API selbst – auch 503 MAINTENANCE – reicht Caddy unverändert durch.
	# Rate-Limit überschritten: Problem-JSON wie die API (Retry-After setzt das Plugin).
	handle_errors 429 {
		header -Server
		header Content-Type "application/problem+json; charset=utf-8"
		header Cache-Control no-store
		respond `{"type":"about:blank","title":"Zu viele Anfragen","status":429,"detail":"Zu viele Anfragen von dieser Adresse. Bitte kurz warten und erneut versuchen.","code":"RATE_LIMITED"}` 429
	}

	handle_errors 502 503 504 {
		header -Server
		@api path /api/* /health/*
		handle @api {
			header Content-Type "application/problem+json; charset=utf-8"
			header Retry-After 30
			header Cache-Control no-store
			respond `{"type":"about:blank","title":"Server nicht erreichbar","status":{err.status_code},"detail":"EstrichONE ist gerade nicht erreichbar. Bitte in Kürze erneut versuchen.","code":"SERVER_UNAVAILABLE"}` {err.status_code}
		}
		handle {
			root * /srv
			header Cache-Control no-store
			rewrite * /stoerung.html
			file_server
		}
	}

	handle /health/* {
		reverse_proxy api:8080
	}

	# Weboberfläche (React): unbekannte Pfade liefern index.html, die App übernimmt das Routing.
	handle {
		root * /srv
		header {
			# Strikte CSP (docs/reengineering/17): nur eigene Skripte; Inline-Styles erzeugt Ant Design selbst.
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
			Permissions-Policy "camera=(self), microphone=(self), geolocation=(self)"
			X-Frame-Options "DENY"
		}
		@immutable path *.js *.css *.woff2
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@page not path *.js *.css *.woff2
		header @page Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

(direkt) {
	# HTTP → HTTPS mit dem richtigen Port (Caddys automatische Weiterleitung nennt keinen abweichenden Port).
	# ACME-Prüfungen für Let's Encrypt beantwortet Caddy weiterhin selbst.
	http://{$ESTRICHONE_DOMAIN}:{$ESTRICHONE_HTTP_PORT:80} {
		redir https://{host}:{$ESTRICHONE_HTTPS_PORT:443}{uri} 308
	}

	{$ESTRICHONE_DOMAIN}:{$ESTRICHONE_HTTPS_PORT:443} {
		# Nur TLS 1.2/1.3 (Caddy wählt sichere Cipher-Suites und OCSP-Stapling selbst).
		tls {
			protocols tls1.2 tls1.3
		}
		import app
	}
}

(proxy) {
	http://:{$ESTRICHONE_HTTP_PORT:80} {
		import app
	}
}

import {$ESTRICHONE_MODE:direkt}
