# EstrichONE – Weboberfläche und Reverse Proxy (ADR 0007)
# Öffentliche Domain: Zertifikat automatisch von Let's Encrypt.
# „localhost“ oder IP-Adresse: Zertifikat aus Caddys interner Zertifizierungsstelle (Browser warnt einmal).
# Ports: Standard 80/443; der Docker-Installer nutzt 8181/8143. Weiterleitungen zeigen dann auf den richtigen Port.
# Für ein Let's-Encrypt-Zertifikat auf 8181/8143 am Router 80 → 8181 und 443 → 8143 weiterleiten.

{
	http_port {$ESTRICHONE_HTTP_PORT:80}
	https_port {$ESTRICHONE_HTTPS_PORT:443}
}

# HTTP → HTTPS mit dem richtigen Port (Caddys automatische Weiterleitung nennt keinen abweichenden Port).
# ACME-Prüfungen für Let's Encrypt beantwortet Caddy weiterhin selbst.
http://{$ESTRICHONE_DOMAIN}:{$ESTRICHONE_HTTP_PORT:80} {
	redir https://{host}:{$ESTRICHONE_HTTPS_PORT:443}{uri} 308
}

{$ESTRICHONE_DOMAIN}:{$ESTRICHONE_HTTPS_PORT:443} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}

	request_body {
		max_size 600MB
	}

	handle /api/* {
		reverse_proxy api:8080
	}

	handle /health/* {
		reverse_proxy api:8080
	}

	# Weboberfläche (React): unbekannte Pfade liefern index.html, die App übernimmt das Routing.
	handle {
		root * /srv
		header {
			# Strikte CSP (docs/reengineering/17): nur eigene Skripte; Inline-Styles erzeugt Ant Design selbst.
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tile.openstreetmap.org; connect-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
			X-Frame-Options "DENY"
		}
		@immutable path *.js *.css *.woff2
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@page not path *.js *.css *.woff2
		header @page Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
