# EstrichONE – Konfiguration. Wird von ./setup.sh als .env erzeugt; .env niemals einchecken.

# Öffentliche Adresse ohne https://, z. B. estrichone.meinefirma.de (für Tests: localhost)
ESTRICHONE_DOMAIN=localhost
# Anzeigename in den Apps, z. B. der Firmenname
ESTRICHONE_SERVER_NAME=EstrichONE
# Ablage für Datenbank, Dateien und Zertifikate (Host-Pfad – gehört ins Backup)
ESTRICHONE_DATA_DIR=./data
ESTRICHONE_HTTP_PORT=80
ESTRICHONE_HTTPS_PORT=443

POSTGRES_DB=estrichone
POSTGRES_USER=estrichone
# Wird von setup.sh zufällig erzeugt
POSTGRES_PASSWORD=
