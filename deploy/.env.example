# EstrichONE – Konfiguration. Wird von ./setup.sh als .env erzeugt; .env niemals einchecken.

# Öffentliche Adresse ohne https://, z. B. estrichone.meinefirma.de (für Tests: localhost)
ESTRICHONE_DOMAIN=localhost
# Anzeigename in den Apps, z. B. der Firmenname
ESTRICHONE_SERVER_NAME=EstrichONE
# Ablage für Datenbank, Dateien und Zertifikate (Host-Pfad – gehört ins Backup)
ESTRICHONE_DATA_DIR=./data
ESTRICHONE_HTTP_PORT=80
ESTRICHONE_HTTPS_PORT=443

POSTGRES_DB=estrichone
POSTGRES_USER=estrichone
# Wird von setup.sh zufällig erzeugt
POSTGRES_PASSWORD=

# --- Backup (docs/reengineering/16) ---
# Passwort des Backup-Repositorys. Wird von setup.sh erzeugt. OHNE DIESES PASSWORT SIND DIE SICHERUNGEN WERTLOS:
# außerhalb des Servers aufbewahren (Ausdruck im Tresor, Passwortmanager).
RESTIC_PASSWORD=
# Hauptziel: lokaler Pfad auf dem Host (zweite Festplatte, eingebundenes NAS) …
ESTRICHONE_BACKUP_DIR=./backup-repository
# … oder ein restic-Ziel, z. B. sftp:backup@nas.firma.local:/estrichone (SSH-Schlüssel in ESTRICHONE_SSH_DIR)
BACKUP_REPOSITORY=/repository
# Optionales zweites Ziel an einem anderen Ort (dringend empfohlen: Brand, Diebstahl, Verschlüsselungstrojaner)
BACKUP_REPOSITORY_2=
ESTRICHONE_SSH_DIR=./ssh
# Uhrzeit der täglichen Sicherung (Europe/Berlin)
BACKUP_TIME=22:30
