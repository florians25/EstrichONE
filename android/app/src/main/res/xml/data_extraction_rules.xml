<?xml version="1.0" encoding="utf-8"?>
<!-- Anmeldung und Geräteschlüssel gehören zu diesem Gerät: keine Cloud-Sicherung, keine Übertragung. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
