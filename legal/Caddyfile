{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	# Datensparsam: keine Zugriffsprotokolle (keine IP-Adressen), siehe Datenschutzerklärung.
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
	}
	try_files {path} {path}.html
	file_server
	handle_errors {
		respond "Seite nicht gefunden" 404
	}
}
